<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cash_flow.CashFlowDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-12">
                    <!-- Header with Date Filtering -->
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between flex-wrap">
                                    <div class="d-flex align-items-center mb-2 mb-md-0">
                                        <h1 class="text-primary fw-bold mb-0 me-3">Cash Flow Dashboard</h1>
                                        <div t-if="state.lastUpdated" class="text-muted small">
                                            Last updated: <span t-esc="state.lastUpdated"/>
                                        </div>
                                    </div>
                                    
                                    <!-- Date Filter Controls -->
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="text-muted small">Period:</span>
                                        <select class="form-select form-select-sm" 
                                                style="width: auto; min-width: 150px;"
                                                t-model="state.dateFilter" 
                                                t-on-change="onDateFilterChange">
                                            <option value="all">All Time</option>
                                            <option value="7d">Last 7 Days</option>
                                            <option value="30d">Last 30 Days</option>
                                            <option value="90d">Last 90 Days</option>
                                            <option value="custom">Custom Range</option>
                                        </select>
                                        
                                        <!-- Refresh Button -->
                                        <button class="btn btn-outline-primary btn-sm" 
                                                t-on-click="refreshData" 
                                                t-att-disabled="state.loading">
                                            <i class="fa fa-refresh" t-att-class="state.loading ? 'fa-spin' : ''"></i>
                                            <span class="d-none d-md-inline ms-1">Refresh</span>
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Custom Date Range Inputs -->
                                <div t-if="state.showCustomDateInputs" class="row mt-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">From Date</label>
                                        <input type="date" 
                                               class="form-control form-control-sm" 
                                               t-model="state.customDateFrom"
                                               t-on-change="onCustomDateChange"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">To Date</label>
                                        <input type="date" 
                                               class="form-control form-control-sm" 
                                               t-model="state.customDateTo"
                                               t-on-change="onCustomDateChange"/>
                                    </div>
                                    <div class="col-md-6 d-flex align-items-end">
                                        <small class="text-muted">
                                            Select both dates to apply custom filter
                                        </small>
                                    </div>
                                </div>
                                
                                <!-- Filter Status -->
                                <div t-if="state.dateFilter !== 'all'" class="mt-2">
                                    <span class="badge bg-info">
                                        <i class="fa fa-filter me-1"></i>
                                        Filtered by: <span t-esc="getFilterDisplayName()"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div t-if="state.loading" class="text-center p-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="mt-3">
                            <h5>Loading dashboard data...</h5>
                            <p class="text-muted">Please wait while we fetch your cash flow information.</p>
                        </div>
                    </div>

                    <!-- Error State -->
                    <div t-if="state.error" class="row">
                        <div class="col-12">
                            <div class="alert alert-danger m-2" role="alert">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h5 class="alert-heading">
                                            <i class="fa fa-exclamation-triangle me-2"></i>
                                            Error Loading Data
                                        </h5>
                                        <p class="mb-0" t-esc="state.error.message"/>
                                    </div>
                                    <div>
                                        <button t-if="state.error.showRetry" 
                                                class="btn btn-outline-danger btn-sm me-2" 
                                                t-on-click="refreshData">
                                            <i class="fa fa-refresh me-1"></i>Retry
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" 
                                                t-on-click="clearError">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dashboard Content -->
                    <div t-if="!state.loading and !state.error" class="dashboard-content">
                        <!-- Group accounts into rows of 2 -->
                        <t t-set="rows" t-value="Array.from({ length: Math.ceil(state.accounts.length / 2) }, (_, i) => state.accounts.slice(i * 2, i * 2 + 2))"/>
                        <div t-foreach="rows" t-as="row" t-key="row_index" class="row">
                            <div t-foreach="row" t-as="account" t-key="account.id" class="col-md-6 col-12 mb-3">
                                <div class="card h-100 shadow-sm cursor-pointer"
                                     t-on-click="() => viewAccountDetails(account.id)"
                                     t-attf-class="border-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">

                                    <div class="card-header text-center">
                                        <h5 class="card-title mb-1">
                                            <strong t-esc="account.display_name"/>
                                        </h5>
                                        <small class="text-muted">
                                            Account ID: <span t-esc="account.id"/>
                                        </small>
                                    </div>

                                    <div class="card-body">
                                        <!-- Balance Display Section -->
                                        <div class="text-center mb-3">
                                            <h3 class="mb-0"
                                                t-attf-class="text-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">
                                                <t t-esc="account.balance_display"/>
                                            </h3>
                                            <small class="text-muted">Current Balance</small>
                                        </div>

                                        <!-- Chart Section -->
                                        <div class="chart-container">
                                            <BalanceChart 
                                                accountData="account"
                                                historicalData="account.historical_data"
                                                periods="7"/>
                                        </div>
                                    </div>
                                    
                                    <!-- Card Footer with Additional Info -->
                                    <div class="card-footer text-muted small text-center">
                                        <i class="fa fa-mouse-pointer me-1"></i>
                                        Click for detailed view
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Empty State -->
                        <div t-if="state.accounts.length === 0" class="text-center p-5">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle fa-2x mb-3"></i>
                                <h4>No Cash Flow Data Found</h4>
                                <p class="mb-3">
                                    <span t-if="state.dateFilter !== 'all'">
                                        No transactions found for the selected date range.<br/>
                                        Try expanding your date filter or check if transactions exist for this period.
                                    </span>
                                    <span t-else="">
                                        No cash flow accounts have been configured yet.<br/>
                                        Please configure your cash flow accounts in the settings to see data here.
                                    </span>
                                </p>
                                <div class="d-flex justify-content-center gap-2">
                                    <button t-if="state.dateFilter !== 'all'" 
                                            class="btn btn-outline-primary"
                                            t-on-click="() => { this.state.dateFilter = 'all'; this.onDateFilterChange(); }">
                                        <i class="fa fa-calendar me-1"></i>
                                        Show All Time
                                    </button>
                                    <button class="btn btn-primary" 
                                            t-on-click="refreshData">
                                        <i class="fa fa-refresh me-1"></i>
                                        Refresh Data
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    
</templates>