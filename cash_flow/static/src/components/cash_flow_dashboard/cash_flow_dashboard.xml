<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Basic Cash Flow Dashboard Template -->
    <t t-name="cash_flow.CashFlowDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-12">
                    
                    <!-- Header -->
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <h1 class="text-primary fw-bold mb-0 me-3">Cash Flow Dashboard</h1>
                                        <span t-if="state.lastUpdated" class="badge bg-success">
                                            <i class="fa fa-clock-o"/> Updated: <t t-esc="state.lastUpdated"/>
                                        </span>
                                        <span t-if="state.dataLoaded" class="badge bg-info ms-2">
                                            <i class="fa fa-database"/> Data Loaded
                                        </span>
                                    </div>
                                    
                                    <div>
                                        <!-- Refresh Button -->
                                        <button class="btn btn-outline-primary" 
                                                t-on-click="refreshData"
                                                t-att-disabled="state.loading">
                                            <i t-attf-class="fa fa-#{state.loading ? 'spinner fa-spin' : 'refresh'}"/>
                                            <span class="ms-1">Refresh Data</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Error Display -->
                    <div t-if="state.error" class="row">
                        <div class="col-12">
                            <div class="alert alert-danger alert-dismissible m-2">
                                <button type="button" class="btn-close" t-on-click="clearError"></button>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fa fa-exclamation-triangle"/> 
                                        <span t-esc="state.error.message"/>
                                    </div>
                                    <div t-if="state.error.showRetry">
                                        <button class="btn btn-sm btn-danger" t-on-click="refreshData">
                                            <i class="fa fa-refresh"/> Retry
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div t-if="state.loading" class="row">
                        <div class="col-12">
                            <div class="text-center p-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <div class="mt-3">
                                    <h5>Loading Dashboard Data...</h5>
                                    <p class="text-muted">Fetching accounts and transactions from backend</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Dashboard Content -->
                    <div t-if="!state.loading">
                        <!-- Data Info Bar -->
                        <div t-if="state.dataLoaded" class="row">
                            <div class="col-12">
                                <div class="alert alert-light m-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="fa fa-info-circle text-primary"/> 
                                            Dashboard loaded with <strong t-esc="state.accounts.length"/> account groups
                                        </div>
                                        <small class="text-muted">
                                            Last updated: <t t-esc="state.lastUpdated"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Account Cards -->
                        <t t-set="rows" t-value="Array.from({ length: Math.ceil(state.accounts.length / 2) }, (_, i) => state.accounts.slice(i * 2, i * 2 + 2))"/>
                        <div t-foreach="rows" t-as="row" t-key="row_index" class="row">
                            <div t-foreach="row" t-as="account" t-key="account.id" class="col-md-6 col-12 mb-3">
                                <div t-attf-class="card h-100 shadow-sm cursor-pointer border-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}"
                                     t-on-click="() => viewAccountDetails(account.id)">

                                    <div class="card-header text-center">
                                        <h5 class="card-title mb-0">
                                            <strong t-esc="account.display_name"/>
                                        </h5>
                                        <small class="text-muted">Account Group</small>
                                    </div>

                                    <div class="card-body text-center">
                                        <h3 t-attf-class="mb-0 text-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">
                                            <t t-esc="account.balance_display"/>
                                        </h3>
                                        <small class="text-muted">Current Balance</small>

                                        <div class="mt-3">
                                            <BalanceChart 
                                                currentBalance="account.current_balance"
                                                balanceColor="account.balance_color"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Empty State -->
                    <div t-if="!state.loading and state.accounts.length === 0 and !state.error" class="text-center p-5">
                        <div class="alert alert-info">
                            <h4>
                                <i class="fa fa-info-circle"/> No Cash Flow Accounts Configured
                            </h4>
                            <p>
                                Please configure your cash flow accounts in the settings to see data here.
                            </p>
                            <div class="mt-3">
                                <button class="btn btn-primary" t-on-click="refreshData">
                                    <i class="fa fa-refresh"/> Load Data
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>