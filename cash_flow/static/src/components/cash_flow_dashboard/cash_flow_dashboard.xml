<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cash_flow.CashFlowDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-12">
                    <!-- Header -->
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">Cash Flow Dashboard</h1>
                                    <div>
                                        <select class="form-select" t-model="state.period" t-on-change="onChangePeriod">
                                            <option value="7">Last 7 Days</option>
                                            <option value="30">Last 30 Days</option>
                                            <option value="90">Last 90 Days</option>
                                            <option value="365">Last Year</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div t-if="state.loading" class="text-center p-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading cash flow data...</p>
                    </div>

                    <!-- Account Cards -->
                    <div t-if="!state.loading" class="row">
                        <div t-foreach="state.accounts" t-as="account" t-key="account.id" class="col-lg-3 col-md-4 col-sm-6 col-12 mb-3">
                            <div class="card h-100 shadow-sm cursor-pointer" 
                                 t-on-click="() => viewAccountDetails(account.id)"
                                 t-attf-class="border-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">
                                
                                <div class="card-header text-center">
                                    <h5 class="card-title mb-0">
                                        <strong t-esc="account.account_code"/>
                                    </h5>
                                    <small class="text-muted" t-esc="account.display_name"/>
                                </div>
                                
                                <div class="card-body text-center">
                                    <h3 class="mb-0" 
                                        t-attf-class="text-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">
                                        <t t-esc="account.balance_display"/>
                                    </h3>
                                    <small class="text-muted">Current Balance</small>
                                    
                                    <!-- Placeholder for future chart -->
                                    <div class="mt-3 p-3 bg-light rounded">
                                        <small class="text-muted">Chart coming soon...</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Empty State -->
                    <div t-if="!state.loading and state.accounts.length === 0" class="text-center p-5">
                        <div class="alert alert-info">
                            <h4>No Cash Flow Accounts Configured</h4>
                            <p>Please configure your cash flow accounts in the settings to see data here.</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>
</templates>