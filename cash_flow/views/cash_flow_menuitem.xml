<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action for Cash Flow Dashboard -->
        <record id="action_cash_flow_dashboard" model="ir.actions.act_window">
            <field name="name">Cash Flow Dashboard</field>
            <field name="res_model">cash.flow.dashboard</field>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_cash_flow_dashboard_kanban"/>
            <field name="target">current</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Cash Flow Dashboard
                </p>
                <p>
                    Monitor your key cash flow accounts: 120002, 120003, 320002, 320003, 153000
                </p>
            </field>
        </record>

        <!-- Add Cash Flow Dashboard menu to existing Board menu -->
        <record id="menu_cash_flow_board" model="ir.ui.menu">
            <field name="name">Cash Flow</field>
            <field name="parent_id" ref="board.menu_board_root"/>
            <field name="action" ref="cash_flow.action_cash_flow_dashboard"/>
            <field name="sequence">10</field>
        </record>

    </data>
</odoo>