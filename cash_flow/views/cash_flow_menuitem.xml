<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action for Cash Flow Dashboard -->
        <record id="action_cash_flow_dashboard" model="ir.actions.act_window">
            <field name="name">Cash Flow Dashboard</field>
            <field name="res_model">cash.flow.dashboard</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Cash Flow Dashboard
                </p>
                <p>
                    Monitor your key cash flow accounts in real-time.<br/>
                    The dashboard shows balances for critical accounts filtered by your current company.
                </p>
            </field>
        </record>

        <!-- Menu item for Cash Flow Dashboard -->
        <menuitem 
            id="menu_cash_flow_dashboard"
            name="Cash Flow Dashboard"
            parent="base.menu_reporting_dashboard"
            action="action_cash_flow_dashboard"
            sequence="10"/>

        <!-- Menu item for Cash Flow Configuration -->
        <menuitem 
            id="menu_cash_flow_config"
            name="Dashboard Configuration"
            parent="account.menu_finance_configuration"
            action="action_cash_flow_config"
            sequence="15"
            groups="account.group_account_manager"/>

        <!-- Alternative: Add configuration to Settings menu -->
        <menuitem 
            id="menu_cash_flow_config_settings"
            name="Cash Flow Dashboard"
            parent="base.menu_administration"
            action="action_cash_flow_config"
            sequence="50"
            groups="base.group_system"/>

        <!-- Server Action for refreshing dashboard data -->
        <record id="action_refresh_cash_flow_dashboard" model="ir.actions.server">
            <field name="name">Refresh Dashboard Data</field>
            <field name="model_id" ref="model_cash_flow_dashboard"/>
            <field name="binding_model_id" ref="model_cash_flow_dashboard"/>
            <field name="state">code</field>
            <field name="code">
# Refresh dashboard records from current configuration
action = env['cash.flow.dashboard'].refresh_dashboard_from_config()
            </field>
        </record>

    </data>
</odoo>