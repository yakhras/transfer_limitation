<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Kanban View for Cash Flow Dashboard -->
        <record id="view_cash_flow_dashboard_kanban" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.kanban</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard" create="false" edit="false" delete="false">
                    <field name="id"/>
                    <field name="company_id"/>
                    <field name="account_code"/>
                    <field name="account_name"/>
                    <field name="display_name"/>
                    <field name="current_balance"/>
                    <field name="balance_display"/>
                    <field name="balance_color"/>
                    <field name="currency_id"/>
                    <field name="chart_data"/>
                    
                    <!-- Include Chart.js library -->
                    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click" 
                                 t-att-class="record.balance_color.raw_value == 'green' ? 'border-success' : (record.balance_color.raw_value == 'red' ? 'border-danger' : 'border-info')"
                                 t-att-data-chart='record.chart_data.raw_value'
                                 t-att-data-record-id='record.id.raw_value'>
                                
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary">
                                            <strong t-esc="record.account_code.value"/>
                                        </div>
                                        <div class="text-muted">
                                            <t t-esc="record.display_name.value"/>
                                        </div>
                                        <!-- Show company name in multi-company setup -->
                                        <div class="text-muted small" t-if="record.company_id.value">
                                            <i class="fa fa-building-o"/> <t t-esc="record.company_id.value"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_card_content">
                                    <!-- Balance Display Section -->
                                    <div class="row">
                                        <div class="col-6 text-center">
                                            <h3 class="mb-0" 
                                                t-att-class="record.balance_color.raw_value == 'green' ? 'text-success' : (record.balance_color.raw_value == 'red' ? 'text-danger' : 'text-info')">
                                                <t t-esc="record.balance_display.value"/>
                                            </h3>
                                            <small class="text-muted">Current Balance</small>
                                        </div>
                                        <!-- Chart Section -->
                                        <div class="col-6">
                                            <canvas t-att-id="'chart_' + record.id.raw_value" 
                                                    class="cash_flow_chart" 
                                                    width="150" 
                                                    height="80">
                                            </canvas>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                    <div class="row">
                                        <div class="col-6 o_kanban_card_manage_section o_kanban_manage_button_section">
                                            <a class="btn btn-primary btn-sm" name="action_view_account_moves" type="object">
                                                View Transactions
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </t>
                    </templates>
                    
                    <!-- JavaScript for Chart Rendering -->
                    <script type="text/javascript">
                        $(document).ready(function() {
                            // Function to render charts for all kanban cards
                            function renderCashFlowCharts() {
                                $('.oe_kanban_card').each(function() {
                                    var card = $(this);
                                    var chartData = card.data('chart');
                                    var recordId = card.data('record-id');
                                    
                                    if (chartData && recordId) {
                                        try {
                                            var data = JSON.parse(chartData);
                                            var chartId = 'chart_' + recordId;
                                            var canvas = document.getElementById(chartId);
                                            
                                            if (canvas && data.labels && data.data) {
                                                // Destroy existing chart if exists
                                                var existingChart = Chart.getChart(canvas);
                                                if (existingChart) {
                                                    existingChart.destroy();
                                                }
                                                
                                                // Determine chart color based on balance color
                                                var borderColor, backgroundColor;
                                                switch(data.balance_color) {
                                                    case 'green':
                                                        borderColor = '#28a745';
                                                        backgroundColor = 'rgba(40, 167, 69, 0.1)';
                                                        break;
                                                    case 'red':
                                                        borderColor = '#dc3545';
                                                        backgroundColor = 'rgba(220, 53, 69, 0.1)';
                                                        break;
                                                    default:
                                                        borderColor = '#17a2b8';
                                                        backgroundColor = 'rgba(23, 162, 184, 0.1)';
                                                }
                                                
                                                // Create new chart
                                                new Chart(canvas, {
                                                    type: 'line',
                                                    data: {
                                                        labels: data.labels,
                                                        datasets: [{
                                                            data: data.data,
                                                            borderColor: borderColor,
                                                            backgroundColor: backgroundColor,
                                                            borderWidth: 2,
                                                            fill: true,
                                                            tension: 0.3,
                                                            pointRadius: 0,
                                                            pointHoverRadius: 4
                                                        }]
                                                    },
                                                    options: {
                                                        responsive: true,
                                                        maintainAspectRatio: false,
                                                        plugins: {
                                                            legend: {
                                                                display: false
                                                            },
                                                            tooltip: {
                                                                mode: 'index',
                                                                intersect: false,
                                                                callbacks: {
                                                                    title: function(context) {
                                                                        return 'Date: ' + context[0].label;
                                                                    },
                                                                    label: function(context) {
                                                                        return 'Balance: ' + context.parsed.y.toLocaleString();
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        scales: {
                                                            x: {
                                                                display: false
                                                            },
                                                            y: {
                                                                display: false,
                                                                beginAtZero: false
                                                            }
                                                        },
                                                        interaction: {
                                                            intersect: false,
                                                            mode: 'index'
                                                        }
                                                    }
                                                });
                                            }
                                        } catch (e) {
                                            console.error('Error rendering chart for record ' + recordId + ':', e);
                                        }
                                    }
                                });
                            }
                            
                            // Initial chart rendering
                            setTimeout(renderCashFlowCharts, 100);
                            
                            // Re-render charts when kanban is refreshed
                            $(document).on('DOMNodeInserted', '.o_kanban_view', function() {
                                setTimeout(renderCashFlowCharts, 100);
                            });
                        });
                    </script>
                    
                </kanban>
            </field>
        </record>

        <!-- Tree View for Cash Flow Dashboard -->
        <record id="view_cash_flow_dashboard_tree" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.tree</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <tree string="Cash Flow Accounts" create="false" edit="false" delete="false">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="account_code"/>
                    <field name="display_name"/>
                    <field name="current_balance"/>
                    <field name="balance_display"/>
                    <field name="currency_id"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Cash Flow Dashboard -->
        <record id="view_cash_flow_dashboard_form" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.form</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <form string="Cash Flow Account" create="false" edit="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="account_code" readonly="1"/>
                            </h1>
                            <h2>
                                <field name="display_name" readonly="1"/>
                            </h2>
                        </div>
                        
                        <group>
                            <group string="Account Information">
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                                <field name="account_id" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                            </group>
                            <group string="Balance Information">
                                <field name="current_balance" readonly="1"/>
                                <field name="balance_display" readonly="1"/>
                                <field name="balance_color" readonly="1"/>
                            </group>
                        </group>
                        

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Enhanced Search View for Cash Flow Dashboard with Date Filtering -->
        <record id="view_cash_flow_dashboard_search" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.search</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <search string="Cash Flow Dashboard">
                    <!-- Field Searches -->
                    <field name="account_code"/>
                    <field name="display_name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    
                    <!-- Date Range Fields (Custom Date Selection) -->
                    <field name="display_name" string="Date From" 
                           filter_domain="[]" 
                           context="{'date_from': self}"
                           widget="date"/>
                    <field name="display_name" string="Date To" 
                           filter_domain="[]" 
                           context="{'date_to': self}"
                           widget="date"/>
                    
                    <!-- Separator -->
                    <separator/>
                    
                    <!-- Preset Date Range Filters -->
                    <filter string="All Time" name="all_time" 
                            context="{'date_from': False, 'date_to': False}"
                            help="Show all historical data"/>
                    
                    <separator/>
                    
                    <filter string="Today" name="today"
                            domain="[]"
                            context="{'date_from': context_today().strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show today's transactions only"/>
                    
                    <filter string="This Week" name="this_week"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show current week transactions (Monday to today)"/>
                    
                    <filter string="This Month" name="this_month"
                            domain="[]"
                            context="{'date_from': context_today().strftime('%Y-%m-01'), 'date_to': (context_today().replace(day=1) + relativedelta(months=1, days=-1)).strftime('%Y-%m-%d')}"
                            help="Show current month transactions"/>
                    
                    <filter string="This Quarter" name="this_quarter"
                            domain="[]"
                            context="{'date_from': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+1)).strftime('%Y-%m-%d'), 'date_to': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+3) + relativedelta(months=1, days=-1)).strftime('%Y-%m-%d')}"
                            help="Show current quarter transactions"/>
                    
                    <filter string="This Year" name="this_year"
                            domain="[]"
                            context="{'date_from': context_today().strftime('%Y-01-01'), 'date_to': context_today().strftime('%Y-12-31')}"
                            help="Show current year transactions"/>
                    
                    <separator/>
                    
                    <filter string="Last 30 Days" name="last_30_days"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(days=-30)).strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show last 30 days transactions"/>
                    
                    <filter string="Last Month" name="last_month"
                            domain="[]"
                            context="{'date_from': (context_today().replace(day=1) + relativedelta(months=-1)).strftime('%Y-%m-%d'), 'date_to': (context_today().replace(day=1) + relativedelta(days=-1)).strftime('%Y-%m-%d')}"
                            help="Show previous month transactions"/>
                    
                    <filter string="Last Quarter" name="last_quarter"
                            domain="[]"
                            context="{'date_from': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+1) + relativedelta(months=-3)).strftime('%Y-%m-%d'), 'date_to': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+1) + relativedelta(days=-1)).strftime('%Y-%m-%d')}"
                            help="Show previous quarter transactions"/>
                    
                    <filter string="Last Year" name="last_year"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(years=-1)).strftime('%Y-01-01'), 'date_to': (context_today() + relativedelta(years=-1)).strftime('%Y-12-31')}"
                            help="Show previous year transactions"/>
                    
                    <!-- Group By Section -->
                    <group expand="0" string="Group By">
                        <filter string="Company" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                        <filter string="Account Code" name="account_code" context="{'group_by': 'account_code'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>