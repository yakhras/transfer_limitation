<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Record Rule for Cash Flow Dashboard - Company Access -->
        <record id="cash_flow_dashboard_company_rule" model="ir.rule">
            <field name="name">Cash Flow Dashboard: Company Access</field>
            <field name="model_id" ref="model_cash_flow_dashboard"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>