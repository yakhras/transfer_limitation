<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_vendor_bill_report_tree" model="ir.ui.view">
            <field name="name">vendor.bill.report.tree</field>
            <field name="model">vendor.bill.report</field>
            <field name="arch" type="xml">
                <tree string="Vendor Bill Report">
                    <field name="invoice_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="price_unit"/>
                    <field name="currency_id"/>
                    <field name="purchase_id"/>
                    <field name="warehouse_id"/>
                </tree>
            </field>
        </record>


        <record id="action_report_vendor_invoice_report" model="ir.actions.act_window">
            <field name="name">Billed Product Report</field>
            <field name="res_model">vendor.bill.report</field>
            <field name="view_mode">tree</field>
        </record>


        <menuitem id="menu_report_vendor_invoice_report"
                    name="Billed Products Report"
                    parent="base.menu_reporting_dashboard"
                    action="action_report_vendor_invoice_report"
                    sequence="4"/>


        
    </data>
</odoo>
