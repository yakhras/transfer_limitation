<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_report_vendor_invoice_report_tree" model="ir.ui.view">
            <field name="name">report.vendor.invoice.report.tree</field>
            <field name="model">report.vendor.invoice</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="invoice_date"/>
                    <field name="product_name"/>
                    <field name="invoice_number"/>
                    <field name="quantity"/>
                    <field name="price_unit"/>
                    <field name="currency_id"/>
                    <field name="currency_rate"/>
                    <field name="subtotal"/>
                    <field name="vendor_name"/>
                    <field name="purchase_order_ref"/>
                </tree>
            </field>
        </record>


        <record id="action_report_vendor_invoice_report" model="ir.actions.act_window">
            <field name="name">Billed Product Report</field>
            <field name="res_model">report.vendor.invoice</field>
            <field name="view_mode">tree</field>
        </record>


        <menuitem id="menu_report_vendor_invoice_report"
                    name="Billed Products Report"
                    parent="account.menu_finance_payables"
                    action="action_report_vendor_invoice_report"
                    sequence="4"/>


        
    </data>
</odoo>
