<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_attribute_cleanup_wizard_form" model="ir.ui.view">
            <field name="name">attribute.cleanup.wizard.form</field>
            <field name="model">attribute.cleanup.wizard</field>
            <field name="arch" type="xml">
                <form string="Product Attribute Cleanup">
                    <header>
                        <button name="action_preview_category" 
                                string="🔍 Preview Category" 
                                type="object" 
                                class="btn-primary"
                                attrs="{'invisible': [('state', 'in', ['executed'])]}"/>
                        
                        <button name="action_execute_cleanup" 
                                string="🧹 Execute Cleanup" 
                                type="object" 
                                class="btn-warning"
                                confirm="Are you sure you want to remove all attributes from these products? This action cannot be undone!"
                                attrs="{'invisible': [('state', 'not in', ['preview'])]}"/>
                        
                        <button name="action_download_report" 
                                string="📥 Download Report" 
                                type="object" 
                                class="btn-info"
                                attrs="{'invisible': [('state', 'not in', ['preview', 'executed'])]}"/>
                        
                        <field name="state" widget="statusbar" statusbar_visible="draft,preview,executed"/>
                    </header>
                    
                    <sheet>
                        <group>
                            <group>
                                <field name="category_id" 
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       placeholder="Select a product category"/>
                                <field name="batch_size" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"
                                       help="Number of products to process in each batch"/>
                            </group>
                            <group>
                                <field name="products_found" readonly="1"/>
                                <field name="products_with_attributes" readonly="1" 
                                       attrs="{'invisible': [('products_with_attributes', '=', 0)]}"/>
                                <field name="products_without_attributes" readonly="1"
                                       attrs="{'invisible': [('products_without_attributes', '=', 0)]}"/>
                                <field name="attributes_to_remove" readonly="1"
                                       attrs="{'invisible': [('attributes_to_remove', '=', 0)]}"/>
                                <field name="variants_to_remove" readonly="1"
                                       attrs="{'invisible': [('variants_to_remove', '=', 0)]}"/>
                            </group>
                        </group>
                        
                        <!-- Real-time Processing Progress -->
                        <div attrs="{'invisible': [('processing_progress', '=', False)]}">
                            <field name="processing_progress" widget="html" nolabel="1"/>
                        </div>
                        
                        <notebook>
                            <page string="📋 Preview Results" attrs="{'invisible': [('preview_results', '=', False)]}">
                                <field name="preview_results" widget="html" nolabel="1"/>
                            </page>
                            
                            <page string="✅ Execution Results" attrs="{'invisible': [('execution_results', '=', False)]}">
                                <field name="execution_results" widget="html" nolabel="1"/>
                            </page>
                            
                            <page string="ℹ️ Help">
                                <div class="alert alert-info">
                                    <h4>How to Use This Tool</h4>
                                    <ol>
                                        <li><strong>Select Category:</strong> Choose the product category you want to clean from the dropdown</li>
                                        <li><strong>Set Batch Size:</strong> Choose how many products to process at once (default: 10)</li>
                                        <li><strong>Preview:</strong> Click "Preview Category" to see what products will be affected</li>
                                        <li><strong>Review Results:</strong> Check both lists:
                                            <ul>
                                                <li><span style="color: #d68910;">Products WITH Attributes</span> - These will be processed</li>
                                                <li><span style="color: #27ae60;">Products WITHOUT Attributes</span> - These remain unchanged</li>
                                            </ul>
                                        </li>
                                        <li><strong>Execute:</strong> Click "Execute Cleanup" to start batch processing</li>
                                        <li><strong>Monitor Progress:</strong> Watch real-time progress with batch updates</li>
                                        <li><strong>Download:</strong> Get a detailed HTML report of the operation</li>
                                    </ol>
                                    
                                    <h5>⚠️ Warning</h5>
                                    <p>This operation will permanently remove ALL attributes from products in the selected category. Make sure to backup your database before proceeding.</p>
                                    
                                    <h5>🔄 Batch Processing</h5>
                                    <ul>
                                        <li><strong>Real-time Progress:</strong> See live updates as each batch is processed</li>
                                        <li><strong>Error Resilience:</strong> Processing continues even if individual products fail</li>
                                        <li><strong>Batch Size:</strong> Smaller batches (5-10) = more feedback, larger batches = faster completion</li>
                                        <li><strong>Progress Tracking:</strong> Visual progress bar and detailed statistics</li>
                                    </ul>
                                    
                                    <h5>📊 Preview Features</h5>
                                    <ul>
                                        <li><strong>Complete Transparency:</strong> See all products in the category</li>
                                        <li><strong>Two Lists:</strong> Products with attributes (actionable) and without (verification)</li>
                                        <li><strong>Detailed Stats:</strong> Attribute counts, variant counts, pricing info</li>
                                        <li><strong>Status Indicators:</strong> Active/inactive product status</li>
                                    </ul>
                                    
                                    <h5>🔧 Features</h5>
                                    <ul>
                                        <li>Safe preview before execution</li>
                                        <li>Category selection with dropdown</li>
                                        <li>Configurable batch processing</li>
                                        <li>Real-time progress feedback</li>
                                        <li>Error collection and reporting</li>
                                        <li>Downloadable audit reports</li>
                                        <li>Dual product lists for complete verification</li>
                                    </ul>
                                    
                                    <h5>💡 Tips</h5>
                                    <ul>
                                        <li>Use smaller batch sizes (5-10) for better progress visibility</li>
                                        <li>Use larger batch sizes (20-50) for faster processing of large categories</li>
                                        <li>The tool continues processing even if some products fail</li>
                                        <li>You can monitor progress in real-time during execution</li>
                                        <li>All errors are collected and reported at the end</li>
                                        <li>Download the report for audit trails and documentation</li>
                                    </ul>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_attribute_cleanup_wizard" model="ir.actions.act_window">
            <field name="name">Product Attribute Cleanup</field>
            <field name="res_model">attribute.cleanup.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_attribute_cleanup_wizard_form"/>
        </record>

        <!-- Menu Item in Inventory -->
        <menuitem id="menu_attribute_cleanup_inventory" 
                  name="Attribute Cleanup" 
                  parent="stock.menu_stock_root" 
                  action="action_attribute_cleanup_wizard" 
                  sequence="100"/>

    </data>
</odoo>