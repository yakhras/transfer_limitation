<?xml version="1.0" encoding="utf-8"?>

<odoo> 

    <record id="res_partner_report" model="ir.ui.view">
        <field name="name">res.partner.report</field>
        <field name="model">res.partner.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <button string="Currency Ledger" type="object" name="currency_partner_ledger_report" class="btn-primary"/>
                    <button string="Partner Ledger" type="object" name="partner_ledger_report" class="btn-primary"/> 
                </group>
                <footer>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="res_partner_action" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">res.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="res_partner_report"/> 
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
    </record>

</odoo> 