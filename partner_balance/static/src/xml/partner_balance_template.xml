<?xml version="1.0" encoding="utf-8"?>

<templates id="template" xml:space="preserve">

<t t-extend="ListView.buttons" t-name="PartnerBalance.Buttons">
    <t t-jquery="button.o_list_export_xlsx" t-operation="after">
        <!-- Export Buttons with Icons -->
        <div class="toolbar">
            <!-- Export Buttons -->
            <div class="btn-group export-btn-group" role="group">
                <button class="btn btn-icon btn-pdf o_button_pdf" type="button" title="Export to PDF">
                <i class="fa fa-file-pdf-o"></i>
                </button>
                <button class="btn btn-icon btn-xlsx o_button_excel" type="button" title="Export to Excel">
                <i class="fa fa-file-excel-o"></i>
                </button>
            </div>

            <!-- Date Filters -->
            <div class="date-range">
                <label>From:</label>
                <input type="date" class="date-input" placeholder="mm/dd/yyyy" data-field-name="date_from" autocomplete="off" />

                <label>To:</label>
                <input type="date" class="date-input" placeholder="mm/dd/yyyy" data-field-name="date_to" autocomplete="off" />
            </div>

            <t t-if="!widget.model.loadParams.context 
                    or widget.model.loadParams.context.action_name !== 'Statement Currency-based of Account'">
                <button class="btn btn-icon btn-currency o_currency_report" type="button" title="Currency Report">
                    <i class="fa fa-exchange"></i> Currency Report
                </button>
            </t>



            <!-- Balance Summary Section with Currency Tabs -->
            <div class="balance-summary-section">

                <div class="single-row-summary">
                    <span class="summary-cell">Opening Balance:</span>
                    <span class="summary-cell amount final-balance">$242,987.41</span>
                </div>

                <div class="currency-tabs-container">
                    <!-- Currency Tabs -->
                    <div class="currency-tabs">
                        <div class="currency-tab active" data-currency="USD"></div>
                        <div class="currency-tab" data-currency="TRY"></div>
                        <div class="currency-tab" data-currency="EUR"></div>
                    </div>
                    
                    <!-- Tab Content -->
                    <div class="currency-tab-content">
                        <!-- USD Content (default active) -->
                        <div class="currency-content active" data-currency="USD">
                            <div class="balance-summary-row">
                                <span class="summary-cell amount final-balance"></span>
                            </div>
                        </div>
                        
                        <!-- TRY Content -->
                        <div class="currency-content" data-currency="TRY">
                            <div class="balance-summary-row">
                                <span class="summary-cell amount final-balance"></span>
                            </div>
                        </div>
                        
                        <!-- EUR Content -->
                        <div class="currency-content" data-currency="EUR">
                            <div class="balance-summary-row">
                                <span class="summary-cell amount final-balance"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Horizontal Summary for All Currencies -->
                <div class="horizontal-currency-summary">
                    <div class="currency-block">
                        <span class="currency-label">USD</span>
                        <span class="final-balance">$12,450.00</span>
                    </div>
                    <div class="currency-block">
                        <span class="currency-label">TRY</span>
                        <span class="final-balance">₺115,000.00</span>
                    </div>
                </div>

                <!-- Add this as a separate template -->
                <t t-name="PartnerBalance.CurrencyBlocks">
                    <t t-foreach="widget.currencies" t-as="currency">
                        <div class="currency-block">
                            <span class="currency-label" t-esc="currency.name"/>
                            <span class="final-balance" 
                                t-esc="widget.formatCurrencyInTemplate(currency.name)"/>
                        </div>
                    </t>
                </t>


            </div>

        </div>
    </t>
</t>

</templates>