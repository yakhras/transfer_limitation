<?xml version="1.0" encoding="utf-8"?>

<templates id="template" xml:space="preserve">

<t t-extend="ListView.buttons" t-name="PartnerBalance.Buttons">
    <t t-jquery="button.o_list_export_xlsx" t-operation="after">
        <!-- <button class="btn btn-primary o_button_pdf mr-2" type="button">
            PDF
        </button>
        <button class="btn btn-primary o_button_xls mr-2" type="button">
            Excel
        </button> -->
        <!-- Export Buttons with Icons -->
        <div class="btn-group mr-2" role="group">
            <button class="btn btn-secondary o_button_pdf" type="button" title="Export to PDF">
                <i class="fa fa-file-pdf-o"></i> PDF
            </button>
            <button class="btn btn-secondary o_button_excel" type="button" title="Export to Excel">
                <i class="fa fa-file-excel-o"></i> Excel
            </button>
        </div>
        <div class="partner-balance-date-filters d-flex align-items-center">
            <label class="partner-balance-label">From:</label>
            <div class="partner-balance-datepicker">
                <input type="date" 
                    class="partner-balance-date-input" 
                    placeholder="mm/dd/yyyy"
                    data-field-name="date_from"
                    autocomplete="off" />
            </div>
            <label class="partner-balance-label">To:</label>
            <div class="partner-balance-datepicker">
                <input type="date" 
                    class="partner-balance-date-input" 
                    placeholder="mm/dd/yyyy"
                    data-field-name="date_to"
                    autocomplete="off" />
            </div>
        </div>
    </t>
</t>

</templates>
