<?xml version="1.0" encoding="utf-8"?>

<templates id="template" xml:space="preserve">

<t t-extend="ListView.buttons" t-name="PartnerBalance.Buttons">
    <t t-jquery="button.o_list_export_xlsx" t-operation="after">
        <!-- <button class="btn btn-primary o_button_pdf mr-2" type="button">
            PDF
        </button>
        <button class="btn btn-primary o_button_xls mr-2" type="button">
            Excel
        </button> -->
        <div class="partner-balance-date-filters d-flex align-items-center">
            <label class="partner-balance-label">From:</label>
            <div class="partner-balance-datepicker">
                <input type="text" 
                    class="partner-balance-date-input" 
                    placeholder="mm/dd/yyyy"
