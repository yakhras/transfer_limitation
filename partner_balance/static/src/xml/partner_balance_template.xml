<?xml version="1.0" encoding="utf-8"?>

<templates id="template" xml:space="preserve">

<t t-extend="ListView.buttons" t-name="PartnerBalance.Buttons">
    <t t-jquery="button.o_list_export_xlsx" t-operation="after">
        <!-- Export Buttons with Icons -->
        <div class="toolbar">
            <!-- Export Buttons -->
            <div class="btn-group export-btn-group" role="group">
                <button class="btn btn-icon btn-pdf o_button_pdf" type="button" title="Export to PDF">
                <i class="fa fa-file-pdf-o"></i>
                </button>
                <button class="btn btn-icon btn-xlsx o_button_excel" type="button" title="Export to Excel">
                <i class="fa fa-file-excel-o"></i>
                </button>
            </div>

            <!-- Date Filters -->
            <div class="date-range">
                <label>From:</label>
                <input type="date" class="date-input" placeholder="mm/dd/yyyy" data-field-name="date_from" autocomplete="off" />

                <label>To:</label>
                <input type="date" class="date-input" placeholder="mm/dd/yyyy" data-field-name="date_to" autocomplete="off" />
            </div>

            <tbody class="balance-summary-section">
                <tr class="balance-summary-row">
                    <td class="o_list_record_selector">
                        <div class="o_list_record_check">
                            <input type="checkbox" disabled="true"/>
                        </div>
                    </td>
                    <td class="summary-cell muted">SUMMARY</td>
                    <td class="summary-cell muted">--</td>
                    <td class="summary-cell muted">Period Summary</td>
                    <td class="summary-cell summary-note">Invoices: +$1.36M | Payments: -$3.62M</td>
                    <td class="summary-cell amount">$1,359,987.41</td>
                    <td class="summary-cell amount">$3,617,000.00</td>
                    <td class="summary-cell amount final-balance">$242,987.41</td>
                    <td class="summary-cell amount negative">-$2,257,012.59</td>
                    <td class="summary-cell center">USD</td>
                </tr>
            </tbody>

        </div>
    </t>
</t>

</templates>