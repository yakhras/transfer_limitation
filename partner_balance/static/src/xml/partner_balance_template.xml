<?xml version="1.0" encoding="utf-8"?>

<templates id="template" xml:space="preserve">

<t t-extend="ListView.buttons" t-name="PartnerBalance.Buttons">
    <t t-jquery="button.o_list_export_xlsx" t-operation="after">
        <!-- Export Buttons with Icons -->
        <div class="toolbar">
            <div class="btn-group btn-group-tight" role="group" aria-label="Exports">
                <button class="btn btn-icon btn-pdf o_button_pdf" type="button" title="Export to PDF">
                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                </button>
                <button class="btn btn-icon btn-xlsx o_button_excel" type="button" title="Export to Excel">
                <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                </button>
            </div>

            <div class="date-range">
                <label class="range-label">From:</label>
                <div class="input-group date-input">
                <input type="date" class="form-control" placeholder="mm/dd/yyyy" data-field-name="date_from" autocomplete="off" />
                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                </div>

                <label class="range-label">To:</label>
                <div class="input-group date-input">
                <input type="date" class="form-control" placeholder="mm/dd/yyyy" data-field-name="date_to" autocomplete="off" />
                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                </div>
            </div>
            </div>


    </t>
</t>

</templates>