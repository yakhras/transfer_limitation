<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>


        <record id="view_partner_form_inherit_custom_button" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.custom.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="l10n_tr_base_ubl.view_partner_form_esolutions"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_registered_user']" position="after">
                    <button name="action_view_move_line_report"
                    type="object"
                    string="View Report"
                    class="btn-primary"
                    attrs="{'invisible': [('is_company', '=', False)]}" />
                </xpath>
            </field>
        </record>


        <!-- Tree View for Account Move Line Normal Report -->
        <record id="view_account_move_line_report_tree" model="ir.ui.view">
            <field name="name">account.move.line.report.tree</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Partner Ledger" create="false" delete="false" edit="false" js_class="partner_balance">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="cumulated_balance"/>
                    <field name="initial_balance" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="amount_currency"/>
                    <field name="currency_id"/>

                </tree>
            </field>
        </record>


        <!-- Tree View for Account Move Line Currency-based Report -->
        <record id="view_account_move_line_report_currency_tree" model="ir.ui.view">
            <field name="name">account.move.line.report.currency.tree</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Currency-based Partner Ledger" create="false" delete="false" edit="false" js_class="partner_balance">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <field name="debit_amount"/>
                    <field name="credit_amount"/>
                    <field name="balance_amount"/>
                    <field name="currency_id"/>
                </tree>
            </field>
        </record>


        <!-- Tree View for Account Move Line USD Report -->
        <record id="view_account_move_line_report_usd_tree" model="ir.ui.view">
            <field name="name">account.move.line.report.usd.tree</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Partner Ledger" create="false" delete="false" edit="false">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="usd_rate_display"/>
                    <field name="usd_value"/>
                    <field name="cumulated_usd_value"/>
                </tree>
            </field>
        </record>

        <record id="view_account_move_line_report_partner_currency" model="ir.ui.view">
            <field name="name">account.move.line.report.partner.currency</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Partner Ledger" create="false" delete="false" edit="false" js_class="partner_balance">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="partner_currency_id"/>
                    <field name="partner_currency_value"/>
                    <field name="cumulated_partner_currency_value"/>
                    <field name="initial_balance_partner_currency" invisible="1"/>
                    <field name="partner_currency_id" invisible="1"/>
                </tree>
            </field>
        </record>


        <!-- Action for Currency-based Report -->
        <record id="action_partner_move_line_currency" model="ir.actions.act_window">
            <field name="name">Statement Currency-based of Account</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move.line.report</field>
            <field name="view_mode">tree</field>
            <!-- Bind the specific tree view; fallback if missing is allowed -->
            <field name="view_id" ref="partner_balance.view_account_move_line_report_currency_tree"/>
            <field name="views" eval="[(ref('partner_balance.view_account_move_line_report_currency_tree'), 'tree')]"/>
            <field name="target">current</field>

            <!-- Filter by the partner provided from JS via active_id -->
            <field name="domain">[('partner_id', '=', active_id)]</field>

            <!-- Server-side defaults; JS can add to context but shouldn’t need to replace -->
            <field name="context">
                {
                'group_by': 'currency_id',
                'search_default_group_by_account': 1
                }
            </field>
        </record>


        <!-- Action for Partner Currency Report -->
        <record id="action_partner_move_line_partner_currency" model="ir.actions.act_window">
            <field name="name">Statement in Partner Currency</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move.line.report</field>
            <field name="view_mode">tree</field>
            <!-- Bind the specific tree view; fallback if missing is allowed -->
            <field name="view_id" ref="partner_balance.view_account_move_line_report_partner_currency"/>
            <field name="views" eval="[(ref('partner_balance.view_account_move_line_report_partner_currency'), 'tree')]"/>
            <field name="target">current</field>

            <!-- Filter by the partner provided from JS via active_id -->
            <field name="domain">[('partner_id', '=', active_id)]</field>

            <!-- Server-side defaults; JS can add to context but shouldn’t need to replace -->
            <field name="context">
                {
                'search_default_group_by_account': 1
                }
            </field>
        </record>

