<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Convert to Quotation button to Sale Order form -->
        <record id="view_order_form_convert_to_quotation" model="ir.ui.view">
            <field name="name">sale.order.form.convert.to.quotation</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_convert_to_quotation" 
                            string="Quotation" 
                            type="object" 
                            class="btn-primary"
                            attrs="{'invisible': [('state', 'not in', ['sale', 'done'])]}"
                            confirm="Are you sure you want to convert this Sale Order to a Quotation? This will cancel and delete all related Purchase Orders."
                            data-hotkey="shift+c"/>
                </xpath>
                
                <!-- Add conversion history tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Conversion History" attrs="{'invisible': [('conversion_log_ids', '=', [])]}">
                        <field name="conversion_log_ids" readonly="1">
                            <tree decoration-success="success == True" decoration-danger="success == False">
                                <field name="conversion_date"/>
                                <field name="user_id"/>
                                <field name="success" widget="boolean_toggle"/>
                                <field name="notes"/>
                            </tree>
                            <form>
                                <header>
                                    <field name="success" widget="boolean_button" options="{'terminology': {'true': 'Success', 'false': 'Failed'}}"/>
                                </header>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="sale_order_id"/>
                                            <field name="conversion_date"/>
                                            <field name="user_id"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="SO Level Changes">
                                            <field name="so_level_changes" widget="text"/>
                                        </page>
                                        <page string="Line Level Changes">
                                            <field name="line_level_changes" widget="text"/>
                                        </page>
                                        <page string="Related Records">
                                            <field name="related_records_changes" widget="text"/>
                                        </page>
                                        <page string="Purchase Orders">
                                            <field name="purchase_orders_info" widget="text"/>
                                        </page>
                                        <page string="Notes">
                                            <field name="notes" widget="text"/>
                                        </page>
                                    </notebook>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

# views/conversion_log_views.xml
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Conversion Log Tree View -->
        <record id="view_conversion_log_tree" model="ir.ui.view">
            <field name="name">sale.order.conversion.log.tree</field>
            <field name="model">sale.order.conversion.log</field>
            <field name="arch" type="xml">
                <tree decoration-success="success == True" decoration-danger="success == False">
                    <field name="conversion_date"/>
                    <field name="sale_order_id"/>
                    <field name="user_id"/>
                    <field name="success" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Conversion Log Form View -->
        <record id="view_conversion_log_form" model="ir.ui.view">
            <field name="name">sale.order.conversion.log.form</field>
            <field name="model">sale.order.conversion.log</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="success" widget="boolean_button" options="{'terminology': {'true': 'SUCCESS', 'false': 'FAILED'}}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sale_order_id"/>
                                <field name="conversion_date"/>
                                <field name="user_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="SO Level Changes">
                                <field name="so_level_changes" widget="text"/>
                            </page>
                            <page string="Line Level Changes">
                                <field name="line_level_changes" widget="text"/>
                            </page>
                            <page string="Related Records">
                                <field name="related_records_changes" widget="text"/>
                            </page>
                            <page string="Purchase Orders">
                                <field name="purchase_orders_info" widget="text"/>
                            </page>
                            <page string="Notes">
                                <field name="notes" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Conversion Log Search View -->
        <record id="view_conversion_log_search" model="ir.ui.view">
            <field name="name">sale.order.conversion.log.search</field>
            <field name="model">sale.order.conversion.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="sale_order_id"/>
                    <field name="user_id"/>
                    <field name="conversion_date"/>
                    <separator/>
                    <filter string="Successful Conversions" name="successful" domain="[('success', '=', True)]"/>
                    <filter string="Failed Attempts" name="failed" domain="[('success', '=', False)]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('conversion_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                    <filter string="Last 7 Days" name="week" domain="[('conversion_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Last 30 Days" name="month" domain="[('conversion_date', '>=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Sales Rep" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                        <filter string="Success Status" name="group_success" domain="[]" context="{'group_by': 'success'}"/>
                        <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'conversion_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Conversion Log Action -->
        <record id="action_conversion_log" model="ir.actions.act_window">
            <field name="name">Conversion Logs</field>
            <field name="res_model">sale.order.conversion.log</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_conversion_log_search"/>
            <field name="context">{'search_default_month': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No conversion logs yet!
                </p>
                <p>
                    Conversion logs will appear here when sales orders are converted to quotations.
                    Both successful conversions and failed attempts are tracked for audit purposes.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_conversion_log"
                  name="Conversion Logs"
                  parent="sale.sale_menu_root"
                  action="action_conversion_log"
                  sequence="10"/>

        <!-- Dashboard for Sales Manager -->
        <record id="view_conversion_log_pivot" model="ir.ui.view">
            <field name="name">sale.order.conversion.log.pivot</field>
            <field name="model">sale.order.conversion.log</field>
            <field name="arch" type="xml">
                <pivot string="Conversion Analysis">
                    <field name="user_id" type="row"/>
                    <field name="success" type="col"/>
                    <field name="conversion_date" type="row"/>
                </pivot>
            </field>
        </record>

        <record id="view_conversion_log_graph" model="ir.ui.view">
            <field name="name">sale.order.conversion.log.graph</field>
            <field name="model">sale.order.conversion.log</field>
            <field name="arch" type="xml">
                <graph string="Conversion Trends" type="line">
                    <field name="conversion_date" type="row"/>
                    <field name="success" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Dashboard Action for Sales Managers -->
        <record id="action_conversion_dashboard" model="ir.actions.act_window">
            <field name="name">Conversion Dashboard</field>
            <field name="res_model">sale.order.conversion.log</field>
            <field name="view_mode">graph,pivot,tree,form</field>
            <field name="context">{'search_default_month': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No conversion data to analyze yet!
                </p>
                <p>
                    This dashboard will show conversion trends and success rates once your team starts using the conversion feature.
                </p>
            </field>
        </record>

        <!-- Dashboard Menu for Sales Managers -->
        <menuitem id="menu_conversion_dashboard"
                  name="Conversion Dashboard"
                  parent="sale.sale_menu_root"
                  action="action_conversion_dashboard"
                  groups="sales_team.group_sale_manager"
                  sequence="11"/>
    </data>
</odoo>