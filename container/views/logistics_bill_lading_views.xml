<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Bill of Lading Form View -->
        <record id="view_logistics_bill_lading_form" model="ir.ui.view">
            <field name="name">logistics.bill.lading.form</field>
            <field name="model">logistics.bill.lading</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" string="Confirm" type="object"
                                class="btn-primary" states="draft"/>
                        <button name="action_ship" string="Ship" type="object"
                                class="btn-primary" states="confirmed"/>
                        <button name="action_in_transit" string="In Transit" type="object"
                                class="btn-primary" states="shipped"/>
                        <button name="action_arrived" string="Arrived" type="object"
                                class="btn-primary" states="in_transit"/>
                        <button name="action_delivered" string="Delivered" type="object"
                                class="btn-primary" states="arrived"/>
                        <button name="action_close" string="Close" type="object"
                                class="btn-secondary" states="delivered"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                states="draft,confirmed,shipped"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                groups="base.group_system"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,confirmed,shipped,in_transit,arrived,delivered,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_purchase_requisition" 
                                    class="oe_stat_button" icon="fa-file-text"
                                    attrs="{'invisible': [('requisition_id', '=', False)]}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Purchase</span>
                                    <span class="o_stat_text">Requisition</span>
                                </div>
                            </button>
                            <button type="object" name="action_view_containers" 
                                    class="oe_stat_button" icon="fa-ship">
                                <field name="container_count" widget="statinfo" string="Containers"/>
                            </button>
                            <button type="object" name="action_view_purchase_orders" 
                                    class="oe_stat_button" icon="fa-shopping-cart"
                                    attrs="{'invisible': [('purchase_order_count', '=', 0)]}">
                                <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="B/L Number"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Bill of Lading Information">
                                <field name="number"/>
                                <field name="bl_type"/>
                                <field name="bl_date"/>
                                <field name="requisition_id" widget="many2many_tags"/>
                                <field name="booking_reference"/>
                                <field name="export_reference"/>
                            </group>
                            <group string="Financial Information">
                                <field name="freight_terms"/>
                                <field name="currency_id"/>
                                <field name="freight_amount"/>
                                <field name="total_charges"/>
                            </group>
                        </group>
                        
                        <group string="Parties">
                            <group>
                                <field name="shipper_id"/>
                                <field name="consignee_id"/>
                            </group>
                            <group>
                                <field name="notify_party_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        
                        <group string="Shipping Details">
                            <group>
                                <field name="forwarder_id" options="{'no_create': True}"/>
                                <field name="shipping_line_id" options="{'no_create': True}"/>
                                <field name="incoterm_id" options="{'no_create': True}"/>
                                <field name="port_of_loading_id" options="{'no_create': True}"/>
                                <field name="port_of_loading_country_id"/>
                                <field name="port_of_discharge_id" options="{'no_create': True}"/>
                                <field name="port_of_discharge_country_id"/>
                            </group>
                            <group>
                                <field name="vessel_name"/>
                                <field name="voyage_number"/>
                                <field name="place_of_receipt"/>
                                <field name="place_of_delivery"/>
                                <field name="forwarding_agent_reference"/>
                            </group>
                        </group>
                        
                        <group string="Schedule">
                            <group>
                                <field name="etd"/>
                                <field name="eta"/>
                            </group>
                            <group>
                                <field name="actual_departure_date"/>
                                <field name="actual_arrival_date"/>
                            </group>
                        </group>

                        <group string="Documents">
                            <field name="docs_draft"/>
                            <field name="docs_original"/>
                            <field name="ordino"/>
                            <field name="ccl_company" options="{'no_create': True}"/>

                        <notebook>
                            <page string="Containers">
                                <field name="container_ids" 
                                    domain="[('requisition_id', 'in', requisition_id)]"
                                    options="{'no_create': True, 'no_create_edit': True}">
                                    <tree>
                                        <field name="name"/>
                                        <field name="container_type"/>
                                        <field name="seal_number"/>
                                        <field name="port_of_discharge"/>
                                        <field name="weight_kg"/>
                                        <field name="volume_m3"/>
                                        <field name="state"/>
                                        <field name="total_value"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Cargo Details">
                                <group>
                                    <group>
                                        <field name="marks_and_numbers"/>
                                        <field name="description_of_goods"/>
                                    </group>
                                    <group>
                                        <field name="gross_weight"/>
                                        <field name="net_weight"/>
                                        <field name="measurement"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Terms &amp; Conditions">
                                <field name="payment_terms"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Tree View -->
        <record id="view_logistics_bill_lading_tree" model="ir.ui.view">
            <field name="name">logistics.bill.lading.tree</field>
            <field name="model">logistics.bill.lading</field>
            <field name="arch" type="xml">
                <tree decoration-info="state in ('draft','confirmed')" 
                      decoration-warning="state in ('shipped','in_transit')"
                      decoration-success="state in ('arrived','delivered')"
                      decoration-muted="state in ('closed','cancelled')" multi_edit="1">
                    <field name="name"/>
                    <field name="number"/>
                    <field name="bl_type"/>
                    <field name="bl_date"/>
                    <field name="requisition_id"/>
                    <field name="shipper_id"/>
                    <field name="consignee_id"/>
                    <field name="forwarder_id"/>
                    <field name="shipping_line_id"/>
                    <field name="incoterm_id"/>
                    <field name="vessel_name"/>
                    <field name="voyage_number"/>
                    <field name="port_of_loading_id"/>
                    <field name="port_of_discharge_id"/>
                    <field name="actual_departure_date"/>
                    <field name="actual_arrival_date"/>
                    <field name="container_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        
        <!-- Bill of Lading Kanban View -->
        <record id="view_logistics_bill_lading_kanban" model="ir.ui.view">
            <field name="name">logistics.bill.lading.kanban</field>
            <field name="model">logistics.bill.lading</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="bl_type"/>
                    <field name="shipper_id"/>
                    <field name="consignee_id"/>
                    <field name="vessel_name"/>
                    <field name="eta"/>
                    <field name="container_count"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <br/>
                                            <span class="o_kanban_record_subtitle">
                                                <field name="bl_type"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        🚢 <field name="vessel_name"/>
                                        <br/>
                                        📤 <field name="shipper_id"/>
                                        <br/>
                                        📥 <field name="consignee_id"/>
                                        <br/>
                                        📦 <field name="container_count"/> containers
                                        <br/>
                                        <t t-if="record.eta.raw_value">
                                            📅 ETA: <field name="eta"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Search View -->
        <record id="view_logistics_bill_lading_search" model="ir.ui.view">
            <field name="name">logistics.bill.lading.search</field>
            <field name="model">logistics.bill.lading</field>
            <field name="arch" type="xml">
                <search string="Bills of Lading">
                    <field name="name"/>
                    <field name="bl_type"/>
                    <field name="requisition_id"/>
                    <field name="vessel_name"/>
                    <field name="port_of_loading_id"/>
                    <field name="port_of_discharge_id"/>
                    <field name="shipper_id"/>
                    <field name="consignee_id"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="shipped" string="Shipped" domain="[('state', '=', 'shipped')]"/>
                    <filter name="in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                    <filter name="arrived" string="Arrived" domain="[('state', '=', 'arrived')]"/>
                    <separator/>
                    <filter name="this_month" string="This Month" 
                            domain="[('bl_date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_bl_type" string="B/L Type" context="{'group_by': 'bl_type'}"/>
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_port_loading" string="Port of Loading" context="{'group_by': 'port_of_loading_id'}"/>
                        <filter name="group_by_port_discharge" string="Port of Discharge" context="{'group_by': 'port_of_discharge_id'}"/>
                        <filter name="group_by_vessel" string="Vessel" context="{'group_by': 'vessel_name'}"/>
                    </group>
                </search>
            </field>
        </record>
        
    </data>
</odoo>
