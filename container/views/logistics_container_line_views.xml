<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Container Line Tree View -->
    <record id="view_logistics_container_line_tree" model="ir.ui.view">
        <field name="name">logistics.container.line.tree</field>
        <field name="model">logistics.container.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="container_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="price_unit"/>
                <field name="price_subtotal"/>
                <field name="lot_number"/>
                <field name="expiry_date"/>
                <field name="gross_weight"/>
                <field name="net_weight"/>
                <field name="total_gross_weight"/>
                <field name="total_net_weight"/>
                <field name="volume_per_unit"/>
                <field name="total_volume"/>
                <field name="container_state"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

</odoo>