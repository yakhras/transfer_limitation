<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Port Views -->
    <record id="view_logistics_port_tree" model="ir.ui.view">
        <field name="name">logistics.port.tree</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="timezone"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_logistics_port_form" model="ir.ui.view">
        <field name="name">logistics.port.form</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Port Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="timezone"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>