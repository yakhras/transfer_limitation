<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Requisition Form View Extension -->
    <record id="view_purchase_requisition_form_container" model="ir.ui.view">
        <field name="name">purchase.requisition.form.container</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add smart buttons to the existing button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_containers" 
                        class="oe_stat_button" icon="fa-ship">
                    <field name="container_count" widget="statinfo" string="Containers"/>
                </button>
                <button type="object" name="action_view_bill_ladings" 
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="bill_lading_count" widget="statinfo" string="Bills of Lading"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Optional: Add notebook pages to show related records directly in the form -->
    <record id="view_purchase_requisition_form_container_pages" model="ir.ui.view">
        <field name="name">purchase.requisition.form.container.pages</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add notebook pages if there's already a notebook, or create one -->
            <xpath expr="//notebook" position="inside">
                <page string="Containers" attrs="{'invisible': [('container_count', '=', 0)]}">
                    <field name="container_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="container_type"/>
                            <field name="supplier_id"/>
                            <field name="departure_date"/>
                            <field name="arrival_date"/>
                            <field name="state"/>
                            <field name="total_value"/>
                        </tree>
                    </field>
                </page>
                <page string="Bills of Lading" attrs="{'invisible': [('bill_lading_count', '=', 0)]}">
                    <field name="bill_lading_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="bl_type"/>
                            <field name="bl_date"/>
                            <field name="shipper_id"/>
                            <field name="consignee_id"/>
                            <field name="vessel_name"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

