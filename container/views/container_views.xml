    <!-- Container Dashboard/Search View -->
    <record id="view_logistics_container_search" model="ir.ui.view">
        <field name="name">logistics.container.search</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="requisition_id"/>
                <field name="container_type"/>
                <field name="location"/>
                <field name="tracking_number"/>
                <field name="vessel_name"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Shipped" name="shipped" domain="[('state','=','shipped')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state','=','in_transit')]"/>
                <filter string="Arrived" name="arrived" domain="[('state','=','arrived')]"/>
                <filter string="Released" name="released" domain="[('state','=','released')]"/>
                <filter string="Unloaded" name="unloaded" domain="[('state','=','unloaded')]"/>
                <separator/>
                <filter string="This Month" name="this_month" 
                        domain="[('arrival_date','&gt;=',datetime.datetime.now().replace(day=1))]"/>
                <filter string="Late Arrivals" name="late_arrivals"
                        domain="[('arrival_date','&lt;',datetime.datetime.now()),('state','in',['shipped','in_transit'])]"/>
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by':'supplier_id'}"/>
                    <filter string="Purchase Requisition" name="group_requisition" context="{'group_by':'requisition_id'}"/>
                    <filter string="Container Type" name="group_type" context="{'group_by':'container_type'}"/>
                    <filter string="Location" name="group_location" context="{'group_by':'location'}"/>
                    <filter string="Arrival Date" name="group_arrival" context="{'group_by':'arrival_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_purchase_requisition_form_container_distribution" model="ir.ui.view">
        <field name="name">purchase.requisition.form.container.distribution</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add invisible fields for attrs -->
            <xpath expr="//form" position="inside">
                <field name="has_container_distribution" invisible="1"/>
            </xpath>
            
            <!-- Add Container Distribution page to notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Container Distribution" attrs="{'invisible': [('line_ids', '=', [])]}" autofocus="context.get('default_active_tab') == 'container_distribution'">
                    <div class="oe_button_box" name="container_distribution_buttons">
                        <button name="action_generate_container_distribution" 
                                string="Generate Distribution" 
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('has_container_distribution', '=', True)]}"/>
                        <button name="action_create_containers_from_distribution" 
                                string="Create Containers" 
                                type="object"
                                class="btn-success"
                                attrs="{'invisible': [('has_container_distribution', '=', False)]}"
                                confirm="This will create containers based on the distribution. Continue?"/>
                    </div>
                    
                    <div attrs="{'invisible': [('has_container_distribution', '=', True)]}">
                        <div class="alert alert-info" role="alert">
                            <strong>Container Distribution</strong><br/>
                            Click "Generate Distribution" to create container distribution planning from your requisition lines.
                            You can then specify how many containers needed for each product and create the actual containers.
                        </div>
                    </div>
                    
                    <field name="container_distribution_ids" 
                           attrs="{'invisible': [('has_container_distribution', '=', False)]}">
                        <tree editable="bottom">
                            <field name="product_id" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="container_count"/>
                            <field name="distribution_method"/>
                            <field name="qty_per_container" readonly="1"/>
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="product_id" readonly="1"/>
                                    <field name="total_qty" readonly="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="container_count"/>
                                    <field name="distribution_method"/>
                                    <field name="qty_per_container" readonly="1"/>
                                </group>
                            </group>
                            <!-- Future: Manual distribution lines -->
                            <notebook attrs="{'invisible': [('distribution_method', '!=', 'manual')]}">
                                <page string="Manual Distribution">
                                    <field name="manual_distribution_ids">
                                        <tree editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="container_name"/>
                                            <field name="qty"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </form>
                    </field>
                    
                    <div class="mt16" attrs="{'invisible': [('has_container_distribution', '=', False)]}">
                        <p><strong>Summary:</strong></p>
                        <p>Total containers will be created: <span class="badge badge-info"><field name="container_distribution_ids" widget="count"/></span></p>
                        <p class="text-muted">
                            After creating containers, you can modify container details (type, vessel info, etc.) in the Containers tab.
                        </p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Container Distribution Tree View -->
    <record id="view_purchase_requisition_container_distribution_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.container.distribution.tree</field>
        <field name="model">purchase.requisition.container.distribution</field>
        <field name="arch" type="xml">
            <tree>
                <field name="requisition_id"/>
                <field name="product_id"/>
                <field name="total_qty"/>
                <field name="product_uom_id"/>
                <field name="container_count"/>
                <field name="distribution_method"/>
                <field name="qty_per_container"/>
            </tree>
        </field>
    </record>

    <!-- Container Distribution Form View -->
    <record id="view_purchase_requisition_container_distribution_form" model="ir.ui.view">
        <field name="name">purchase.requisition.container.distribution.form</field>
        <field name="model">purchase.requisition.container.distribution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="requisition_id"/>
                            <field name="product_id"/>
                            <field name="total_qty"/>
                            <field name="product_uom_id"/>
                        </group>
                        <group>
                            <field name="container_count"/>
                            <field name="distribution_method"/>
                            <field name="qty_per_container"/>
                        </group>
                    </group>
                    
                    <notebook attrs="{'invisible': [('distribution_method', '!=', 'manual')]}">
                        <page string="Manual Distribution">
                            <field name="manual_distribution_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="container_name"/>
                                    <field name="qty"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_purchase_requisition_container_distribution" model="ir.actions.act_window">
        <field name="name">Container Distribution</field>
        <field name="res_model">purchase.requisition.container.distribution</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu (optional - for debugging/admin) -->
    <menuitem id="menu_container_distribution" 
              name="Container Distribution" 
              parent="menu_container_root" 
              sequence="25"
              action="action_purchase_requisition_container_distribution"
              groups="base.group_system"/>

    

    <!-- Actions -->
    <record id="action_container_container" model="ir.actions.act_window">
        <field name="name">Containers</field>
        <field name="res_model">logistics.container</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shipping container!
            </p>
            <p>
                Track containers from shipping to delivery with full visibility 
                into contents, costs, and logistics operations.
            </p>
        </field>
    </record>

    <record id="action_container_line" model="ir.actions.act_window">
        <field name="name">Container Contents</field>
        <field name="res_model">logistics.container.line</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                View all products across containers!
            </p>
        </field>
    </record>

    <record id="action_container_bill_lading" model="ir.actions.act_window">
        <field name="name">Bills of Lading</field>
        <field name="res_model">logistics.bill.lading</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Bill of Lading!
            </p>
            <p>
                Manage shipping documents and track cargo movements 
                with comprehensive bill of lading management.
            </p>
        </field>
    </record>

    <record id="action_container_port" model="ir.actions.act_window">
        <field name="name">Ports</field>
        <field name="res_model">logistics.port</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your ports!
            </p>
            <p>
                Set up ports of loading and discharge for your shipping operations.
            </p>
        </field>
    </record>


    <!-- Menu Structure - Standalone App -->
    <menuitem id="menu_container_root" name="Container" sequence="45" 
              web_icon="container,static/description/icon.png"/>
    
    <menuitem id="menu_container_containers" name="Containers" 
              parent="menu_container_root" sequence="10"
              action="action_container_container"/>
              
    <menuitem id="menu_container_lines" name="Container Contents" 
              parent="menu_container_root" sequence="20"
              action="action_container_line"/>
              
    <menuitem id="menu_container_bill_lading" name="Bills of Lading" 
              parent="menu_container_root" sequence="30"
              action="action_container_bill_lading"/>
              
    <menuitem id="menu_container_ports" name="Ports" 
              parent="menu_container_root" sequence="40"
              action="action_container_port"/>

</odoo>