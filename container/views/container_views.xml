    <!-- Bill of Lading Views -->
    <record id="view_logistics_bill_lading_tree" model="ir.ui.view">
        <field name="name">logistics.bill.lading.tree</field>
        <field name="model">logistics.bill.lading</field>
        <field name="arch" type="xml">
            <tree decoration-info="state in ('draft','confirmed')" 
                  decoration-warning="state in ('shipped','in_transit')"
                  decoration-success="state in ('arrived','delivered')"
                  decoration-muted="state in ('closed','cancelled')">
                <field name="name"/>
                <field name="bl_type"/>
                <field name="bl_date"/>
                <field name="requisition_id"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="vessel_name"/>
                <field name="port_of_loading_id"/>
                <field name="port_of_discharge_id"/>
                <field name="etd"/>
                <field name="eta"/>
                <field name="container_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_logistics_bill_lading_form" model="ir.ui.view">
        <field name="name">logistics.bill.lading.form</field>
        <field name="model">logistics.bill.lading</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" states="draft"/>
                    <button name="action_ship" string="Ship" type="object"
                            class="btn-primary" states="confirmed"/>
                    <button name="action_in_transit" string="In Transit" type="object"
                            class="btn-primary" states="shipped"/>
                    <button name="action_arrived" string="Arrived" type="object"
                            class="btn-primary" states="in_transit"/>
                    <button name="action_delivered" string="Delivered" type="object"
                            class="btn-primary" states="arrived"/>
                    <button name="action_close" string="Close" type="object"
                            class="btn-secondary" states="delivered"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="draft,confirmed,shipped"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,shipped,in_transit,arrived,delivered,closed"/>
                </header>
                <sheet>
                    <!-- <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_containers" 
                                class="oe_stat_button" icon="fa-ship">
                            <field name="container_count" widget="statinfo" string="Containers"/>
                        </button>
                    </div> -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="B/L Number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Bill of Lading Information">
                            <field name="bl_type"/>
                            <field name="bl_date"/>
                            <field name="requisition_id"/>
                            <field name="booking_reference"/>
                            <field name="export_reference"/>
                        </group>
                        <group string="Financial Information">
                            <field name="freight_terms"/>
                            <field name="currency_id"/>
                            <field name="freight_amount"/>
                            <field name="total_charges"/>
                        </group>
                    </group>
                    
                    <group string="Parties">
                        <group>
                            <field name="shipper_id"/>
                            <field name="consignee_id"/>
                        </group>
                        <group>
                            <field name="notify_party_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group string="Shipping Details">
                        <group>
                            <field name="vessel_name"/>
                            <field name="voyage_number"/>
                            <field name="port_of_loading_id"/>
                            <field name="port_of_discharge_id"/>
                        </group>
                        <group>
                            <field name="place_of_receipt"/>
                            <field name="place_of_delivery"/>
                            <field name="forwarding_agent_reference"/>
                        </group>
                    </group>
                    
                    <group string="Schedule">
                        <group>
                            <field name="etd"/>
                            <field name="eta"/>
                        </group>
                        <group>
                            <field name="actual_departure_date"/>
                            <field name="actual_arrival_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Containers">
                            <field name="container_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="container_type"/>
                                    <field name="seal_number"/>
                                    <field name="weight_kg"/>
                                    <field name="volume_m3"/>
                                    <field name="state"/>
                                    <field name="total_value"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Cargo Details">
                            <group>
                                <group>
                                    <field name="marks_and_numbers"/>
                                    <field name="description_of_goods"/>
                                </group>
                                <group>
                                    <field name="gross_weight"/>
                                    <field name="net_weight"/>
                                    <field name="measurement"/>
                                </group>
                            </group>
                        </page>
                        <page string="Terms &amp; Conditions">
                            <field name="payment_terms"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Bill of Lading Kanban View -->
    <record id="view_logistics_bill_lading_kanban" model="ir.ui.view">
        <field name="name">logistics.bill.lading.kanban</field>
        <field name="model">logistics.bill.lading</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="bl_type"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="vessel_name"/>
                <field name="eta"/>
                <field name="container_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="bl_type"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    🚢 <field name="vessel_name"/>
                                    <br/>
                                    📤 <field name="shipper_id"/>
                                    <br/>
                                    📥 <field name="consignee_id"/>
                                    <br/>
                                    📦 <field name="container_count"/> containers
                                    <br/>
                                    <t t-if="record.eta.raw_value">
                                        📅 ETA: <field name="eta"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Port Views -->
    <record id="view_logistics_port_tree" model="ir.ui.view">
        <field name="name">logistics.port.tree</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="timezone"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_logistics_port_form" model="ir.ui.view">
        <field name="name">logistics.port.form</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Port Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="timezone"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Container Tree View -->
    <record id="view_logistics_container_tree" model="ir.ui.view">
        <field name="name">logistics.container.tree</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <tree decoration-info="state in ('draft','shipped')" 
                  decoration-warning="state in ('in_transit','customs')"
                  decoration-success="state in ('arrived','released')"
                  decoration-muted="state in ('empty','returned')">
                <field name="name"/>
                <field name="container_type"/>
                <field name="requisition_id"/>
                <field name="supplier_id"/>
                <field name="departure_date"/>
                <field name="arrival_date"/>
                <field name="location"/>
                <field name="state"/>
                <field name="product_count"/>
                <field name="total_qty"/>
                <field name="total_value"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Container Form View -->
    <record id="view_logistics_container_form" model="ir.ui.view">
        <field name="name">logistics.container.form</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ship" string="Ship" type="object"
                            class="btn-primary" states="draft"/>
                    <button name="action_in_transit" string="In Transit" type="object"
                            class="btn-primary" states="shipped"/>
                    <button name="action_arrived" string="Arrived" type="object"
                            class="btn-primary" states="in_transit"/>
                    <button name="action_customs" string="Customs" type="object"
                            class="btn-warning" states="arrived"/>
                    <button name="action_released" string="Released" type="object"
                            class="btn-primary" states="customs"/>
                    <button name="action_start_unloading" string="Start Unloading" type="object"
                            class="btn-primary" states="arrived,released"/>
                    <button name="action_unloaded" string="Unloaded" type="object"
                            class="btn-primary" states="unloading"/>
                    <button name="action_empty" string="Empty" type="object"
                            class="btn-secondary" states="unloaded"/>
                    <button name="action_returned" string="Returned" type="object"
                            class="btn-secondary" states="empty"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,shipped,in_transit,arrived,customs,released,unloading,unloaded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Container Number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Container Information">
                            <field name="container_type"/>
                            <field name="requisition_id"/>
                            <field name="supplier_id"/>
                            <field name="purchase_order_id"/>
                            <field name="seal_number"/>
                            <field name="tracking_number"/>
                        </group>
                        <group string="Physical Properties">
                            <field name="weight_kg"/>
                            <field name="volume_m3"/>
                            <field name="location"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group string="Logistics Details">
                        <group>
                            <field name="vessel_name"/>
                            <field name="voyage_number"/>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                        </group>
                        <group>
                            <field name="departure_date"/>
                            <field name="arrival_date"/>
                            <field name="currency_id"/>
                        </group>
                    </group>

                    <group string="Summary">
                        <group>
                            <field name="product_count"/>
                            <field name="total_qty"/>
                            <field name="total_value"/>
                        </group>
                        <group>
                            <field name="freight_cost"/>
                            <field name="insurance_cost"/>
                            <field name="customs_duty"/>
                            <field name="other_charges"/>
                            <field name="total_cost"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Container Contents">
                            <field name="container_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="lot_number"/>
                                    <field name="expiry_date"/>
                                    <field name="country_of_origin"/>
                                    <field name="gross_weight"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="product_qty"/>
                                            <field name="product_uom_id"/>
                                            <field name="price_unit"/>
                                            <field name="price_subtotal"/>
                                        </group>
                                        <group>
                                            <field name="lot_number"/>
                                            <field name="serial_number"/>
                                            <field name="manufacturing_date"/>
                                            <field name="expiry_date"/>
                                            <field name="country_of_origin"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group>
                                            <field name="gross_weight"/>
                                            <field name="net_weight"/>
                                            <field name="volume_per_unit"/>
                                        </group>
                                        <group>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    <field name="notes"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Container Kanban View -->
    <record id="view_logistics_container_kanban" model="ir.ui.view">
        <field name="name">logistics.container.kanban</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="container_type"/>
                <field name="supplier_id"/>
                <field name="arrival_date"/>
                <field name="total_value"/>
                <field name="state"/>
                <field name="location"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="container_type"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="supplier_id"/>
                                    <br/>
                                    <t t-if="record.location.raw_value">
                                        📍 <field name="location"/>
                                        <br/>
                                    </t>
                                    <t t-if="record.arrival_date.raw_value">
                                        📅 <field name="arrival_date"/>
                                        <br/>
                                    </t>
                                    💰 <field name="total_value"/> <field name="currency_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Container Line Tree View -->
    <record id="view_logistics_container_line_tree" model="ir.ui.view">
        <field name="name">logistics.container.line.tree</field>
        <field name="model">logistics.container.line</field>
        <field name="arch" type="xml">
