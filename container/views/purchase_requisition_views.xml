<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Requisition Form View Extension -->
    <record id="view_purchase_requisition_form_container" model="ir.ui.view">
        <field name="name">purchase.requisition.form.container</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add smart buttons to the existing button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_containers" 
                        class="oe_stat_button" icon="fa-ship">
                    <field name="container_count" widget="statinfo" string="Containers"/>
                </button>
                <button type="object" name="action_view_bill_ladings" 
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="bill_lading_count" widget="statinfo" string="Bills of Lading"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Optional: Add notebook pages to show related records directly in the form -->
    <record id="view_purchase_requisition_form_container_pages" model="ir.ui.view">
        <field name="name">purchase.requisition.form.container.pages</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add notebook pages if there's already a notebook, or create one -->
            <xpath expr="//notebook" position="inside">
                <page string="Containers" attrs="{'invisible': [('container_count', '=', 0)]}">
                    <field name="container_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="container_type"/>
                            <field name="supplier_id"/>
                            <field name="departure_date"/>
                            <field name="arrival_date"/>
                            <field name="state"/>
                            <field name="total_value"/>
                        </tree>
                    </field>
                </page>
                <page string="Bills of Lading" attrs="{'invisible': [('bill_lading_count', '=', 0)]}">
                    <field name="bill_lading_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="bl_type"/>
                            <field name="bl_date"/>
                            <field name="shipper_id"/>
                            <field name="consignee_id"/>
                            <field name="vessel_name"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_requisition_form_container_distribution" model="ir.ui.view">
        <field name="name">purchase.requisition.form.container.distribution</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <!-- Add invisible fields for attrs -->
            <xpath expr="//form" position="inside">
                <field name="has_container_distribution" invisible="1"/>
            </xpath>
            
            <!-- Add Container Distribution page to notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Container Distribution" 
                      attrs="{'invisible': [('line_ids', '=', [])]}"
                      autofocus="context.get('default_active_tab') == 'container_distribution'">
                    <div class="oe_button_box" name="container_distribution_buttons">
                        <button name="action_create_containers_from_distribution" 
                                string="Create Containers" 
                                type="object"
                                class="btn-success"
                                attrs="{'invisible': [('has_container_distribution', '=', False)]}"
                                confirm="This will create containers based on the distribution. Continue?"/>
                    </div>
                    
                    <div attrs="{'invisible': [('has_container_distribution', '=', True)]}">
                        <div class="alert alert-info" role="alert">
                            <strong>Container Distribution</strong><br/>
                            Add products to your requisition lines above. Distribution records will be created automatically.
                            You can then specify how many containers needed for each product and create the actual containers.
                        </div>
                    </div>
                    
                    <field name="container_distribution_ids" 
                           attrs="{'invisible': [('has_container_distribution', '=', False)]}">
                        <tree editable="bottom">
                            <field name="product_id" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="container_count"/>
                            <field name="distribution_method"/>
                            <field name="qty_per_container" readonly="1"/>
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="product_id" readonly="1"/>
                                    <field name="total_qty" readonly="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="container_count"/>
                                    <field name="distribution_method"/>
                                    <field name="qty_per_container" readonly="1"/>
                                </group>
                            </group>
                            <!-- Future: Manual distribution lines -->
                            <notebook attrs="{'invisible': [('distribution_method', '!=', 'manual')]}">
                                <page string="Manual Distribution">
                                    <field name="manual_distribution_ids">
                                        <tree editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="container_name"/>
                                            <field name="qty"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </form>
                    </field>
                    
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>