<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Container Tree View -->
    <record id="view_logistics_container_tree" model="ir.ui.view">
        <field name="name">logistics.container.tree</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <tree decoration-info="state in ('draft','shipped')" 
                  decoration-warning="state in ('in_transit','customs')"
                  decoration-success="state in ('arrived','released')"
                  decoration-muted="state in ('empty','returned')"
                  editable="bottom"
                  create="false">
                <field name="name" widget="handle"/>
                <field name="container_type" />
                <field name="requisition_id" />
                <field name="supplier_id"/>
                <field name="departure_date" />
                <field name="arrival_date" />
                <field name="location"/>
                <field name="state"/>
                <field name="product_count" />
                <field name="total_qty" />
                <field name="total_value" />
                <field name="currency_id" />
            </tree>
        </field>
    </record>


    <!-- Container Form View -->
    <record id="view_logistics_container_form" model="ir.ui.view">
        <field name="name">logistics.container.form</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ship" string="Ship" type="object"
                            class="btn-primary" states="draft"/>
                    <button name="action_in_transit" string="In Transit" type="object"
                            class="btn-primary" states="shipped"/>
                    <button name="action_arrived" string="Arrived" type="object"
                            class="btn-primary" states="in_transit"/>
                    <button name="action_customs" string="Customs" type="object"
                            class="btn-warning" states="arrived"/>
                    <button name="action_released" string="Released" type="object"
                            class="btn-primary" states="customs"/>
                    <button name="action_start_unloading" string="Start Unloading" type="object"
                            class="btn-primary" states="arrived,released"/>
                    <button name="action_unloaded" string="Unloaded" type="object"
                            class="btn-primary" states="unloading"/>
                    <button name="action_empty" string="Empty" type="object"
                            class="btn-secondary" states="unloaded"/>
                    <button name="action_returned" string="Returned" type="object"
                            class="btn-secondary" states="empty"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,shipped,in_transit,arrived,customs,released,unloading,unloaded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Container Number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Container Information">
                            <field name="container_type"/>
                            <field name="requisition_id"/>
                            <field name="supplier_id"/>
                            <field name="purchase_order_id"/>
                            <field name="seal_number"/>
                            <field name="tracking_number"/>
                        </group>
                        <group string="Physical Properties">
                            <field name="weight_kg"/>
                            <field name="volume_m3"/>
                            <field name="location"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group string="Logistics Details">
                        <group>
                            <field name="vessel_name"/>
                            <field name="voyage_number"/>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                        </group>
                        <group>
                            <field name="departure_date"/>
                            <field name="arrival_date"/>
                            <field name="currency_id"/>
                        </group>
                    </group>

                    <group string="Summary">
                        <group>
                            <field name="product_count"/>
                            <field name="total_qty"/>
                            <field name="total_value"/>
                        </group>
                        <group>
                            <field name="freight_cost"/>
                            <field name="insurance_cost"/>
                            <field name="customs_duty"/>
                            <field name="other_charges"/>
                            <field name="total_cost"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Container Contents">
                            <field name="container_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="lot_number"/>
                                    <field name="expiry_date"/>
                                    <field name="country_of_origin"/>
                                    <field name="gross_weight"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="product_qty"/>
                                            <field name="product_uom_id"/>
                                            <field name="price_unit"/>
                                            <field name="price_subtotal"/>
                                        </group>
                                        <group>
                                            <field name="lot_number"/>
                                            <field name="serial_number"/>
                                            <field name="manufacturing_date"/>
                                            <field name="expiry_date"/>
                                            <field name="country_of_origin"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group>
                                            <field name="gross_weight"/>
                                            <field name="net_weight"/>
                                            <field name="volume_per_unit"/>
                                        </group>
                                        <group>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    <field name="notes"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Container Kanban View -->
    <record id="view_logistics_container_kanban" model="ir.ui.view">
        <field name="name">logistics.container.kanban</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="container_type"/>
                <field name="supplier_id"/>
                <field name="arrival_date"/>
                <field name="total_value"/>
                <field name="state"/>
                <field name="location"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="container_type"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="supplier_id"/>
                                    <br/>
                                    <t t-if="record.location.raw_value">
                                        📍 <field name="location"/>
                                        <br/>
                                    </t>
                                    <t t-if="record.arrival_date.raw_value">
                                        📅 <field name="arrival_date"/>
                                        <br/>
                                    </t>
                                    💰 <field name="total_value"/> <field name="currency_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_logistics_container_form_smart_buttons" model="ir.ui.view">
        <field name="name">logistics.container.form.smart.buttons</field>
        <field name="model">logistics.container</field>
        <field name="inherit_id" ref="view_logistics_container_form"/>
        <field name="arch" type="xml">
            <!-- Add button box to container form -->
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_view_purchase_requisition" 
                            class="oe_stat_button" icon="fa-file-text"
                            attrs="{'invisible': [('requisition_id', '=', False)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Purchase</span>
                            <span class="o_stat_text">Requisition</span>
                        </div>
                    </button>
                    <button type="object" name="action_view_purchase_orders" 
                            class="oe_stat_button" icon="fa-shopping-cart"
                            attrs="{'invisible': [('purchase_order_count', '=', 0)]}">
                        <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Container Dashboard/Search View -->
    <record id="view_logistics_container_search" model="ir.ui.view">
        <field name="name">logistics.container.search</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="requisition_id"/>
                <field name="container_type"/>
                <field name="location"/>
                <field name="tracking_number"/>
                <field name="vessel_name"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Shipped" name="shipped" domain="[('state','=','shipped')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state','=','in_transit')]"/>
                <filter string="Arrived" name="arrived" domain="[('state','=','arrived')]"/>
                <filter string="Released" name="released" domain="[('state','=','released')]"/>
                <filter string="Unloaded" name="unloaded" domain="[('state','=','unloaded')]"/>
                <separator/>
                <filter string="This Month" name="this_month" 
                        domain="[('arrival_date','&gt;=',datetime.datetime.now().replace(day=1))]"/>
                <filter string="Late Arrivals" name="late_arrivals"
                        domain="[('arrival_date','&lt;',datetime.datetime.now()),('state','in',['shipped','in_transit'])]"/>
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by':'supplier_id'}"/>
                    <filter string="Purchase Requisition" name="group_requisition" context="{'group_by':'requisition_id'}"/>
                    <filter string="Container Type" name="group_type" context="{'group_by':'container_type'}"/>
                    <filter string="Location" name="group_location" context="{'group_by':'location'}"/>
                    <filter string="Arrival Date" name="group_arrival" context="{'group_by':'arrival_date'}"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>