<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Container Tree View -->
    <record id="view_logistics_container_tree" model="ir.ui.view">
        <field name="name">logistics.container.tree</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <tree decoration-info="state in ('draft','shipped')" 
                  decoration-warning="state in ('in_transit','antrepo')"
                  decoration-success="state in ('arrived','released')"
                  decoration-muted="state in ('at_port','purchasing')"
                  decoration-danger="state in ('unloading','unloaded')"
                  multi_edit="1">
                <field name="name" />
                <field name="container_number" />
                <field name="container_type" />
                <field name="declaration_type" />
                <field name="requisition_id" />
                <field name="purchase_order_ids" widget="many2many_tags" domain="[('requisition_id', '=', requisition_id)]" />
                <field name="supplier_id" readonly="1"/>
                <field name="supplier_ref" readonly="1"/>
                <field name="forwarder_id" readonly="1"/>
                <field name="shipping_line_id" readonly="1"/>
                <field name="incoterm_id" readonly="1"/>
                <field name="vessel_name" readonly="1"/>
                <field name="voyage_number" readonly="1"/>
                <field name="departure_date" />
                <field name="arrival_date" />
                <field name="country_id" readonly="1"/>
                <field name="state"/>
                <field name="product_count" />
                <field name="total_qty" />
                <field name="total_value" />
                <field name="currency_id" />
            </tree>
        </field>
    </record>

    <!-- Container Form View -->
    <record id="view_logistics_container_form" model="ir.ui.view">
        <field name="name">logistics.container.form</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ship" string="Ship" type="object"
                            class="btn-primary" states="draft" confirm="Are you sure you want to ship this container?"/>
                    <button name="action_in_transit" string="In Transit" type="object"
                            class="btn-primary" states="shipped"/>
                    <button name="action_arrived" string="Arrived" type="object"
                            class="btn-primary" states="in_transit"/>
                    <button name="action_antrepo" string="Antrepo" type="object"
                            class="btn-warning" states="arrived"/>
                    <button name="action_released" string="Released" type="object"
                            class="btn-primary" states="antrepo"/>
                    <button name="action_start_unloading" string="Start Unloading" type="object"
                            class="btn-primary" states="released"/>
                    <button name="action_unloaded" string="Unloaded" type="object"
                            class="btn-primary" states="unloading"/>
                    <button name="action_at_port" string="At Port" type="object"
                            class="btn-secondary" states="unloaded"/>
                    <button name="action_purchasing" string="Purchasing" type="object"
                            class="btn-info" states="at_port"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            groups="base.group_system" confirm="Are you sure you want to reset to draft?"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,shipped,in_transit,arrived,antrepo,released,unloading,unloaded,at_port,purchasing"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Container Reference" readonly="1"/>
                        </h1>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_bill_of_lading" 
                                    class="oe_stat_button" icon="fa-ship">
                                <field name="bill_lading_count" widget="statinfo" string="Bill of Lading"/>
                            </button>
                        </div>
                    </div>
                    <group>
                        <group string="Container Information">
                            <field name="container_type"/>
                            <field name="container_number"/>
                            <field name="declaration_type"/>
                            <field name="requisition_id"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="supplier_ref" readonly="1"/>
                            <field name="purchase_order_ids" widget="many2many_tags"/>
                            <field name="seal_number"/>
                            <field name="tracking_number"/>
                        </group>
                        <group string="Physical Properties">
                            <field name="weight_kg"/>
                            <field name="volume_m3"/>
                            <field name="country_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Logistics Details">
                        <group>
                            <field name="forwarder_id" readonly="1"/>
                            <field name="shipping_line_id" readonly="1"/>
                            <field name="incoterm_id" readonly="1"/>
                            <field name="vessel_name"/>
                            <field name="voyage_number"/>
                        </group>
                        <group>
                            <field name="port_of_loading"/>
                            <field name="port_of_discharge"/>
                            <field name="departure_date"/>
                            <field name="arrival_date"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Document Fields -->
                    <group string="Documents">
                        <field name="docs_draft"/>
                        <field name="docs_original"/>
                        <field name="ordino"/>
                        <field name="ccl_company" options="{'no_create': True}"/>
                    </group>

                    <group string="Summary">
                        <group>
                            <field name="product_count" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="total_value" readonly="1"/>
                        </group>
                        <group>
                            <field name="freight_cost"/>
                            <field name="insurance_cost"/>
                            <field name="customs_duty"/>
                            <field name="other_charges"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Container Contents">
                            <field name="container_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="lot_number"/>
                                    <field name="expiry_date"/>
                                    <field name="country_of_origin"/>
                                    <field name="gross_weight"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="product_qty"/>
                                            <field name="product_uom_id"/>
                                            <field name="price_unit"/>
                                            <field name="price_subtotal"/>
                                        </group>
                                        <group>
                                            <field name="lot_number"/>
                                            <field name="serial_number"/>
                                            <field name="manufacturing_date"/>
                                            <field name="expiry_date"/>
                                            <field name="country_of_origin"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group>
                                            <field name="gross_weight"/>
                                            <field name="net_weight"/>
                                            <field name="volume_per_unit"/>
                                        </group>
                                        <group>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    <field name="notes"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Container Kanban View -->
    <record id="view_logistics_container_kanban" model="ir.ui.view">
        <field name="name">logistics.container.kanban</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="container_type"/>
                <field name="supplier_id"/>
                <field name="supplier_ref"/>
                <field name="arrival_date"/>
                <field name="total_value"/>
                <field name="state"/>
                <field name="country_id"/>
                <field name="port_of_loading"/>
                <field name="port_of_discharge"/>
                <field name="currency_id"/>
                <field name="purchase_order_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="container_type"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="supplier_id"/>
                                    <t t-if="record.supplier_ref.raw_value">
                                        <br/>
                                        <span class="text-muted">Ref: <field name="supplier_ref"/></span>
                                    </t>
                                    <br/>
                                    <t t-if="record.country_id.raw_value">
                                        🌍 <field name="country_id"/>
                                        <br/>
                                    </t>
                                    <t t-if="record.port_of_discharge.raw_value">
                                        🚢 <field name="port_of_discharge"/>
                                        <br/>
                                    </t>
                                    <t t-if="record.arrival_date.raw_value">
                                        📅 <field name="arrival_date"/>
                                        <br/>
                                    </t>
                                    💰 <field name="total_value"/> <field name="currency_id"/>
                                    <br/>
                                    <t t-if="record.purchase_order_ids.raw_value.length > 0">
                                        🛒 <t t-esc="record.purchase_order_ids.raw_value.length"/> PO(s)
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_logistics_container_form_smart_buttons" model="ir.ui.view">
        <field name="name">logistics.container.form.smart.buttons</field>
        <field name="model">logistics.container</field>
        <field name="inherit_id" ref="view_logistics_container_form"/>
        <field name="arch" type="xml">
            <!-- Add button box to container form -->
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_view_purchase_requisition" 
                            class="oe_stat_button" icon="fa-file-text"
                            attrs="{'invisible': [('requisition_id', '=', False)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Purchase</span>
                            <span class="o_stat_text">Requisition</span>
                        </div>
                    </button>
                    <button type="object" name="action_view_purchase_orders" 
                            class="oe_stat_button" icon="fa-shopping-cart"
                            attrs="{'invisible': [('purchase_order_count', '=', 0)]}">
                        <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Container Dashboard/Search View -->
    <record id="view_logistics_container_search" model="ir.ui.view">
        <field name="name">logistics.container.search</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="container_number"/>
                <field name="supplier_id"/>
                <field name="supplier_ref"/>
                <field name="requisition_id"/>
                <field name="purchase_order_ids"/>
                <field name="container_type"/>
                <field name="country_id"/>
                <field name="port_of_loading"/>
                <field name="port_of_discharge"/>
                <field name="tracking_number"/>
                <field name="vessel_name"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Shipped" name="shipped" domain="[('state','=','shipped')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state','=','in_transit')]"/>
                <filter string="Arrived" name="arrived" domain="[('state','=','arrived')]"/>
                <filter string="Antrepo" name="antrepo" domain="[('state','=','antrepo')]"/>
                <filter string="Released" name="released" domain="[('state','=','released')]"/>
                <filter string="Unloading" name="unloading" domain="[('state','=','unloading')]"/>
                <filter string="Unloaded" name="unloaded" domain="[('state','=','unloaded')]"/>
                <filter string="At Port" name="at_port" domain="[('state','=','at_port')]"/>
                <filter string="Purchasing" name="purchasing" domain="[('state','=','purchasing')]"/>
                <separator/>
                <filter string="This Month" name="this_month" 
                        domain="[('arrival_date','&gt;=',datetime.datetime.now().replace(day=1))]"/>
                <filter string="Late Arrivals" name="late_arrivals"
                        domain="[('arrival_date','&lt;',datetime.datetime.now()),('state','in',['shipped','in_transit','antrepo'])]"/>
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by':'supplier_id'}"/>
                    <filter string="Country" name="group_country" context="{'group_by':'country_id'}"/>
                    <filter string="Port of Loading" name="group_port_loading" context="{'group_by':'port_of_loading'}"/>
                    <filter string="Port of Discharge" name="group_port_discharge" context="{'group_by':'port_of_discharge'}"/>
                    <filter string="Purchase Requisition" name="group_requisition" context="{'group_by':'requisition_id'}"/>
                    <filter string="Container Type" name="group_type" context="{'group_by':'container_type'}"/>
                    <filter string="Arrival Date" name="group_arrival" context="{'group_by':'arrival_date'}"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>