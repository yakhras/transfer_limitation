<?xml version="1.0" encoding="utf-8"?>
<odoo>
              
    <!-- Smart Button for Mailing Lists -->
    <record id="view_mailing_list_form_inherit_updater" model="ir.ui.view">
        <field name="name">mailing.list.form.inherit.updater</field>
        <field name="model">mailing.list</field>
        <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_updater" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-refresh"
                        string="Update Contacts">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Update</span>
                        <span class="o_stat_text">Contacts</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>