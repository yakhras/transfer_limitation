<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="mailing_list_updater_t.MainTemplate" owl="1">
        <!-- Modal Backdrop -->
        <div class="mailing-updater-backdrop">
            <!-- Centered Dialog Container -->
            <div class="mailing-updater-dialog">
                
                <!-- Header -->
                <div class="dialog-header">
                    <div class="header-content">
                        <div class="header-icon">
                            <i class="fa fa-envelope-o"></i>
                        </div>
                        <div class="header-text">
                            <h1>Mailing List Updater</h1>
                            <p>Efficiently update your mailing list with advanced filtering</p>
                        </div>
                    </div>
                </div>
                
                <!-- Error Messages -->
                <div t-if="state.errors.length > 0" class="dialog-errors">
                    <div t-foreach="state.errors" t-as="error" class="error-alert">
                        <i class="fa fa-exclamation-triangle"></i>
                        <span t-esc="error"></span>
                    </div>
                </div>
                
                <!-- Step Navigation -->
                <div class="dialog-navigation">
                    <div class="step-pills">
                        <div t-att-class="state.currentStep === 'target_selection' ? 'step-pill active' : 'step-pill'"
                             t-on-click="() => this.goToStep('target_selection')">
                            <i class="fa fa-envelope"></i>
                            <span>Select Target</span>
                        </div>
                        <div t-att-class="state.currentStep === 'source_selection' ? 'step-pill active' : 'step-pill'"
                             t-on-click="() => this.goToStep('source_selection')">
                            <i class="fa fa-database"></i>
                            <span>Select Sources</span>
                        </div>
                        <div t-att-class="state.currentStep === 'filter_building' ? 'step-pill active' : 'step-pill'"
                             t-on-click="() => this.goToStep('filter_building')">
                            <i class="fa fa-filter"></i>
                            <span>Build Filters</span>
                        </div>
                        <div t-att-class="state.currentStep === 'preview' ? 'step-pill active' : 'step-pill'"
                             t-on-click="() => this.goToStep('preview')">
                            <i class="fa fa-eye"></i>
                            <span>Preview Results</span>
                        </div>
                        <div t-att-class="state.currentStep === 'execution' ? 'step-pill active' : 'step-pill'"
                             t-on-click="() => this.goToStep('execution')">
                            <i class="fa fa-play"></i>
                            <span>Execute</span>
                        </div>
                        <div t-att-class="state.currentStep === 'batch_management' ? 'step-pill active' : 'step-pill'"
                             t-on-click="() => this.goToStep('batch_management')">
                            <i class="fa fa-history"></i>
                            <span>History</span>
                        </div>
                    </div>
                </div>
                
                <!-- Dialog Content - USE REAL COMPONENTS -->
                <div class="dialog-content">
                    
                    <!-- Step 1: Target Selection - USE YOUR COMPONENT -->
                    <div t-if="state.currentStep === 'target_selection'" class="step-content">
                        <TargetSelectorComponent 
                            selectedMailingList="state.selectedMailingList"
                            t-on-sources-changed="onTargetSelected"/>
                    </div>

                    <!-- Step 1: Source Selection - USE YOUR COMPONENT -->
                    <div t-if="state.currentStep === 'source_selection'" class="step-content">
                        <SourceSelectorComponent 
                            selectedMailingList="state.selectedMailingList"
                            selectedSources="state.selectedSources.map(s => s.model_name)"
                            t-on-sources-changed="onSourcesChanged"/>
                    </div>
                    
                    <!-- Step 2: Filter Building - USE YOUR COMPONENT -->
                    <div t-if="state.currentStep === 'filter_building'" class="step-content">
                        <FilterBuilderComponent 
                            selectedSources="state.selectedSources"
                            filterCriteria="state.filterCriteria"
                            t-on-filters-changed="onFiltersChanged"/>
                    </div>
                    
                    <!-- Step 3: Preview Results - USE YOUR COMPONENT -->
                    <div t-if="state.currentStep === 'preview'" class="step-content">
                        <PreviewResultsComponent 
                            selectedMailingList="state.selectedMailingList"
                            selectedSources="state.selectedSources"
                            filterCriteria="state.filterCriteria"
                            t-on-preview-ready="onPreviewReady"
                            t-on-execute-update="onExecuteUpdate"/>
                    </div>
                    
                    <!-- Step 4: Execution - USE YOUR COMPONENT -->
                    <div t-if="state.currentStep === 'execution'" class="step-content">
                        <ExecutionComponent 
                            selectedMailingList="state.selectedMailingList"
                            selectedSources="state.selectedSources"
                            filterCriteria="state.filterCriteria"
                            t-on-operation-completed="onOperationCompleted"
                            t-on-operation-error="onOperationError"
                            t-on-operation-cancelled="onOperationCancelled"/>
                    </div>
                    
                </div>
                
                <!-- Dialog Footer -->
                <div class="dialog-footer">
                    <div class="footer-info">
                        <!-- <span>Step <t t-esc="getCurrentStepNumber()"/> of 5</span> -->
                    </div>
                    <div class="footer-actions">
                        <button class="mlu-btn mlu-btn-secondary"
                                t-on-click="closeUpdater">
                            <i class="fa fa-times"></i>
                            Exit
                        </button>

                        <button t-if="state.currentStep !== 'target_selection'" 
                                class="mlu-btn mlu-btn-secondary" 
                                t-on-click="previousStep">
                            <i class="fa fa-arrow-left"></i>
                            Previous
                        </button>
                        
                        <button t-if="state.currentStep !== 'batch_management'" 
                                class="mlu-btn mlu-btn-primary" 
                                t-on-click="nextStep">
                            Next
                            <i class="fa fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>