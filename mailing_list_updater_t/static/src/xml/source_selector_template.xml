<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="mailing_list_updater_t.SourceSelectorTemplate" owl="1">
        <div class="source-selector">
            

            <!-- ========================================= -->
            <!-- CONTACT SOURCE SELECTION (ORIGINAL) -->
            <!-- ========================================= -->
            <div class="source-selection-section">
                <div class="content-header">
                    <h2>
                        <i class="fa fa-database"></i>
                        Select Contact Sources
                    </h2>
                    <p>Choose which contact sources to import from</p>
                </div>
                
                <!-- Source Loading State -->
                <div t-if="state.isLoading" class="loading-container">
                    <div class="loading-spinner"></div>
                    <p>Loading contact sources...</p>
                </div>
                
                <!-- Source Selection Summary -->
                <div t-if="state.selectedSources.length &gt; 0" class="selection-summary">
                    <div class="mlu-alert mlu-alert-success">
                        <i class="fa fa-check-circle"></i>
                        <span t-esc="state.selectedSources.length"/> source(s) selected • Ready to proceed
                    </div>
                </div>
                
                <!-- Source Cards -->
                <div t-if="!state.isLoading" class="source-cards">
                    <div t-foreach="state.filteredSources" 
                         t-as="source" 
                         t-key="source.model_name"
                         t-att-class="getSourceItemClass(source)"
                         t-att-data-model="source.model_name"
                         t-on-click="onSourceToggle">
                        
                        <!-- Badges -->
                        <!-- <div t-if="source.recommended || isSourceSelected(source.model_name)" 
                             class="card-badges">
                            <span t-if="source.recommended" 
                                  class="badge badge-recommended">
                                <i class="fa fa-star"></i>
                                RECOMMENDED
                            </span>
                            <span t-if="isSourceSelected(source.model_name)"
                                  class="badge badge-selected">
                                <i class="fa fa-check"></i>
                                SELECTED
                            </span>
                        </div> -->
                        
                        <!-- Card Header -->
                        <div class="card-header">
                            <div t-att-class="'card-icon ' + source.model_name.replace('.', '-') + '-icon'">
                                <i t-att-class="source.icon || 'fa fa-users'"></i>
                            </div>
                            <h3 t-esc="source.name"></h3>
                            <div class="selection-check">
                                <i t-if="isSourceSelected(source.model_name)" 
                                   class="fa fa-check-circle"></i>
                                <i t-else="" 
                                   class="fa fa-circle-o"></i>
                            </div>
                        </div>
                        
                        <!-- Card Description -->
                        <p class="card-description" t-esc="source.description"></p>
                        
                        <!-- Card Stats -->
                        <div class="card-stats">
                            <!-- <span class="stat-item">
                                <i class="fa fa-users"></i>
                                <span t-esc="source.estimated_count"/> contacts
                            </span>
                            <button class="btn-details" 
                                    t-att-data-model="source.model_name"
                                    t-on-click.stop="toggleSourceDetails">
                                <i t-att-class="state.showSourceDetails[source.model_name] ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"></i>
                                <span t-if="state.showSourceDetails[source.model_name]">Hide Details</span>
                                <span t-else="">Show Details</span>
                            </button> -->
                        </div>
                        
                        <!-- Expandable Details -->
                        <!-- <div t-if="state.showSourceDetails[source.model_name]" class="card-details">
                            <div class="details-content">
                                <div class="detail-item">
                                    <strong>Company:</strong> <span t-esc="state.currentCompany.name"/>
                                </div>
                                
                                <div class="detail-item">
                                    <strong>Counts:</strong> 
                                    <span t-esc="state.companyRecordCounts[source.model_name] || 'Loading...'"/>
                                </div>
                            </div>
                        </div> -->
                    </div>
                </div>
                
                <!-- Source Empty State -->
                <div t-if="!state.isLoading and state.filteredSources.length === 0" class="empty-state">
                    <div class="empty-content">
                        <i class="fa fa-database fa-3x"></i>
                        <h3>No contact sources available</h3>
                        <p>Check if contact sources are properly configured in the system.</p>
                    </div>
                </div>
            </div>

            <!-- Overall Validation Summary -->
            <div class="overall-validation">
                
                <div t-if="state.selectedSources.length === 0" 
                     class="mlu-alert mlu-alert-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    Please select at least one contact source
                </div>
            </div>
        </div>
    </t>
</templates>