<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Statement Report Template with Static Data -->
    <template id="partner_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <!-- Custom CSS Styles -->
                        <style>
                            .statement-header {
                                background: linear-gradient(135deg, #1e3a8a, #3b82f6);
                                color: white;
                                padding: 20px;
                                text-align: center;
                                margin-bottom: 20px;
                                border-radius: 8px;
                            }
                            .section-header {
                                background: linear-gradient(90deg, #374151, #6b7280);
                                color: white;
                                padding: 10px 15px;
                                font-weight: bold;
                                border-radius: 5px 5px 0 0;
                            }
                            .statement-table {
                                font-size: 11px;
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 20px;
                            }
                            .statement-table th, .statement-table td {
                                border: 1px solid #dee2e6;
                                padding: 6px 8px;
                                text-align: left;
                            }
                            .statement-table thead th {
                                background-color: #495057;
                                color: white;
                                font-weight: bold;
                                text-align: center;
                                font-size: 10px;
                            }
                            .products-header {
                                background-color: #e9ecef;
                                font-weight: bold;
                                font-style: italic;
                            }
                            .product-row {
                                background-color: #f8f9fa;
                            }
                            .payment-header {
                                background-color: #d1ecf1;
                                color: #0c5460;
                                font-weight: bold;
                            }
                            .payment-row {
                                background-color: #d4edda;
                            }
                            .unpaid-header {
                                background-color: #fff3cd;
                                color: #856404;
                                font-weight: bold;
                            }
                            .unpaid-row {
                                background-color: #ffeeba;
                            }
                            .text-right {
                                text-align: right;
                            }
                            .text-center {
                                text-align: center;
                            }
                            .font-weight-bold {
                                font-weight: bold;
                            }
                            .text-danger {
                                color: #dc3545;
                            }
                            .text-success {
                                color: #28a745;
                            }
                            .summary-table {
                                margin-top: 30px;
                                background-color: #f8f9fa;
                            }
                            .summary-table th {
                                background: linear-gradient(90deg, #1e40af, #3b82f6);
                                color: white;
                            }
                            .currency {
                                font-family: monospace;
                            }
                        </style>

                        <!-- Report Header -->
                        <div class="statement-header">
                            <h2><t t-esc="company.name"/></h2>
                            <h4>PARTNER STATEMENT - DETAILED ANALYSIS</h4>
                        </div>

                        <!-- Partner Information Section -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr><td><strong>Partner:</strong></td><td><t t-esc="partner.name"/></td></tr>
                                    <tr><td><strong>Partner Code:</strong></td><td><t t-esc="partner.ref or 'P001'"/></td></tr>
                                    <tr><td><strong>Generated On:</strong></td><td><t t-esc="now"/></td></tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr><td><strong>Total Orders:</strong></td><td>3</td></tr>
                                    <tr><td><strong>Total Invoices:</strong></td><td>4</td></tr>
                                    <tr><td><strong>Total Payments:</strong></td><td>2</td></tr>
                                </table>
                            </div>
                        </div>

                        <!-- Section 1: Uninvoiced Products -->
                        <div class="statement-section mb-4">
                            <div class="section-header">
                                UNINVOICED PRODUCTS - SO001
                            </div>

                            <table class="statement-table">
                                <thead>
                                    <tr>
                                        <th style="width: 8%;">Date</th>
                                        <th style="width: 12%;">Reference</th>
                                        <th style="width: 15%;">Description</th>
                                        <th style="width: 8%;">Type</th>
                                        <th style="width: 15%;">Product</th>
                                        <th style="width: 7%;">Qty</th>
                                        <th style="width: 8%;">Unit Price</th>
                                        <th style="width: 8%;">Subtotal</th>
                                        <th style="width: 7%;">Tax</th>
                                        <th style="width: 8%;">Debit</th>
                                        <th style="width: 8%;">Credit</th>
                                        <th style="width: 8%;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="products-header">
                                        <td colspan="12" class="font-weight-bold">SO001 | State: sale | Total: 2,500.00</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>-</td>
                                        <td>SO001</td>
                                        <td>Product Sale</td>
                                        <td class="text-center">TO INVOICE</td>
                                        <td>Laptop Dell XPS</td>
                                        <td class="text-right">5.00</td>
                                        <td class="text-right currency">400.00</td>
                                        <td class="text-right currency">2,000.00</td>
                                        <td class="text-right currency">200.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>-</td>
                                        <td>SO001</td>
                                        <td>Product Sale</td>
                                        <td class="text-center">TO INVOICE</td>
                                        <td>Mouse Wireless</td>
                                        <td class="text-right">10.00</td>
                                        <td class="text-right currency">25.00</td>
                                        <td class="text-right currency">250.00</td>
                                        <td class="text-right currency">50.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Section 2: Fully Invoiced and Paid -->
                        <div class="statement-section mb-4">
                            <div class="section-header">
                                FULLY INVOICED &amp; PAID - SO002
                            </div>

                            <table class="statement-table">
                                <thead>
                                    <tr>
                                        <th style="width: 8%;">Date</th>
                                        <th style="width: 12%;">Reference</th>
                                        <th style="width: 15%;">Description</th>
                                        <th style="width: 8%;">Type</th>
                                        <th style="width: 15%;">Product</th>
                                        <th style="width: 7%;">Qty</th>
                                        <th style="width: 8%;">Unit Price</th>
                                        <th style="width: 8%;">Subtotal</th>
                                        <th style="width: 7%;">Tax</th>
                                        <th style="width: 8%;">Debit</th>
                                        <th style="width: 8%;">Credit</th>
                                        <th style="width: 8%;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="products-header">
                                        <td colspan="12" class="font-weight-bold">INV002 | State: posted | Total: 3,600.00</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>2025-08-04</td>
                                        <td>INV002</td>
                                        <td>Product Sale</td>
                                        <td class="text-center">INVOICED</td>
                                        <td>Monitor 24"</td>
                                        <td class="text-right">3.00</td>
                                        <td class="text-right currency">1,000.00</td>
                                        <td class="text-right currency">3,000.00</td>
                                        <td class="text-right currency">300.00</td>
                                        <td class="text-right currency">3,300.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>2025-08-04</td>
                                        <td>INV002</td>
                                        <td>Product Sale</td>
                                        <td class="text-center">INVOICED</td>
                                        <td>Keyboard Mechanical</td>
                                        <td class="text-right">2.00</td>
                                        <td class="text-right currency">125.00</td>
                                        <td class="text-right currency">250.00</td>
                                        <td class="text-right currency">50.00</td>
                                        <td class="text-right currency">300.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    
                                    <!-- Payments Section -->
                                    <tr class="payment-header">
                                        <td colspan="12" class="font-weight-bold">PAYMENTS RECEIVED</td>
                                    </tr>
                                    <tr class="payment-row">
                                        <td>2025-08-08</td>
                                        <td>BNK001</td>
                                        <td>Payment Received</td>
                                        <td class="text-center">PAYMENT</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right currency text-success font-weight-bold">3,600.00</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Section 3: Invoiced but Unpaid -->
                        <div class="statement-section mb-4">
                            <div class="section-header">
                                INVOICED BUT UNPAID - SO003
                            </div>

                            <table class="statement-table">
                                <thead>
                                    <tr>
                                        <th style="width: 8%;">Date</th>
                                        <th style="width: 12%;">Reference</th>
                                        <th style="width: 15%;">Description</th>
                                        <th style="width: 8%;">Type</th>
                                        <th style="width: 15%;">Product</th>
                                        <th style="width: 7%;">Qty</th>
                                        <th style="width: 8%;">Unit Price</th>
                                        <th style="width: 8%;">Subtotal</th>
                                        <th style="width: 7%;">Tax</th>
                                        <th style="width: 8%;">Debit</th>
                                        <th style="width: 8%;">Credit</th>
                                        <th style="width: 8%;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="products-header">
                                        <td colspan="12" class="font-weight-bold">INV003 | State: posted | Total: 1,800.00</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>2025-08-12</td>
                                        <td>INV003</td>
                                        <td>Product Sale</td>
                                        <td class="text-center">INVOICED</td>
                                        <td>Printer HP LaserJet</td>
                                        <td class="text-right">1.00</td>
                                        <td class="text-right currency">1,500.00</td>
                                        <td class="text-right currency">1,500.00</td>
                                        <td class="text-right currency">150.00</td>
                                        <td class="text-right currency">1,650.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>2025-08-12</td>
                                        <td>INV003</td>
                                        <td>Product Sale</td>
                                        <td class="text-center">INVOICED</td>
                                        <td>USB Cable</td>
                                        <td class="text-right">5.00</td>
                                        <td class="text-right currency">25.00</td>
                                        <td class="text-right currency">125.00</td>
                                        <td class="text-right currency">25.00</td>
                                        <td class="text-right currency">150.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    
                                    <!-- Unpaid Invoices Section -->
                                    <tr class="unpaid-header">
                                        <td colspan="12" class="font-weight-bold">UNPAID INVOICES</td>
                                    </tr>
                                    <tr class="unpaid-row">
                                        <td>2025-09-11</td>
                                        <td>INV003</td>
                                        <td>Outstanding Invoice</td>
                                        <td class="text-center">OVERDUE</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td class="text-right currency text-danger font-weight-bold">1,800.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right currency text-danger font-weight-bold">1,800.00</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Section 4: Manual Invoices -->
                        <div class="statement-section mb-4">
                            <div class="section-header">
                                MANUAL INVOICES
                            </div>

                            <table class="statement-table">
                                <thead>
                                    <tr>
                                        <th style="width: 8%;">Date</th>
                                        <th style="width: 12%;">Reference</th>
                                        <th style="width: 15%;">Description</th>
                                        <th style="width: 8%;">Type</th>
                                        <th style="width: 15%;">Product</th>
                                        <th style="width: 7%;">Qty</th>
                                        <th style="width: 8%;">Unit Price</th>
                                        <th style="width: 8%;">Subtotal</th>
                                        <th style="width: 7%;">Tax</th>
                                        <th style="width: 8%;">Debit</th>
                                        <th style="width: 8%;">Credit</th>
                                        <th style="width: 8%;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="products-header">
                                        <td colspan="12" class="font-weight-bold">MANUAL001 | State: posted | Total: 500.00</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>2025-08-15</td>
                                        <td>MANUAL001</td>
                                        <td>Direct Service</td>
                                        <td class="text-center">MANUAL</td>
                                        <td>Consulting Service</td>
                                        <td class="text-right">5.00</td>
                                        <td class="text-right currency">80.00</td>
                                        <td class="text-right currency">400.00</td>
                                        <td class="text-right currency">40.00</td>
                                        <td class="text-right currency">440.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    <tr class="product-row">
                                        <td>2025-08-15</td>
                                        <td>MANUAL001</td>
                                        <td>Direct Service</td>
                                        <td class="text-center">MANUAL</td>
                                        <td>Setup Fee</td>
                                        <td class="text-right">1.00</td>
                                        <td class="text-right currency">50.00</td>
                                        <td class="text-right currency">50.00</td>
                                        <td class="text-right currency">10.00</td>
                                        <td class="text-right currency">60.00</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                    
                                    <!-- Payments Section -->
                                    <tr class="payment-header">
                                        <td colspan="12" class="font-weight-bold">PAYMENTS RECEIVED</td>
                                    </tr>
                                    <tr class="payment-row">
                                        <td>2025-08-20</td>
                                        <td>CHK001</td>
                                        <td>Payment Received</td>
                                        <td class="text-center">PAYMENT</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td class="text-right">-</td>
                                        <td class="text-right currency text-success font-weight-bold">500.00</td>
                                        <td class="text-right">-</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Executive Summary -->
                        <div class="summary-section">
                            <table class="table table-bordered summary-table">
                                <thead>
                                    <tr>
                                        <th colspan="4" class="text-center">EXECUTIVE SUMMARY</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="font-weight-bold">Total Active Orders:</td>
                                        <td>3</td>
                                        <td class="font-weight-bold">Uninvoiced Products:</td>
                                        <td><span class="badge badge-warning">Yes - Action Required</span></td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Total Invoices:</td>
                                        <td>4</td>
                                        <td class="font-weight-bold">Outstanding Invoices:</td>
                                        <td><span class="badge badge-danger">1 Unpaid</span></td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Total Payment Transactions:</td>
                                        <td>2</td>
                                        <td class="font-weight-bold">Manual Invoices:</td>
                                        <td><span class="badge badge-info">Yes</span></td>
                                    </tr>
                                    <tr class="table-primary">
                                        <td class="font-weight-bold">Overall Status:</td>
                                        <td colspan="3" class="text-center">
                                            <span class="badge badge-warning" style="font-size: 14px;">ATTENTION REQUIRED</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Report Footer -->
                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <small class="text-muted">
                                    Report generated on <t t-esc="now"/> | 
                                    <t t-esc="company.name"/>
                                </small>
                            </div>
                        </div>

                    </div>
