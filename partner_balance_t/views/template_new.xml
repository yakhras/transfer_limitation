                                                <span class="badge badge-warning" style="font-size: 14px;">⚠️ ATTENTION REQUIRED</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge badge-success" style="font-size: 14px;">✅ ALL CLEAR</span>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div> -->

                        <!-- Report Footer -->
                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <small class="text-muted">
                                    Report generated on <t t-esc="now"/> |
                                    <t t-esc="company.name"/>
                                </small>
                            </div>
                        </div>

                    </div>
            </t>
        </t>
    </template>
</odoo>