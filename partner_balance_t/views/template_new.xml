                                        <td>
                                            <t t-if="statement_data.get('summary', {}).get('has_unpaid_invoices')">
                                                <span class="badge badge-danger">
                                                    <t t-esc="statement_data.get('summary', {}).get('total_unpaid_invoices', 0)"/> Unpaid
                                                </span>
                                            </t>
