                                        <td>
                                            <t t-if="statement_data.get('summary', {}).get('has_uninvoiced_products')">
                                                <span class="badge badge-warning">Yes - Action Required</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge badge-success">No</span>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Total Invoices:</td>
                                        <td><t t-esc="statement_data.get('summary', {}).get('total_invoices', 0)"/></td>
