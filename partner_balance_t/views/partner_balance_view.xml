<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>
        <!-- Report Action Definition -->
        <record id="action_partner_statement_report" model="ir.actions.report">
            <field name="name">Partner Statement</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">partner_balance_t.partner_statement_template</field>
            <field name="report_file">partner_balance_t.partner_statement_template</field>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Partner Statement - %s' % (object.name)</field>
        </record>

        <record id="view_partner_form_inherit_custom_button" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.custom.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="l10n_tr_base_ubl.view_partner_form_esolutions"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_registered_user']" position="after">
                    <button name="action_view_move_line_report"
                    type="object"
                    string="View Report"
                    class="btn-primary" />

                    <button name="%(partner_balance_t.action_partner_statement_report)d"
                        string="View Statement"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-file-text-o"/>
                </xpath>
            </field>
        </record>


        <!-- Tree View for Account Move Line Normal Report -->
        <record id="view_account_move_line_report_tree" model="ir.ui.view">
            <field name="name">account.move.line.report.tree</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Partner Ledger" create="false" delete="false" edit="false" js_class="partner_balance_t">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <!-- <field name= "product_id"/>
                    <field name="quantity"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal"/> -->
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="cumulated_balance" string="Balance"/>
                    <field name="initial_balance" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="amount_currency" string="Origin Amount"/>
                    <field name="currency_id" invisible="1"/>

                </tree>
            </field>
        </record>


        <!-- Tree View for Account Move Line Currency-based Report -->
        <record id="view_account_move_line_report_currency_tree" model="ir.ui.view">
            <field name="name">account.move.line.report.currency.tree</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Currency-based Partner Ledger" create="false" delete="false" edit="false" js_class="partner_balance_t">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <!-- <field name= "product_id"/>
                    <field name="quantity"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal"/> -->
                    <field name="debit_amount" />
                    <field name="credit_amount" />
                    <field name="balance_amount"/>
                    <field name="currency_id"/>
                </tree>
            </field>
        </record>


        <!-- Tree View for Account Move Line USD Report -->
        <record id="view_account_move_line_report_usd_tree" model="ir.ui.view">
            <field name="name">account.move.line.report.usd.tree</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Partner Ledger" create="false" delete="false" edit="false">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <!-- <field name= "product_id"/>
                    <field name="quantity"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal"/> -->
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="usd_rate_display"/>
                    <field name="usd_value"/>
                    <field name="cumulated_usd_value"/>
                </tree>
            </field>
        </record>

        <!-- Tree View for Account Move Line Partner Currency Report -->
        <record id="view_account_move_line_report_partner_currency" model="ir.ui.view">
            <field name="name">account.move.line.report.partner.currency</field>
            <field name="model">account.move.line.report</field>
            <field name="arch" type="xml">
                <tree string="Partner Ledger" create="false" delete="false" edit="false" js_class="partner_balance_t">
                    <field name="date"/>
                    <field name="type"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <!-- <field name= "product_id"/>
                    <field name="quantity"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal"/> -->
                    <field name="partner_currency_debit"/>
                    <field name="partner_currency_credit"/>
                    <field name="cumulated_partner_currency_value"/>
                    <field name="amount_currency" string="Origin Amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="initial_balance_partner_currency" invisible="1"/>
                    <field name="partner_currency_id" invisible="1"/>
                </tree>
            </field>
        </record>


        <!-- Action for Currency-based Report -->
        <record id="action_partner_move_line_currency" model="ir.actions.act_window">
            <field name="name">Statement Currency-based of Account</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move.line.report</field>
            <field name="view_mode">tree</field>
            <!-- Bind the specific tree view; fallback if missing is allowed -->
            <field name="view_id" ref="partner_balance_t.view_account_move_line_report_currency_tree"/>
            <field name="views" eval="[(ref('partner_balance_t.view_account_move_line_report_currency_tree'), 'tree')]"/>
            <field name="target">current</field>

            <!-- Filter by the partner provided from JS via active_id -->
            <field name="domain">[]</field>

            <!-- Server-side defaults; JS can add to context but shouldn’t need to replace -->
            <field name="context">
                {
                'group_by': 'currency_id',
                'search_default_group_by_account': 1
                }
            </field>
        </record>


        <!-- Action for Partner Currency Report -->
        <record id="action_partner_move_line_partner_currency" model="ir.actions.act_window">
            <field name="name">Statement in Partner Currency</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move.line.report</field>
            <field name="view_mode">tree</field>
            <!-- Bind the specific tree view; fallback if missing is allowed -->
            <field name="view_id" ref="partner_balance_t.view_account_move_line_report_partner_currency"/>
            <field name="views" eval="[(ref('partner_balance_t.view_account_move_line_report_partner_currency'), 'tree')]"/>
            <field name="target">current</field>

            <!-- Filter by the partner provided from JS via active_id -->
            <field name="domain">[]</field>

            <!-- Server-side defaults; JS can add to context but shouldn’t need to replace -->
            <field name="context">
                {
                'search_default_group_by_account': 1
                }
            </field>
        </record>

        
        <record id="view_account_partial_reconcile_tree" model="ir.ui.view">
            <field name="name">account.partial.reconcile.tree</field>
            <field name="model">account.partial.reconcile</field>
            <field name="arch" type="xml">
                <tree string="Partial Reconciliations" 
                    decoration-muted="full_reconcile_id" 
                    decoration-info="not full_reconcile_id">
                    
                    <!-- Reference Information -->
                    <field name="id" string="Reconcile ID"/>
                    <field name="max_date" string="Date"/>
                    
                    <!-- Debit Move Information -->
                    <field name="debit_move_id" string="Debit Entry"/>
                    <field name="debit_currency_id" string="Debit Currency" optional="hide"/>
                    <field name="debit_amount_currency" 
                        string="Debit Amount" 
                        sum="Total Debit Amount"
                        widget="monetary" 
                        options="{'currency_field': 'debit_currency_id'}"/>
                    
                    <!-- Credit Move Information -->
                    <field name="credit_move_id" string="Credit Entry"/>
                    <field name="credit_currency_id" string="Credit Currency" optional="hide"/>
                    <field name="credit_amount_currency" 
                        string="Credit Amount" 
                        sum="Total Credit Amount"
                        widget="monetary" 
                        options="{'currency_field': 'credit_currency_id'}"/>
                    
                    <!-- Company Currency Amount -->
                    <field name="amount" 
                        string="Company Amount" 
                        sum="Total Company Amount"
                        widget="monetary" 
                        options="{'currency_field': 'company_currency_id'}"/>
                    <field name="company_currency_id" string="Company Currency" optional="hide"/>
                    
                    <!-- Reconciliation Status -->
                    <field name="full_reconcile_id" 
                        string="Full Reconcile" 
                        optional="show"
                        widget="many2one_tags"/>
                    
                    <!-- Company -->
                    <field name="company_id" 
                        string="Company" 
                        optional="hide"
                        groups="base.group_multi_company"/>
                    
                    <!-- Hidden fields for computations -->
                    <field name="debit_currency_id" invisible="1"/>
                    <field name="credit_currency_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

        

        <!-- Action for Partial Reconciliations -->
        <record id="action_account_partial_reconcile" model="ir.actions.act_window">
            <field name="name">Partial Reconciliations</field>
            <field name="res_model">account.partial.reconcile</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_account_partial_reconcile_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No partial reconciliations found!
                </p>
                <p>
                    Partial reconciliations show the matching between debit and credit journal entries.
                    They are created automatically when payments are matched with invoices.
                </p>
            </field>
        </record>

        <!-- Menu Item (optional) -->
        <menuitem id="menu_account_partial_reconcile"
                name="Partial Reconciliations" 
                parent="account.menu_finance_configuration"
                action="action_account_partial_reconcile"
                sequence="50"
                groups="account.group_account_user"/>

    </data>
</odoo>
