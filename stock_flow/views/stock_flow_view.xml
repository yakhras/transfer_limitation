<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_stock_move_line_report_tree" model="ir.ui.view">
            <field name="name">stock.move.line.report.tree</field>
            <field name="model">stock.move.line.report</field>
            <field name="arch" type="xml">
                <tree default_order="date asc">
                    <field name="product_id"/>
                    <field name="date"/>
                    <field name="operation"/>
                    <field name="location_id"/>
                    <field name="location_dest_id"/>
                    <field name="qty_done" string="Quantity"/>
                    <field name="signed_qty_done" string="Signed Quantity"/>
                    <field name="warehouse_id"/>
                    <field name="direction"/>
                    <field name="stock_balance"/>
                </tree>
            </field>
        </record>


        <record id="action_stock_move_line_report" model="ir.actions.act_window">
            <field name="name">Stock Move Report</field>
            <field name="res_model">stock.move.line.report</field>
            <field name="view_mode">tree</field>
        </record>


        <menuitem id="menu_stock_move_line_report"
                    name="Stock Flow"
                    parent="stock.menu_warehouse_report"
                    action="action_stock_move_line_report"
                    sequence="160"/>


        
    </data>
</odoo>
