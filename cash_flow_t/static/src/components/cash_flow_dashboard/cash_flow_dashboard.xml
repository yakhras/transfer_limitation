<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cash_flow_t.CashFlowDashboard" owl="1">
        <!-- UPDATED: Added cash-flow-dashboard class for SCSS scoping -->
        <div class="cash-flow-dashboard vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-12">
                    <!-- Header with Date Filtering -->
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between flex-wrap">
                                    <div class="d-flex align-items-center mb-2 mb-md-0">
                                        <h1 class="text-primary fw-bold mb-0 me-3">Cash Flow Dashboard</h1>
                                        <div t-if="state.lastUpdated" class="text-muted small">
                                            <i class="fa fa-clock-o me-1"></i>
                                            Last updated: <span t-esc="state.lastUpdated"/>
                                        </div>
                                    </div>

                                    <!-- Clean Currency Selection Section -->
                                    <div class="d-flex justify-content-center mb-3">
                                        <div class="currency-selection-container">
                                            <!-- Currency Selection Group -->
                                            <div class="currency-group">
                                                <!-- Currency Options -->
                                                <t t-foreach="state.availableCurrencies" t-as="currency" t-key="currency.code">
                                                    <div class="currency-option" 
                                                        t-att-class="getCurrencyOptionClass(currency.code)"
                                                        t-on-click="() => toggleCurrency(currency.code)">
                                                        <span t-esc="currency.code"/>
                                                        <i t-if="isSelectedCurrency(currency.code)" 
                                                        class="fa fa-check currency-check"></i>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Date Filter Controls -->
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="text-muted small">Period:</span>
                                        <select class="form-select form-select-sm cash-flow-period-selector" 
                                                style="width: auto; min-width: 150px;"
                                                t-model="state.period" 
                                                t-on-change="onPeriodChange">
                                            <t t-foreach="periodOptions" t-as="option" t-key="option.value">
                                                <option t-att-value="option.value" t-esc="option.label"/>
                                            </t>
                                        </select>
                                        
                                        <!-- Refresh Button -->
                                        <button class="btn btn-outline-primary btn-sm cash-flow-refresh-btn" 
                                                t-on-click="refreshData" 
                                                t-att-disabled="state.loading">
                                            <i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''}"></i>
                                            <span class="d-none d-md-inline ms-1">Refresh</span>
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Custom Date Range Inputs -->
                                <div t-if="state.showCustomDateInputs" class="row mt-3 pt-3 border-top">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">From Date</label>
                                        <input type="date" 
                                               class="form-control form-control-sm cash-flow-date-input" 
                                               t-model="state.customDateFrom"
                                               t-on-change="onCustomDateChange"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">To Date</label>
                                        <input type="date" 
                                               class="form-control form-control-sm cash-flow-date-input" 
                                               t-model="state.customDateTo"
                                               t-on-change="onCustomDateChange"/>
                                    </div>
                                    <div class="col-md-6 d-flex align-items-end">
                                        <small class="text-muted">
                                            <i class="fa fa-info-circle me-1"></i>
                                            Select both dates to apply custom filter
                                        </small>
                                    </div>
                                </div>

                                
                                
                                <!-- Filter Status & Summary -->
                                <div t-if="state.period !== 'all' or state.accounts.length > 0" class="row mt-2">
                                    <div class="col-md-6">
                                        <div t-if="state.period !== 'all'">
                                            <span class="badge bg-info">
                                                <i class="fa fa-filter me-1"></i>
                                                <span t-esc="getPeriodLabel()"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <div t-if="state.accounts.length > 0" class="text-muted small">
                                            <span class="me-3">
                                                <i class="fa fa-bank me-1"></i>
                                                <span t-esc="state.accounts.length"/> account groups
                                            </span>
                                            <span class="me-3 text-success">
                                                <i class="fa fa-arrow-up me-1"></i>
                                                <span t-esc="state.positiveAccounts"/> positive
                                            </span>
                                            <span class="text-danger">
                                                <i class="fa fa-arrow-down me-1"></i>
                                                <span t-esc="state.negativeAccounts"/> negative
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div t-if="state.loading" class="text-center p-5">
                        <div class="row">
                            <div class="col-12">
                                <div class="card shadow-sm">
                                    <div class="card-body p-5">
                                        <div class="spinner-border text-primary mb-3" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <h5 class="text-primary">Loading Dashboard Data</h5>
                                        <p class="text-muted mb-0">
                                            Fetching cash flow information
                                            <span t-if="state.period !== 'all'">for <span t-esc="getPeriodLabel()"/></span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Error State -->
                    <div t-if="state.error and !state.loading" class="row">
                        <div class="col-12">
                            <div class="alert alert-danger m-2" role="alert">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="flex-grow-1">
                                        <h5 class="alert-heading mb-2">
                                            <i class="fa fa-exclamation-triangle me-2"></i>
                                            Error Loading Dashboard
                                        </h5>
                                        <p class="mb-0" t-esc="state.error.message"/>
                                        <small class="text-muted">
                                            Try refreshing the data or check your configuration settings.
                                        </small>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button t-if="state.error.showRetry" 
                                                class="btn btn-outline-danger btn-sm" 
                                                t-on-click="refreshData">
                                            <i class="fa fa-refresh me-1"></i>Retry
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" 
                                                t-on-click="clearError">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dashboard Content -->
                    <div t-if="!state.loading and !state.error" class="dashboard-content">
                        <!-- Summary Cards -->
                        <div t-if="state.accounts.length > 0" class="row mb-3">
                            <div class="col-md-4 col-12 mb-2">
                                <div class="card bg-primary text-white h-100">
                                    <div class="card-body text-center">
                                        <h4 class="mb-1" t-esc="getFormattedTotalBalance()"/>
                                        <small>Total Balance</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-2">
                                <div class="card bg-success text-white h-100">
                                    <div class="card-body text-center">
                                        <h4 class="mb-1" t-esc="state.positiveAccounts"/>
                                        <small>Positive Accounts</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-2">
                                <div class="card bg-danger text-white h-100">
                                    <div class="card-body text-center">
                                        <h4 class="mb-1" t-esc="state.negativeAccounts"/>
                                        <small>Negative Accounts</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Account Cards -->
                        <div t-if="state.accounts.length > 0" class="row">
                            <div t-foreach="state.accounts" t-as="account" t-key="account.id" class="col-lg-6 col-12 mb-3">
                                <div class="card h-100 shadow-sm cursor-pointer cash-flow-hover-card"
                                     t-on-click="() => viewAccountDetails(account.account_codes)"
                                     t-attf-class="border-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">

                                    <div class="card-header">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title mb-1">
                                                    <strong t-esc="account.display_name || 'Unknown Account'"/>
                                                </h5>
                                                <small class="text-muted">
                                                    <span t-if="account.account_codes" t-esc="account.account_codes"/>
                                                    <span t-if="account.period_info and account.period_info.period_label">
                                                        • <span t-esc="account.period_info.period_label"/>
                                                    </span>
                                                </small>
                                            </div>
                                            <div>
                                                <span t-attf-class="badge bg-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">
                                                    <span t-if="account.balance_color === 'green'">
                                                        <i class="fa fa-arrow-up"></i> Positive
                                                    </span>
                                                    <span t-elif="account.balance_color === 'red'">
                                                        <i class="fa fa-arrow-down"></i> Negative
                                                    </span>
                                                    <span t-else="">
                                                        <i class="fa fa-minus"></i> Zero
                                                    </span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <!-- Balance Display Section -->
                                        <div class="text-center mb-3">
                                            <h3 class="mb-0"
                                                t-attf-class="text-#{account.balance_color === 'green' ? 'success' : (account.balance_color === 'red' ? 'danger' : 'info')}">
                                                <span t-esc="getFormattedBalance(account)"/>
                                            </h3>
                                            <small class="text-muted">
                                                <span t-if="state.period === 'all'">Current Balance</span>
                                                <span t-else="">Balance for Period</span>
                                            </small>
                                        </div>

                                        <!-- Chart Section -->
                                        <div class="chart-container" style="height: 140px; position: relative;">
                                            <BalanceChart 
                                                accountData="account" selectedCurrencies="state.selectedCurrencies"/>
                                        </div>
                                        
                                        <!-- Individual Accounts Summary -->
                                        <div t-if="account.individual_balances" class="mt-3 pt-3 border-top">
                                            <small class="text-muted">
                                                <i class="fa fa-list me-1"></i>
                                                <span t-esc="getIndividualAccountCount(account)"/> individual accounts
                                            </small>
                                        </div>
                                    </div>
                                    
                                    <!-- Card Footer -->
                                    <div class="card-footer text-muted small text-center">
                                        <i class="fa fa-mouse-pointer me-1"></i>
                                        Click for detailed breakdown
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Empty State -->
                        <div t-if="state.accounts.length === 0" class="text-center p-5">
                            <div class="card shadow-sm">
                                <div class="card-body p-5">
                                    <i class="fa fa-info-circle fa-3x text-info mb-3"></i>
                                    <h4 class="text-info">No Cash Flow Data Found</h4>
                                    <div class="mb-4">
                                        <p t-if="state.period !== 'all'" class="text-muted">
                                            No transactions found for <strong t-esc="getPeriodLabel()"/>.<br/>
                                            Try expanding your date range or check if transactions exist for this period.
                                        </p>
                                        <p t-else="" class="text-muted">
                                            No cash flow accounts have been configured yet.<br/>
                                            Please configure your cash flow accounts in the settings to see data here.
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-center gap-3">
                                        <button t-if="state.period !== 'all'" 
                                                class="btn btn-outline-primary"
                                                t-on-click="() => { this.state.period = 'all'; this.state.showCustomDateInputs = false; this.onPeriodChange(); }">
                                            <i class="fa fa-calendar me-1"></i>
                                            Show All Time
                                        </button>
                                        <button class="btn btn-primary" 
                                                t-on-click="refreshData">
                                            <i class="fa fa-refresh me-1"></i>
                                            Refresh Data
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    
</templates>