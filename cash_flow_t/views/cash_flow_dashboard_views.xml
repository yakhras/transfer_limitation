<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Kanban View for Cash Flow Dashboard - COMPLETE MULTIPLE ACCOUNTS SUPPORT -->
        <record id="view_cash_flow_dashboard_kanban" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.kanban</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard" create="false" edit="false" delete="false">
                    <field name="id"/>
                    <field name="company_id"/>
                    <field name="config_id"/>
                    <field name="account_codes"/>
                    <field name="account_names"/>
                    <field name="display_name"/>
                    <field name="current_balance"/>
                    <field name="balance_display"/>
                    <field name="balance_color"/>
                    <field name="currency_id"/>
                    <field name="kanban_dashboard_graph"/>
                    <field name="sequence"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click" 
                                 t-att-class="record.balance_color.raw_value == 'green' ? 'border-success' : (record.balance_color.raw_value == 'red' ? 'border-danger' : 'border-info')">
                                
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary">
                                            <strong t-esc="record.display_name.value"/>
                                        </div>
                                        <div class="text-muted small">
                                            <i class="fa fa-list-alt me-1"/>
                                            <t t-esc="record.account_codes.value"/>
                                        </div>
                                        <!-- Show company name in multi-company setup -->
                                        <div class="text-muted small" t-if="record.company_id.value" groups="base.group_multi_company">
                                            <i class="fa fa-building-o me-1"/> <t t-esc="record.company_id.value"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_card_content">
                                    <!-- Balance Display Section - Full Width Top -->
                                    <div class="row">
                                        <div class="col-12 text-center mb-3">
                                            <h3 class="mb-0" 
                                                t-att-class="record.balance_color.raw_value == 'green' ? 'text-success' : (record.balance_color.raw_value == 'red' ? 'text-danger' : 'text-info')">
                                                <t t-esc="record.balance_display.value"/>
                                            </h3>
                                            <small class="text-muted">
                                                <i class="fa fa-calculator me-1"/>
                                                Aggregated Balance
                                            </small>
                                        </div>
                                    </div>
                                    
                                    <!-- Chart Section - Full Width Bottom -->
                                    <div class="row">
                                        <div class="col-12">
                                            <field name="kanban_dashboard_graph" 
                                                   t-att-graph_type="'line'" 
                                                   widget="dashboard_graph"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                    <div class="row">
                                        <div class="col-6 o_kanban_card_manage_section o_kanban_manage_button_section">
                                            <a class="btn btn-primary btn-sm" name="action_view_account_moves" type="object">
                                                <i class="fa fa-list me-1"/>
                                                View Transactions
                                            </a>
                                        </div>
                                        <div class="col-6 o_kanban_card_manage_section o_kanban_manage_button_section">
                                            <button class="btn btn-secondary btn-sm" onclick="window.location.reload()">
                                                <i class="fa fa-refresh me-1"/>
                                                Refresh
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tree View for Cash Flow Dashboard - COMPLETE MULTIPLE ACCOUNTS SUPPORT -->
        <record id="view_cash_flow_dashboard_tree" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.tree</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <tree string="Cash Flow Account Groups" create="false" edit="false" delete="false" 
                      decoration-success="balance_color == 'green'" 
                      decoration-danger="balance_color == 'red'" 
                      decoration-info="balance_color == 'blue'">
                    <field name="sequence" widget="handle"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="display_name"/>
                    <field name="account_codes"/>
                    <field name="current_balance" sum="Total Balance"/>
                    <field name="balance_display"/>
                    <field name="balance_color" invisible="1"/>
                    <field name="currency_id"/>
                    <field name="config_id"/>
                    <field name="debug_usd_rate"/>
                    <field name="debug_rate_date"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Cash Flow Dashboard - COMPLETE WITH INDIVIDUAL BALANCES -->
        <record id="view_cash_flow_dashboard_form" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.form</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <form string="Cash Flow Account Group" create="false" edit="false" delete="false">
                    <header>
                        <button name="action_view_account_moves" type="object" string="View All Transactions" class="btn-primary"/>
                        <button name="action_view_debug_analysis" string="Debug Analysis" type="object" class="oe_highlight"/>
                        <button name="action_view_dashboard_tree" type="object" string="View Dashboard Tree" class="btn-secondary"/>
                        <button name="refresh_dashboard_from_config" type="object" string="Refresh Data" class="btn-secondary"/>
                    </header>
                    
                    <sheet>
                        <!-- Period Information Header -->
                        <div class="alert alert-info" style="margin-bottom: 20px;">
                            <div class="row">
                                <div class="col-md-8">
                                    <h4 class="alert-heading mb-1">
                                        <i class="fa fa-calendar text-primary me-2"/> 
                                        Multiple Accounts Dashboard
                                    </h4>
                                    <p class="mb-0">
                                        <strong>Period:</strong> <span id="period_label_display">All Time</span>
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <span class="badge bg-primary" style="font-size: 0.9em;">
                                        <i class="fa fa-group me-1"/>
                                        Account Group
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                            <h2 class="text-muted">
                                <i class="fa fa-list-alt me-2"/>
                                <field name="account_codes" readonly="1"/>
                            </h2>
                        </div>
                        
                        <group>
                            <group string="Account Group Information">
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                                <field name="config_id" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="sequence" readonly="1" string="Display Order"/>
                                <field name="debug_usd_rate"/>
                                <field name="debug_rate_date"/>
                            </group>
                            <group string="Aggregated Balance Information">
                                <field name="current_balance" readonly="1" string="Total Aggregated Balance" 
                                       decoration-success="current_balance > 0"
                                       decoration-danger="current_balance &lt; 0"/>
                                <field name="balance_display" readonly="1" string="Formatted Balance"/>
                                <field name="balance_color" readonly="1" widget="badge" 
                                       decoration-success="balance_color == 'green'"
                                       decoration-danger="balance_color == 'red'"
                                       decoration-info="balance_color == 'blue'"/>
                            </group>
                        </group>

                        <!-- Chart Visualization Section -->
                        <group string="Balance Trend Chart" col="1">
                            <field name="kanban_dashboard_graph" widget="dashboard_graph" nolabel="1"/>
                        </group>
                        <group string="Currency Debug Info" name="debug_info">
                            <field name="debug_currency_info" widget="text" readonly="1" 
                                options="{'no_resize': false}" 
                                style="font-family: monospace; font-size: 12px; height: 300px;"/>
                        </group>

                        <!-- Accounts Included Section - MULTIPLE ACCOUNTS DISPLAY -->
                        <group string="Accounts in This Group" col="1">
                            <div class="alert alert-secondary">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-info-circle text-info fa-2x me-3"/>
                                    <div>
                                        <p class="mb-1">
                                            <strong>Multiple Accounts Aggregation:</strong> This dashboard record combines data from multiple accounts.
                                        </p>
                                        <p class="mb-0 small text-muted">
                                            The balance shown above is the sum of all individual account balances below, filtered by the selected period.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <field name="account_ids" readonly="1" nolabel="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="user_type_id"/>
                                </tree>
                            </field>
                        </group>

                        <!-- Individual Account Balances Section - ENHANCED WITH JAVASCRIPT -->
                        <div class="oe_horizontal_separator">
                            <strong>
                                <i class="fa fa-line-chart me-2"/>
                                Individual Account Balances for Selected Period
                            </strong>
                        </div>
                        
                        <div class="o_group">
                            <div id="individual_balances_container">
                                <div class="alert alert-info" id="loading_balances">
                                    <i class="fa fa-spinner fa-spin me-2"/> 
                                    Loading individual account balances for selected period...
                                </div>
                            </div>
                        </div>

                        <!-- Period Summary Statistics -->
                        <div class="oe_horizontal_separator mt-4">
                            <strong>
                                <i class="fa fa-bar-chart me-2"/>
                                Period Summary Statistics
                            </strong>
                        </div>
                        
                        <div class="row" id="period_summary_section">
                            <div class="col-md-3 col-6 mb-3">
                                <div class="card bg-primary text-white text-center">
                                    <div class="card-body">
                                        <h5 class="card-title" id="total_balance_display">₺0</h5>
                                        <p class="card-text small">Total Aggregated</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <div class="card bg-info text-white text-center">
                                    <div class="card-body">
                                        <h5 class="card-title" id="account_count_display">0</h5>
                                        <p class="card-text small">Individual Accounts</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <div class="card bg-success text-white text-center">
                                    <div class="card-body">
                                        <h5 class="card-title" id="positive_accounts_display">0</h5>
                                        <p class="card-text small">Positive Balances</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <div class="card bg-danger text-white text-center">
                                    <div class="card-body">
                                        <h5 class="card-title" id="negative_accounts_display">0</h5>
                                        <p class="card-text small">Negative Balances</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information Section -->
                        <div class="oe_horizontal_separator mt-4">
                            <strong>
                                <i class="fa fa-info-circle me-2"/>
                                Additional Information
                            </strong>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h6 class="mb-0">Account Details</h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text small">
                                            <strong>Account Names:</strong><br/>
                                            <field name="account_names" readonly="1" nolabel="1"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h6 class="mb-0">Configuration</h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text small">
                                            <strong>Configuration Record:</strong><br/>
                                            <field name="config_id" readonly="1" nolabel="1"/>
                                        </p>
                                        <p class="card-text small">
                                            <strong>Display Order:</strong> <field name="sequence" readonly="1" nolabel="1"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </sheet>
                    
                    <!-- Enhanced JavaScript for Multiple Accounts Form View -->
                    <script type="text/javascript">
                        <![CDATA[
                        $(document).ready(function() {
                            console.log('Form view loading for multiple accounts dashboard...');
                            
                            // Get context information from URL parameters
                            var urlParams = new URLSearchParams(window.location.search);
                            var periodType = urlParams.get('period_type') || 'all';
                            var dateFrom = urlParams.get('date_from');
                            var dateTo = urlParams.get('date_to');
                            
                            console.log('Form context:', { periodType, dateFrom, dateTo });
                            
                            // Update period display
                            updatePeriodDisplay(periodType, dateFrom, dateTo);
                            
                            // Load and display individual balances
                            loadIndividualBalances();
                            
                            // Load period summary
                            loadPeriodSummary();
                        });
                        
                        function updatePeriodDisplay(periodType, dateFrom, dateTo) {
                            var periodLabel = formatPeriodLabel(periodType, dateFrom, dateTo);
                            $('#period_label_display').text(periodLabel);
                            
                            if (periodType !== 'all') {
                                $('.alert-info').removeClass('alert-info').addClass('alert-warning');
                                $('#period_label_display').parent().html(
                                    '<strong>Filtered Period:</strong> <span class="text-primary">' + periodLabel + '</span>'
                                );
                            }
                        }
                        
                        function formatPeriodLabel(periodType, dateFrom, dateTo) {
                            if (periodType === 'all') {
                                return 'All Time';
                            } else if (periodType === 'custom' && dateFrom && dateTo) {
                                return dateFrom + ' to ' + dateTo;
                            } else if (dateFrom && dateTo) {
                                try {
                                    var start = new Date(dateFrom).toLocaleDateString('en-US', { 
                                        month: 'short', day: 'numeric' 
                                    });
                                    var end = new Date(dateTo).toLocaleDateString('en-US', { 
                                        month: 'short', day: 'numeric', year: 'numeric' 
                                    });
                                    return start + ' - ' + end;
                                } catch (e) {
                                    return dateFrom + ' to ' + dateTo;
                                }
                            } else {
                                return periodType.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase());
                            }
                        }
                        
                        function loadIndividualBalances() {
                            var individualBalancesField = $('input[name="individual_balances"]');
                            if (individualBalancesField.length > 0) {
                                var balancesData = individualBalancesField.val();
                                console.log('Individual balances data:', balancesData);
                                
                                if (balancesData) {
                                    try {
                                        var balances = JSON.parse(balancesData);
                                        var container = $('#individual_balances_container');
                                        var html = '';
                                        
                                        if (balances.length > 0) {
                                            html += '<div class="alert alert-success mb-3">';
                                            html += '<div class="d-flex align-items-center">';
                                            html += '<i class="fa fa-check-circle fa-2x text-success me-3"></i>';
                                            html += '<div>';
                                            html += '<h6 class="mb-1">Multiple Accounts Data Loaded</h6>';
                                            html += '<p class="mb-0">Showing detailed breakdown of ' + balances.length + ' individual accounts that make up this group.</p>';
                                            html += '</div>';
                                            html += '</div>';
                                            html += '</div>';
                                            
                                            html += '<div class="row">';
                                            balances.forEach(function(balance, index) {
                                                var colorClass = balance.balance > 0 ? 'border-success' : 
                                                               (balance.balance < 0 ? 'border-danger' : 'border-secondary');
                                                var textClass = balance.balance > 0 ? 'text-success' : 
                                                              (balance.balance < 0 ? 'text-danger' : 'text-secondary');
                                                var bgClass = balance.balance > 0 ? 'bg-light' : 
                                                            (balance.balance < 0 ? 'bg-light' : 'bg-light');
                                                
                                                html += '<div class="col-md-6 col-12 mb-3">';
                                                html += '<div class="card ' + colorClass + ' h-100">';
                                                html += '<div class="card-header ' + bgClass + '">';
                                                html += '<div class="d-flex justify-content-between align-items-center">';
                                                html += '<h6 class="mb-0 text-primary">';
                                                html += '<i class="fa fa-university me-2"></i>' + balance.code;
                                                html += '</h6>';
                                                html += '<span class="badge bg-secondary">#' + (index + 1) + '</span>';
                                                html += '</div>';
                                                html += '</div>';
                                                html += '<div class="card-body">';
                                                html += '<p class="card-text text-muted small mb-2">' + balance.name + '</p>';
                                                html += '<h4 class="card-text ' + textClass + ' mb-1">' + balance.formatted_balance + '</h4>';
                                                html += '<small class="text-muted">Individual Balance</small>';
                                                html += '</div>';
                                                html += '</div>';
                                                html += '</div>';
                                            });
                                            html += '</div>';
                                            
                                        } else {
                                            html = '<div class="alert alert-warning">';
                                            html += '<div class="d-flex align-items-center">';
                                            html += '<i class="fa fa-exclamation-triangle fa-2x text-warning me-3"></i>';
                                            html += '<div>';
                                            html += '<h6 class="mb-1">No Individual Data Available</h6>';
                                            html += '<p class="mb-0">No individual account data available for the selected period.</p>';
                                            html += '</div>';
                                            html += '</div>';
                                            html += '</div>';
                                        }
                                        
                                        container.html(html);
                                    } catch (e) {
                                        console.error('Error parsing individual balances:', e);
                                        $('#individual_balances_container').html(
                                            '<div class="alert alert-danger">' +
                                            '<div class="d-flex align-items-center">' +
                                            '<i class="fa fa-exclamation-circle fa-2x text-danger me-3"></i>' +
                                            '<div>' +
                                            '<h6 class="mb-1">Data Loading Error</h6>' +
                                            '<p class="mb-0">Error loading individual account balances. Please refresh the page.</p>' +
                                            '</div>' +
                                            '</div>' +
                                            '</div>'
                                        );
                                    }
                                } else {
                                    $('#individual_balances_container').html(
                                        '<div class="alert alert-info">' +
                                        '<div class="d-flex align-items-center">' +
                                        '<i class="fa fa-info-circle fa-2x text-info me-3"></i>' +
                                        '<div>' +
                                        '<h6 class="mb-1">No Balance Data</h6>' +
                                        '<p class="mb-0">No balance data available for the selected period.</p>' +
                                        '</div>' +
                                        '</div>' +
                                        '</div>'
                                    );
                                }
                            }
                        }
                        
                        function loadPeriodSummary() {
                            var balancesField = $('input[name="individual_balances"]').val();
                            var currentBalance = parseFloat($('span[name="current_balance"]').text()) || 0;
                            
                            if (balancesField) {
                                try {
                                    var balances = JSON.parse(balancesField);
                                    var totalBalance = balances.reduce((sum, acc) => sum + acc.balance, 0);
                                    var positiveCount = balances.filter(acc => acc.balance > 0).length;
                                    var negativeCount = balances.filter(acc => acc.balance < 0).length;
                                    var accountCount = balances.length;
                                    
                                    $('#total_balance_display').text('₺' + totalBalance.toLocaleString());
                                    $('#account_count_display').text(accountCount);
                                    $('#positive_accounts_display').text(positiveCount);
                                    $('#negative_accounts_display').text(negativeCount);
                                    
                                } catch (e) {
                                    console.error('Error calculating summary:', e);
                                    // Fallback to current balance display
                                    $('#total_balance_display').text('₺' + currentBalance.toLocaleString());
                                    $('#account_count_display').text('N/A');
                                    $('#positive_accounts_display').text('N/A');
                                    $('#negative_accounts_display').text('N/A');
                                }
                            } else {
                                // Fallback display
                                $('#total_balance_display').text('₺' + currentBalance.toLocaleString());
                                $('#account_count_display').text('0');
                                $('#positive_accounts_display').text('0');
                                $('#negative_accounts_display').text('0');
                            }
                        }
                        ]]>
                    </script>
                    
                    <!-- Hidden field to store individual balances JSON data -->
                    <field name="individual_balances" invisible="1"/>
                    
                </form>
            </field>
        </record>

        <!-- Enhanced Search View for Cash Flow Dashboard with Complete Date Filtering -->
        <record id="view_cash_flow_dashboard_search" model="ir.ui.view">
            <field name="name">cash.flow.dashboard.search</field>
            <field name="model">cash.flow.dashboard</field>
            <field name="arch" type="xml">
                <search string="Cash Flow Dashboard">
                    <!-- Field Searches - COMPLETE MULTIPLE ACCOUNTS SUPPORT -->
                    <field name="account_codes" string="Account Codes"/>
                    <field name="display_name" string="Group Name"/>
                    <field name="account_names" string="Account Names"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="config_id" string="Configuration"/>
                    
                    <!-- Date Range Fields (Custom Date Selection) -->
                    <field name="display_name" string="Date From" 
                           filter_domain="[]" 
                           context="{'date_from': self}"
                           widget="date"/>
                    <field name="display_name" string="Date To" 
                           filter_domain="[]" 
                           context="{'date_to': self}"
                           widget="date"/>
                    
                    <!-- Separator -->
                    <separator/>
                    
                    <!-- Preset Date Range Filters -->
                    <filter string="All Time" name="all_time" 
                            context="{'date_from': False, 'date_to': False}"
                            help="Show all historical data"/>
                    
                    <separator/>
                    
                    <filter string="Today" name="today"
                            domain="[]"
                            context="{'date_from': context_today().strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show today's transactions only"/>
                    
                    <filter string="This Week" name="this_week"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show current week transactions (Monday to today)"/>
                    
                    <filter string="This Month" name="this_month"
                            domain="[]"
                            context="{'date_from': context_today().strftime('%Y-%m-01'), 'date_to': (context_today().replace(day=1) + relativedelta(months=1, days=-1)).strftime('%Y-%m-%d')}"
                            help="Show current month transactions"/>
                    
                    <filter string="This Quarter" name="this_quarter"
                            domain="[]"
                            context="{'date_from': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+1)).strftime('%Y-%m-%d'), 'date_to': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+3) + relativedelta(months=1, days=-1)).strftime('%Y-%m-%d')}"
                            help="Show current quarter transactions"/>
                    
                    <filter string="This Year" name="this_year"
                            domain="[]"
                            context="{'date_from': context_today().strftime('%Y-01-01'), 'date_to': context_today().strftime('%Y-12-31')}"
                            help="Show current year transactions"/>
                    
                    <separator/>
                    
                    <filter string="Last 7 Days" name="last_7_days"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(days=-7)).strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show last 7 days transactions"/>
                    
                    <filter string="Last 30 Days" name="last_30_days"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(days=-30)).strftime('%Y-%m-%d'), 'date_to': context_today().strftime('%Y-%m-%d')}"
                            help="Show last 30 days transactions"/>
                    
                    <filter string="Last Month" name="last_month"
                            domain="[]"
                            context="{'date_from': (context_today().replace(day=1) + relativedelta(months=-1)).strftime('%Y-%m-%d'), 'date_to': (context_today().replace(day=1) + relativedelta(days=-1)).strftime('%Y-%m-%d')}"
                            help="Show previous month transactions"/>
                    
                    <filter string="Last Quarter" name="last_quarter"
                            domain="[]"
                            context="{'date_from': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+1) + relativedelta(months=-3)).strftime('%Y-%m-%d'), 'date_to': (context_today().replace(day=1, month=((context_today().month-1)//3)*3+1) + relativedelta(days=-1)).strftime('%Y-%m-%d')}"
                            help="Show previous quarter transactions"/>
                    
                    <filter string="Last Year" name="last_year"
                            domain="[]"
                            context="{'date_from': (context_today() + relativedelta(years=-1)).strftime('%Y-01-01'), 'date_to': (context_today() + relativedelta(years=-1)).strftime('%Y-12-31')}"
                            help="Show previous year transactions"/>
                    
                    <separator/>
                    
                    <!-- Balance Filters - Now with searchable balance_color -->
                    <filter string="Positive Balance" name="positive_balance" 
                            domain="[('balance_color', '=', 'green')]"
                            help="Show only accounts with positive balances"/>
                    
                    <filter string="Negative Balance" name="negative_balance" 
                            domain="[('balance_color', '=', 'red')]"
                            help="Show only accounts with negative balances"/>
                    
                    <filter string="Zero Balance" name="zero_balance" 
                            domain="[('balance_color', '=', 'blue')]"
                            help="Show only accounts with zero balances"/>
                    
                    <!-- Company Filters for Multi-Company -->
                    <filter string="Current Company" name="current_company" 
                            domain="[('company_id', '=', company_id)]"
                            help="Show only current company records" groups="base.group_multi_company"/>
                    
                    <!-- Group By Section -->
                    <group expand="0" string="Group By">
                        <filter string="Company" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                        <filter string="Configuration" name="config" context="{'group_by': 'config_id'}"/>
                        <filter string="Balance Status" name="balance_status" context="{'group_by': 'balance_color'}"/>
                        <filter string="Display Order" name="sequence" context="{'group_by': 'sequence'}"/>
                        <filter string="Currency" name="currency" context="{'group_by': 'currency_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>