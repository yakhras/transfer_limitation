<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="mailing_list_updater.SourceSelectorTemplate" owl="1">
        <div class="source-selector">
            
            <!-- ========================================= -->
            <!-- TARGET MAILING LIST SELECTION (NEW) -->
            <!-- ========================================= -->
            <div class="target-selection-section">
                
                
                <div class="content-header">
                    <h2>
                        <i class="fa fa-bullseye"></i>
                        Select Target Mailing List
                    </h2>
                    <p>Choose which mailing list to update with new contacts</p>
                </div>

                <!-- Target Search -->
                <div class="target-search">
                    <div class="search-box modern-search">
                        <i class="fa fa-search"></i>
                        <input type="text" 
                               placeholder="Type to search mailing lists..." 
                               class="search-input"
                               t-model="state.targetSearchTerm"
                               t-on-input="onTargetSearchInput"/>
                        <div t-if="state.targetSearchTerm" class="search-clear" t-on-click="clearTargetSearch">
                            <i class="fa fa-times"></i>
                        </div>
                    </div>
                    
                    <!-- Search Status -->
                    <div class="search-status">
                        <div t-if="!state.targetSearchTerm" class="search-hint">
                            <i class="fa fa-info-circle"></i>
                            Start typing to search for mailing lists
                        </div>
                        <div t-elif="state.targetSearchTerm.length &lt; 2" class="search-hint">
                            <i class="fa fa-edit"></i>
                            Type at least 2 characters to search
                        </div>
                        <div t-elif="state.targetListsLoading" class="search-hint loading">
                            <i class="fa fa-spinner fa-spin"></i>
                            Searching...
                        </div>
                        <div t-elif="!state.targetListsLoading and state.availableTargetLists.length &gt; 0" class="search-hint success">
                            <i class="fa fa-check"></i>
                            Found <span t-esc="state.availableTargetLists.length"/> mailing list(s)
                        </div>
                        <div t-elif="!state.targetListsLoading and state.targetSearchTerm.length &gt;= 2 and state.availableTargetLists.length === 0" class="search-hint no-results">
                            <i class="fa fa-exclamation-triangle"></i>
                            No mailing lists found matching "<span t-esc="state.targetSearchTerm"/>"
                        </div>
                    </div>
                </div>

                <!-- Target Selection Results -->
                <div t-if="state.targetSearchTerm.length &gt;= 2 and !state.targetListsLoading and state.availableTargetLists.length &gt; 0" class="target-results">
                    <div class="results-header">
                        <span class="results-count"><span t-esc="state.availableTargetLists.length"/> result(s)</span>
                    </div>
                    
                    <div class="target-lists modern-list">
                        <div t-foreach="state.availableTargetLists" 
                             t-as="targetList" 
                             t-key="targetList.mailing_list_id"
                             t-att-class="state.selectedTargetList?.mailing_list_id === targetList.mailing_list_id ? 'target-item selected modern-item' : 'target-item modern-item'"
                             t-on-click="() => this.onTargetListSelect(targetList)">
                            
                            <div class="target-info">
                                <h3 t-esc="targetList.name"></h3>
                                <span class="mailing-list-id">ID: <span t-esc="targetList.mailing_list_id"/></span>
                            </div>
                            
                            <div class="selection-radio">
                                <i t-if="state.selectedTargetList?.mailing_list_id === targetList.mailing_list_id" 
                                   class="fa fa-dot-circle-o selected-icon"></i>
                                <i t-else="" 
                                   class="fa fa-circle-o"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Target Selection Status -->
                <div t-if="state.selectedTargetList" class="selection-summary">
                    <div class="mlu-alert mlu-alert-success">
                        <i class="fa fa-check-circle"></i>
                        Target: <strong t-esc="state.selectedTargetList.name"/>
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <div class="section-divider"></div>

            <!-- ========================================= -->
            <!-- CONTACT SOURCE SELECTION (ORIGINAL) -->
            <!-- ========================================= -->
            <div class="source-selection-section">
                <div class="content-header">
                    <h2>
                        <i class="fa fa-database"></i>
                        Select Contact Sources
                    </h2>
                    <p>Choose which contact sources to import from</p>
                </div>
                
                <!-- Source Loading State -->
                <div t-if="state.isLoading" class="loading-container">
                    <div class="loading-spinner"></div>
                    <p>Loading contact sources...</p>
                </div>
                
                <!-- Source Selection Summary -->
                <div t-if="state.selectedSources.length &gt; 0" class="selection-summary">
                    <div class="mlu-alert mlu-alert-success">
                        <i class="fa fa-check-circle"></i>
                        <span t-esc="state.selectedSources.length"/> source(s) selected • Ready to proceed
                    </div>
                </div>
                
                <!-- Source Cards -->
                <div t-if="!state.isLoading" class="source-cards">
                    <div t-foreach="state.filteredSources" 
                         t-as="source" 
                         t-key="source.model_name"
                         t-att-class="getSourceItemClass(source)"
                         t-att-data-model="source.model_name"
                         t-on-click="onSourceToggle">
                        
                        <!-- Badges -->
                        <div t-if="source.recommended || isSourceSelected(source.model_name)" 
                             class="card-badges">
                            <span t-if="source.recommended" 
                                  class="badge badge-recommended">
                                <i class="fa fa-star"></i>
                                RECOMMENDED
                            </span>
                            <span t-if="isSourceSelected(source.model_name)"
                                  class="badge badge-selected">
                                <i class="fa fa-check"></i>
                                SELECTED
                            </span>
                        </div>
                        
                        <!-- Card Header -->
                        <div class="card-header">
                            <div t-att-class="'card-icon ' + source.model_name.replace('.', '-') + '-icon'">
                                <i t-att-class="source.icon || 'fa fa-users'"></i>
                            </div>
                            <h3 t-esc="source.name"></h3>
                            <div class="selection-check">
                                <i t-if="isSourceSelected(source.model_name)" 
                                   class="fa fa-check-circle"></i>
                                <i t-else="" 
                                   class="fa fa-circle-o"></i>
                            </div>
                        </div>
                        
                        <!-- Card Description -->
                        <p class="card-description" t-esc="source.description"></p>
                        
                        <!-- Card Stats -->
                        <div class="card-stats">
                            <span class="stat-item">
                                <i class="fa fa-users"></i>
                                <span t-esc="formatContactCount(source.estimated_count)"/> contacts
                            </span>
                            <button class="btn-details" 
                                    t-att-data-model="source.model_name"
                                    t-on-click.stop="toggleSourceDetails">
                                <i t-att-class="state.showSourceDetails[source.model_name] ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"></i>
                                <span t-if="state.showSourceDetails[source.model_name]">Hide Details</span>
                                <span t-else="">Show Details</span>
                            </button>
                        </div>
                        
                        <!-- Expandable Details -->
                        <div t-if="state.showSourceDetails[source.model_name]" class="card-details">
                            <div class="details-content">
                                <div class="detail-item">
                                    <strong>Model:</strong> <span t-esc="source.model_name"/>
                                </div>
                                <div class="detail-item">
                                    <strong>Email Field:</strong> <span t-esc="source.email_field || 'email'"/>
                                </div>
                                <div class="detail-item">
                                    <strong>Name Field:</strong> <span t-esc="source.name_field || 'name'"/>
                                </div>
                                <div t-if="source.company_field" class="detail-item">
                                    <strong>Company Field:</strong> <span t-esc="source.company_field"/>
                                </div>
                                <div class="detail-item">
                                    <strong>Status:</strong> 
                                    <span t-if="source.available" class="status-available">Available</span>
                                    <span t-else="" class="status-unavailable">Unavailable</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Source Empty State -->
                <div t-if="!state.isLoading and state.filteredSources.length === 0" class="empty-state">
                    <div class="empty-content">
                        <i class="fa fa-database fa-3x"></i>
                        <h3>No contact sources available</h3>
                        <p>Check if contact sources are properly configured in the system.</p>
                    </div>
                </div>
            </div>

            <!-- Overall Validation Summary -->
            <div class="overall-validation">
                <div t-if="state.selectedTargetList and state.selectedSources.length > 0" 
                     class="mlu-alert mlu-alert-success">
                    <i class="fa fa-check-circle"></i>
                    <strong>Ready:</strong> Will import from <span t-esc="state.selectedSources.length"/> source(s) 
                    into "<span t-esc="state.selectedTargetList.name"/>"
                </div>
                <div t-elif="!state.selectedTargetList" 
                     class="mlu-alert mlu-alert-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    Please search and select a target mailing list
                </div>
                <div t-elif="state.selectedSources.length === 0" 
                     class="mlu-alert mlu-alert-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    Please select at least one contact source
                </div>
            </div>
        </div>
    </t>
</templates>