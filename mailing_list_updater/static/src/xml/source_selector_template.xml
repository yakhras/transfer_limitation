<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- ==========================================================================
         SOURCE SELECTOR TEMPLATE (Corrected for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.SourceSelectorTemplate" owl="1">
        <div class="source-selector">
            <div class="source-selector-header">
                <h3>
                    <i class="fa fa-database"></i>
                    Select Contact Sources
                </h3>
                
                <div class="source-actions">
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search sources..."
                           t-att-value="state.searchTerm"
                           t-on-input="onSearchInput"/>
                    
                    <button class="btn btn-outline-primary btn-sm" 
                            t-on-click="selectAllRecommended">
                        <i class="fa fa-check-square-o"></i>
                        Select Recommended
                    </button>
                    
                    <button class="btn btn-outline-secondary btn-sm" 
                            t-on-click="clearAllSelections">
                        <i class="fa fa-square-o"></i>
                        Clear All
                    </button>
                </div>
            </div>
            
            <!-- Selection Summary -->
            <div t-if="state.selectedSources.size > 0" class="selection-summary">
                <div class="alert alert-success">
                    <i class="fa fa-check-circle"></i>
                    <span t-esc="state.selectedSources.size"/> source(s) selected
                </div>
            </div>
            
            <div t-if="state.isLoading" class="text-center">
                <div class="loading-spinner"></div>
                <p>Loading contact sources...</p>
            </div>
            
            <div t-else="" class="source-grid">
                <div t-foreach="state.filteredSources" t-as="source" 
                     t-key="source.model_name"
                     t-att-class="getSourceItemClass(source)"
                     t-att-data-model="source.model_name"
                     t-on-click="onSourceToggle">
                    
                    <div class="source-header">
                        <div class="source-icon">
                            <i class="fa fa-database"></i>
                        </div>
                        <h4 t-esc="source.name"></h4>
                        <div t-if="source.recommended" class="badge badge-warning">
                            <i class="fa fa-star"></i>
                            Recommended
                        </div>
                    </div>
                    
                    <p t-esc="source.description"></p>
                    
                    <div class="source-stats">
                        <span class="text-muted">
                            <i class="fa fa-users"></i>
                            <t t-esc="formatContactCount(source.estimated_count)"/> contacts
                        </span>
                        
                        <div class="source-status">
                            <i t-if="isSourceSelected(source.model_name)" 
                               class="fa fa-check-circle text-success"></i>
                            <i t-elif="!source.available" 
                               class="fa fa-exclamation-triangle text-warning"></i>
                            <i t-else="" 
                               class="fa fa-circle-o text-muted"></i>
                        </div>
                    </div>
                    
                    <!-- Details Toggle (Fixed) -->
                    <div class="source-details-toggle">
                        <button class="btn btn-link btn-sm" 
                                t-att-data-model="source.model_name"
                                t-on-click="toggleSourceDetails">
                            <i t-att-class="state.showSourceDetails[source.model_name] ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"></i>
                            <t t-if="state.showSourceDetails[source.model_name]">Hide</t>
                            <t t-else="">Show</t> Details
                        </button>
                    </div>
                    
                    <!-- Source Details (Expandable) -->
                    <div t-if="state.showSourceDetails[source.model_name]" class="source-details">
                        <div class="alert alert-info">
                            <h6>Technical Details:</h6>
                            <ul>
                                <li><strong>Model:</strong> <code t-esc="source.model_name"></code></li>
                                <li><strong>Email Field:</strong> <code t-esc="source.email_field"></code></li>
                                <li><strong>Name Field:</strong> <code t-esc="source.name_field"></code></li>
                                <li t-if="source.phone_field"><strong>Phone Field:</strong> <code t-esc="source.phone_field"></code></li>
                                <li t-if="source.company_field"><strong>Company Field:</strong> <code t-esc="source.company_field"></code></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div t-if="state.filteredSources.length === 0 and !state.isLoading" class="text-center text-muted">
                <i class="fa fa-search fa-3x"></i>
                <h4>No sources found</h4>
                <p>Try adjusting your search criteria</p>
            </div>
        </div>
    </t>
</templates>
