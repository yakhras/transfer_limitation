<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="mailing_list_updater.FilterBuilderTemplate" owl="1">
        
        <div class="filter-builder">
            <div class="content-header">
                <h2>
                    <i class="fa fa-filter"></i>
                    Build Contact Filters
                </h2>
                <p>Configure filters to refine your contact selection</p>
            </div>
            
            <!-- Loading State -->
            <div t-if="state.isLoading" class="mlu-alert mlu-alert-info">
                <i class="fa fa-spinner fa-spin"></i>
                Loading filter options...
            </div>
            
            <!-- No Sources Selected State -->
            <div t-if="!state.isLoading and state.selectedModels.length === 0" class="mlu-alert mlu-alert-warning">
                <i class="fa fa-exclamation-triangle"></i>
                <strong>No sources selected.</strong> Please select contact sources first to enable filtering options.
            </div>
            
            <div t-if="!state.isLoading and state.selectedModels.length > 0" class="filter-content">
                
                <!-- Available Sources Info -->
                <div class="selected-sources-info mb-4">
                    <h6><i class="fa fa-info-circle text-primary"></i> Advanced Filters Available For:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span t-foreach="selectedSources" t-as="source" t-key="source.model_name"
                              class="badge bg-success">
                            <i t-att-class="source.model_name === 'res.partner' ? 'fa fa-user' : 'fa fa-star'"></i>
                            <span t-esc="source.name"/> (<span t-esc="source.model_name"/>)
                        </span>
                    </div>
                    <small class="text-muted">
                        Total <strong t-esc="state.availableFields.length"/> fields available for advanced filtering
                    </small>
                </div>
                
                <!-- Quick Filters Section -->
                <div class="quick-filters-section mb-4">
                    <h4><i class="fa fa-bolt text-primary"></i> Quick Filters (Common for all sources)</h4>
                    
                    <!-- Creation Date Range -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Creation Date Range</label>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">From:</label>
                                <input type="date" class="form-control"
                                       t-model="state.quickFilters.date_range.from"
                                       t-on-change="(ev) => this.onDateRangeChange('from', ev.target.value)"
                                       value="2025-01-01"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">To:</label>
                                <input type="date" class="form-control"
                                       t-model="state.quickFilters.date_range.to"
                                       t-on-change="(ev) => this.onDateRangeChange('to', ev.target.value)"
                                       value="2025-12-31"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Salesperson / Responsible -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Salesperson</label>
                        
                        <!-- User Search Input -->
                        <div class="position-relative search-container">
                            <input type="text" class="form-control"
                                   t-model="state.userSearch.query"
                                   t-on-input="(ev) => this.onUserSearch(ev.target.value)"
                                   t-on-focus="() => this.showUserSuggestions(true)"
                                   placeholder="Search users..."
                                   autocomplete="off"/>
                            <i class="fa fa-search position-absolute" style="right: 10px; top: 50%; transform: translateY(-50%); color: #999;"></i>
                            
                            <!-- Search Results Dropdown -->
                            <div t-if="state.userSearch.showSuggestions and state.userSearch.results.length" 
                                 class="user-suggestions position-absolute w-100 bg-white border rounded shadow-sm mt-1" 
                                 style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                <div t-foreach="state.userSearch.results" t-as="user" t-key="user.id"
                                     class="suggestion-item p-2 border-bottom cursor-pointer hover-bg-light"
                                     t-on-click="() => this.selectUser(user)"
                                     style="cursor: pointer;">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-user me-2 text-muted"></i>
                                        <div>
                                            <div class="fw-medium" t-esc="user.name"></div>
                                            <small class="text-muted" t-esc="user.email"></small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Loading Indicator -->
                            <div t-if="state.userSearch.loading" 
                                 class="position-absolute w-100 bg-white border rounded shadow-sm mt-1 p-3 text-center"
                                 style="z-index: 1000;">
                                <i class="fa fa-spinner fa-spin me-2"></i>Searching users...
                            </div>
                            
                            <!-- No Results Message -->
                            <div t-if="state.userSearch.showSuggestions and state.userSearch.query and !state.userSearch.results.length and !state.userSearch.loading" 
                                 class="position-absolute w-100 bg-white border rounded shadow-sm mt-1 p-3 text-center text-muted"
                                 style="z-index: 1000;">
                                <i class="fa fa-search me-2"></i>No users found for "<span t-esc="state.userSearch.query"/>"
                            </div>
                        </div>
                        
                        <!-- Selected Users Display -->
                        <div t-if="state.quickFilters.responsible_users.length" class="selected-users mt-2">
                            <div class="d-flex flex-wrap gap-2">
                                <span t-foreach="state.quickFilters.responsible_users" t-as="user" t-key="user.id"
                                      class="badge bg-primary d-flex align-items-center">
                                    <i class="fa fa-user me-1"></i>
                                    <span t-esc="user.name"></span>
                                    <button type="button" class="btn-close btn-close-white ms-2" 
                                            t-on-click="() => this.removeSelectedUser(user.id)"
                                            style="font-size: 0.7em;" aria-label="Remove"></button>
                                </span>
                            </div>
                        </div>
                        
                        <small class="form-text text-muted">Search and select multiple users</small>
                    </div>
                    
                    <!-- Company / Organization -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Company</label>
                        
                        <!-- Company Search Input -->
                        <div class="position-relative search-container">
                            <input type="text" class="form-control"
                                   t-model="state.companySearch.query"
                                   t-on-input="(ev) => this.onCompanySearch(ev.target.value)"
                                   t-on-focus="() => this.showCompanySuggestions(true)"
                                   placeholder="Search companies/organizations..."
                                   autocomplete="off"/>
                            <i class="fa fa-search position-absolute" style="right: 10px; top: 50%; transform: translateY(-50%); color: #999;"></i>
                            
                            <!-- Search Results Dropdown -->
                            <div t-if="state.companySearch.showSuggestions and state.companySearch.results.length" 
                                 class="company-suggestions position-absolute w-100 bg-white border rounded shadow-sm mt-1" 
                                 style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                <div t-foreach="state.companySearch.results" t-as="company" t-key="company.id"
                                     class="suggestion-item p-2 border-bottom cursor-pointer hover-bg-light"
                                     t-on-click="() => this.selectCompany(company)"
                                     style="cursor: pointer;">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-building me-2 text-muted"></i>
                                        <div>
                                            <div class="fw-medium" t-esc="company.name"></div>
                                            <small class="text-muted" t-esc="company.name"></small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Loading Indicator -->
                            <div t-if="state.companySearch.loading" 
                                 class="position-absolute w-100 bg-white border rounded shadow-sm mt-1 p-3 text-center"
                                 style="z-index: 1000;">
                                <i class="fa fa-spinner fa-spin me-2"></i>Searching companies...
                            </div>
                            
                            <!-- No Results Message -->
                            <div t-if="state.companySearch.showSuggestions and state.companySearch.query and !state.companySearch.results.length and !state.companySearch.loading" 
                                 class="position-absolute w-100 bg-white border rounded shadow-sm mt-1 p-3 text-center text-muted"
                                 style="z-index: 1000;">
                                <i class="fa fa-search me-2"></i>No companies found for "<span t-esc="state.companySearch.query"/>"
                            </div>
                        </div>
                        
                        <!-- Selected Companies Display -->
                        <div t-if="state.quickFilters.companies.length" class="selected-companies mt-2">
                            <div class="d-flex flex-wrap gap-2">
                                <span t-foreach="state.quickFilters.companies" t-as="company" t-key="company.id"
                                      class="badge bg-success d-flex align-items-center">
                                    <i class="fa fa-building me-1"></i>
                                    <span t-esc="company.name"></span>
                                    <button type="button" class="btn-close btn-close-white ms-2" 
                                            t-on-click="() => this.removeSelectedCompany(company.id)"
                                            style="font-size: 0.7em;" aria-label="Remove"></button>
                                </span>
                            </div>
                        </div>
                        
                        <small class="form-text text-muted">Search and select multiple companies</small>
                    </div>
                </div>
                
                <!-- Advanced Filters Section -->
                <div class="advanced-filters-section mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4><i class="fa fa-cogs"></i> Advanced Filters (Model-Specific)</h4>
                            <small class="text-muted">
                                Filter contacts using fields from selected source models
                                <span t-if="state.selectedModels.length > 1" class="text-info">
                                    • Multi-model filtering enabled
                                </span>
                            </small>
                        </div>
                        <button class="btn-details"
                                t-att-disabled="state.availableFields.length === 0"
                                t-on-click="() => this.toggleAdvancedFilters()">
                            <i t-att-class="state.showAdvanced ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"></i>
                            <t t-if="state.showAdvanced">Hide</t>
                            <t t-if="!state.showAdvanced">Show</t> Advanced
                        </button>
                    </div>
                    
                    <!-- Field Loading Info -->
                    <div t-if="state.availableFields.length" class="mb-2">
                        <small class="text-success">
                            <i class="fa fa-check-circle me-1"></i>
                            Loaded <strong t-esc="state.availableFields.length"/> fields from 
                            <strong t-esc="state.selectedModels.length"/> model<t t-if="state.selectedModels.length > 1">s</t>
                            (<t t-foreach="state.selectedModels" t-as="model" t-key="model">
                                <code t-esc="model"/><t t-if="!model_last">, </t>
                            </t>)
                        </small>
                    </div>
                    
                    <!-- Advanced Filters Content -->
                    <div t-if="state.showAdvanced" class="advanced-content">
                        
                        <!-- Logic Selection -->
                        <div class="logic-selection mb-3">
                            <label class="form-label">Rule logic</label>
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" 
                                       t-att-checked="state.advancedFilters.logic === 'AND'"
                                       t-on-change="() => this.changeFilterLogic('AND')"
                                       id="logicAND"/>
                                <label class="btn btn-outline-primary" for="logicAND">AND</label>
                                
                                <input type="radio" class="btn-check" 
                                       t-att-checked="state.advancedFilters.logic === 'OR'"
                                       t-on-change="() => this.changeFilterLogic('OR')"
                                       id="logicOR"/>
                                <label class="btn btn-outline-primary" for="logicOR">OR</label>
                            </div>
                            <small class="form-text text-muted">
                                AND: All rules must match | OR: Any rule can match
                            </small>
                        </div>
                        
                        <!-- Existing Rules -->
                        <div t-if="state.advancedFilters.rules.length" class="existing-rules mb-3">
                            <h5>Current Rules</h5>
                            <div class="rules-list">
                                <div t-foreach="state.advancedFilters.rules" t-as="rule" t-key="rule.id"
                                     class="rule-item d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded">
                                    <span class="rule-display">
                                        <i class="fa fa-filter me-2"></i>
                                        <span t-esc="formatRuleDisplay(rule)"></span>
                                        <small class="text-muted ms-2">
                                            (<code t-esc="rule.model || 'unknown'"/>.<code t-esc="rule.original_field || rule.field"/>, <span t-esc="rule.field_type"/>)
                                        </small>
                                    </span>
                                    <button class="btn btn-outline-danger btn-sm"
                                            t-on-click="() => this.removeFilterRule(rule.id)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Add New Rule Form -->
                        <div class="new-rule-form border p-3 rounded">
                            <h5>Add New Rule 
                                <small class="text-muted">
                                    (Fields from: 
                                    <t t-foreach="state.selectedModels" t-as="model" t-key="model">
                                        <code t-esc="model"/><t t-if="!model_last">, </t>
                                    </t>)
                                </small>
                            </h5>
                            <div class="row">
                                <!-- Field Selection -->
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Field</label>
                                    <select class="form-select" 
                                            t-model="state.newRule.field"
                                            t-on-change="(ev) => this.onRuleFieldChange(ev.target.value)">
                                        <option value="">Select field...</option>
                                        
                                        <!-- Group fields by model if multiple models -->
                                        <t t-if="state.selectedModels.length > 1">
                                            <t t-foreach="state.selectedModels" t-as="modelName" t-key="modelName">
                                                <!-- Find source name for this model -->
                                                <t t-set="sourceName" t-value="selectedSources.find(s => s.model_name === modelName)?.name || modelName"/>
                                                <optgroup t-att-label="sourceName + ' (' + modelName + ')'">
                                                    <option t-foreach="state.availableFields.filter(f => f.model === modelName)" 
                                                            t-as="field" t-key="field.name"
                                                            t-att-value="field.name"
                                                            t-att-title="field.originalName + ' (' + field.type + ')'">
                                                        <t t-esc="field.string.replace(' (' + sourceName + ')', '')"/>
                                                        (<t t-esc="field.type"/>)
                                                    </option>
                                                </optgroup>
                                            </t>
                                        </t>
                                        
                                        <!-- Simple list if single model -->
                                        <t t-if="state.selectedModels.length === 1">
                                            <option t-foreach="state.availableFields" t-as="field" t-key="field.name"
                                                    t-att-value="field.name"
                                                    t-att-title="field.originalName + ' (' + field.type + ')'">
                                                <t t-esc="field.string"/> (<t t-esc="field.type"/>)
                                            </option>
                                        </t>
                                    </select>
                                    <small t-if="state.newRule.field" class="form-text text-muted">
                                        Model: <code t-esc="state.newRule.model"/> | 
                                        Field: <code t-esc="extractOriginalFieldName(state.newRule.field)"/> | 
                                        Type: <strong t-esc="state.newRule.field_type"/>
                                    </small>
                                </div>
                                
                                <!-- Operator Selection -->
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Operator</label>
                                    <select class="form-select" 
                                            t-model="state.newRule.operator"
                                            t-att-disabled="!state.newRule.field_type">
                                        <option value="">Select operator...</option>
                                        <option t-foreach="getOperatorsForFieldType(state.newRule.field_type)" 
                                                t-as="operator" t-key="operator.value"
                                                t-att-value="operator.value">
                                            <t t-esc="operator.label"/>
                                        </option>
                                    </select>
                                </div>
                                
                                <!-- Value Input -->
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Value</label>
                                    
                                    <!-- Text/Char Input -->
                                    <input t-if="['char', 'text'].includes(state.newRule.field_type)" 
                                           type="text" class="form-control"
                                           t-model="state.newRule.value"
                                           placeholder="Enter value..."/>
                                    
                                    <!-- Number Input -->
                                    <input t-if="['integer', 'float', 'monetary'].includes(state.newRule.field_type)" 
                                           type="number" class="form-control"
                                           t-model="state.newRule.value"
                                           t-att-step="['float', 'monetary'].includes(state.newRule.field_type) ? '0.01' : '1'"
                                           placeholder="Enter number..."/>
                                    
                                    <!-- Date Input -->
                                    <input t-if="state.newRule.field_type === 'date'" 
                                           type="date" class="form-control"
                                           t-model="state.newRule.value"/>
                                    
                                    <!-- DateTime Input -->
                                    <input t-if="state.newRule.field_type === 'datetime'" 
                                           type="datetime-local" class="form-control"
                                           t-model="state.newRule.value"/>
                                    
                                    <!-- Boolean Input -->
                                    <select t-if="state.newRule.field_type === 'boolean'" 
                                            class="form-select" t-model="state.newRule.value">
                                        <option value="">Select...</option>
                                        <option value="true">True</option>
                                        <option value="false">False</option>
                                    </select>
                                    
                                    <!-- Many2one Input (ID or name) -->
                                    <input t-if="['many2one', 'many2many', 'one2many'].includes(state.newRule.field_type)" 
                                           type="text" class="form-control"
                                           t-model="state.newRule.value"
                                           placeholder="Enter ID or name..."/>
                                    
                                    <!-- Default Input -->
                                    <input t-if="!['char', 'text', 'integer', 'float', 'monetary', 'date', 'datetime', 'boolean', 'many2one', 'many2many', 'one2many'].includes(state.newRule.field_type)" 
                                           type="text" class="form-control"
                                           t-model="state.newRule.value"
                                           placeholder="Enter value..."/>
                                    
                                    <small t-if="['many2one', 'many2many'].includes(state.newRule.field_type)" 
                                           class="form-text text-muted">
                                        Enter record ID or name for relation fields
                                    </small>
                                </div>
                                
                                <!-- Add Button -->
                                <div class="col-md-2 mb-3 d-flex align-items-end">
                                    <button class="btn btn-primary w-100"
                                            t-on-click="() => this.addFilterRule()"
                                            t-att-disabled="!state.newRule.field || !state.newRule.operator">
                                        <i class="fa fa-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Filter Preview -->
                <div t-if="state.advancedFilters.rules.length || state.quickFilters.responsible_users.length || state.quickFilters.companies.length || (state.quickFilters.date_range.from and state.quickFilters.date_range.to)" 
                     class="filter-preview p-3 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h6><i class="fa fa-eye"></i> Filter Preview</h6>
                        <div class="filter-badges">
                            <span t-if="state.quickFilters.date_range.from and state.quickFilters.date_range.to" 
                                  class="badge bg-info me-2">Date Range</span>
                            <span t-if="state.quickFilters.responsible_users.length" class="badge bg-success me-2">
                                <t t-esc="state.quickFilters.responsible_users.length"/> User<t t-if="state.quickFilters.responsible_users.length > 1">s</t>
                            </span>
                            <span t-if="state.quickFilters.companies.length" class="badge bg-info me-2">
                                <t t-esc="state.quickFilters.companies.length"/> Compan<t t-if="state.quickFilters.companies.length > 1">ies</t><t t-if="state.quickFilters.companies.length === 1">y</t>
                            </span>
                            <span t-if="state.advancedFilters.rules.length" class="badge bg-warning me-2">
                                <t t-esc="state.advancedFilters.rules.length"/> Advanced Rules
                            </span>
                            <span t-if="state.selectedModels.length > 1" class="badge bg-secondary me-2">
                                Multi-Model
                            </span>
                        </div>
                    </div>
                    
                    <div class="filter-summary">
                        <div t-if="state.quickFilters.date_range.from and state.quickFilters.date_range.to" class="mb-2">
                            <small class="text-muted">
                                <i class="fa fa-calendar me-1"></i>
                                Creation Date: <strong t-esc="state.quickFilters.date_range.from"/> to <strong t-esc="state.quickFilters.date_range.to"/>
                            </small>
                        </div>
                        <div t-if="state.quickFilters.responsible_users.length" class="mb-2">
                            <small class="text-muted">
                                <i class="fa fa-users me-1"></i>
                                Responsible Users: 
                                <span t-foreach="state.quickFilters.responsible_users" t-as="user" t-key="user?.id || user?.name || 'user-unknown'">
                                    <strong t-esc="user.name"/><t t-if="!user_last">, </t>
                                </span>
                            </small>
                        </div>
                        <div t-if="state.quickFilters.companies.length" class="mb-2">
                            <small class="text-muted">
                                <i class="fa fa-building me-1"></i>
                                Companies: 
                                <span t-foreach="state.quickFilters.companies" t-as="company" t-key="company?.id || company?.name || 'company-unknown'">
                                    <strong t-esc="company.name"/><t t-if="!company_last">, </t>
                                </span>
                            </small>
                        </div>
                        <div t-if="state.advancedFilters.rules.length" class="mb-2">
                            <small class="text-muted">
                                <i class="fa fa-cogs me-1"></i>
                                Advanced rules combined with <strong t-esc="state.advancedFilters.logic"/> logic:
                            </small>
                            <ul class="mt-1 mb-0 ps-3">
                                <li t-foreach="state.advancedFilters.rules" t-as="rule" t-key="rule.id">
                                    <small class="text-muted">
                                        <code t-esc="rule.model">: </code><span t-esc="formatRuleDisplay(rule)"/>
                                    </small>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="filter-actions d-flex justify-content-start mb-3">
                    <button class="btn-details me-2"
                            t-on-click="() => this.clearAllFilters()">
                        <i class="fa fa-times"></i> Clear All
                    </button>
                </div>
                    
        
                
            </div>
        </div>
    </t>

</templates>