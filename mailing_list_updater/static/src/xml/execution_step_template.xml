<?xml version="1.0" encoding="utf-8"?> -->
<templates xml:space="preserve">
    <t t-name="mailing_list_updater.ExecutionStepTemplate" owl="1">
        <div class="execution-step-container">
            <!-- Count Display -->
            <div class="execution-count">1,457</div>
            <div class="execution-label">contacts to add</div>

            <!-- Circle Button -->
            <button class="circle-btn">
                <svg class="progress-ring" width="186" height="186">
                    <circle
                        stroke="#ffffff"
                        stroke-width="6"
                        fill="transparent"
                        r="90"
                        cx="93"
                        cy="93"
                        stroke-dasharray="565.48"
                        stroke-dashoffset="282.74"
                    />
                </svg>
                <i class="fa fa-play circle-icon"></i>
                <span class="circle-text">Execute</span>
                <span class="percentage" style="display:none;">50%</span>
                <i class="fa fa-check circle-icon-success" style="display:none;"></i>
            </button>

            <!-- Info Text -->
            <div class="execution-info">
                Click to update Newsletter Subscribers
            </div>

            <!-- Actions -->
            <div class="execution-actions">
                
                <div class="success-actions" style="display:none;">
                    <button class="btn btn-sm btn-outline-secondary">
                        <i class="fa fa-history"></i> View History
                    </button>
                    <button class="btn btn-sm btn-primary">
                        <i class="fa fa-check"></i> Done
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>