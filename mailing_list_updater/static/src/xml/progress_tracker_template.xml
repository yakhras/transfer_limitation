<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    
    
    <t t-name="mailing_list_updater.ExecutionStepTemplate" owl="1">
        <div class="progress-tracker">
            <div class="content-header">
                <h2>
                    <i class="fa fa-spinner fa-spin"></i>
                    Processing...
                </h2>
                <p>Your mailing list is being updated</p>
            </div>
            
            <div class="progress-content">
                <div class="mlu-alert mlu-alert-info">
                    <i class="fa fa-info-circle"></i>
                    Progress Tracker component will be loaded here
                </div>
            </div>
        </div>
    </t>
    
    

</templates>