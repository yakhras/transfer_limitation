            .summary-saved {
                font-size: 10px;
                color: #6366f1;
                font-weight: bold;
                margin-top: 8px;
            }

            .progress-section {
                margin: 20px;
            }

            .progress-bar {
                width: 100%;
                height: 4px;
                background: #e5e7eb;
                border-radius: 2px;
                overflow: hidden;
                margin-bottom: 8px;
            }

            .progress-fill {
                height: 100%;
                background: #4f46e5;
                border-radius: 2px;
                transition: width 0.3s ease;
            }

            .progress-text {
                font-size: 10px;
                color: #6b7280;
            }

            .tips-section {
                background: #f1f5f9;
                border: 1px solid #cbd5e1;
