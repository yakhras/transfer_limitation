            .show-more-actions {
                display: flex;
                gap: 8px;
            }

            .btn-show-all {
                background: #f59e0b;
                color: white;
                border: none;
                border-radius: 8px;
                padding: 4px 12px;
                font-size: 9px;
                font-weight: bold;
                cursor: pointer;
            }

            .btn-export {
                background: #e2e8f0;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                padding: 4px 12px;
                font-size: 9px;
                color: #475569;
                font-weight: bold;
                cursor: pointer;
