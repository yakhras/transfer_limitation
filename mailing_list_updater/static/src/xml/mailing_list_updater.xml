            /* Responsive Design */
            @media (max-width: 1200px) {
                .main-container {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }
                
                .left-panel {
                    order: 1;
                }
                
                .right-panel {
                    order: 2;
                }
            }

            @media (max-width: 768px) {
                .main-container {
                    padding: 10px;
                }
                
                .date-inputs {
                    flex-direction: column;
                }
                
                .preset-buttons {
                    flex-wrap: wrap;
                }
                
                .status-checkboxes {
                    flex-direction: column;
                    gap: 8px;
                }
                
                .rule-controls {
                    flex-direction: column;
                    align-items: stretch;
                }
                
                .config-actions {
                    flex-direction: column;
                }
                
                .table-header,
                .table-row {
                    flex-direction: column;
