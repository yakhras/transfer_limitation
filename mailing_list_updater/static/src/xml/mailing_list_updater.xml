<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- ==========================================================================
         MAIN COMPONENT TEMPLATE (Simplified for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.MainTemplate" owl="1">
        <div class="mailing-list-updater">
            <!-- Header -->
            <div class="mailing-updater-header">
                <h1>
                    <i class="fa fa-envelope-o"></i>
                    Mailing List Updater
                </h1>
                <p>Efficiently update your mailing lists with advanced filtering</p>
            </div>
            
            <!-- Loading Overlay -->
            <div t-if="state.isLoading" class="loading-overlay">
                <div class="loading-spinner"></div>
                <p>Loading...</p>
            </div>
            
            <!-- Error Messages -->
            <div t-if="state.errors.length > 0" class="error-messages">
                <div t-foreach="state.errors" t-as="error" class="error-message">
                    <i class="fa fa-exclamation-triangle"></i>
                    <span t-esc="error"></span>
                </div>
            </div>
            
            <!-- Step Navigation -->
            <div class="step-navigation">
                <ul class="step-nav-list">
                    <li t-att-class="state.currentStep === 'source_selection' ? 'step-nav-item active' : 'step-nav-item'">
                        <i class="fa fa-database"></i>
                        <span>Select Sources</span>
                    </li>
                    <li t-att-class="state.currentStep === 'filter_building' ? 'step-nav-item active' : 'step-nav-item'">
                        <i class="fa fa-filter"></i>
                        <span>Build Filters</span>
                    </li>
                    <li t-att-class="state.currentStep === 'preview' ? 'step-nav-item active' : 'step-nav-item'">
                        <i class="fa fa-eye"></i>
                        <span>Preview Results</span>
                    </li>
                    <li t-att-class="state.currentStep === 'execution' ? 'step-nav-item active' : 'step-nav-item'">
                        <i class="fa fa-play"></i>
                        <span>Execute</span>
                    </li>
                    <li t-att-class="state.currentStep === 'batch_management' ? 'step-nav-item active' : 'step-nav-item'">
                        <i class="fa fa-history"></i>
                        <span>History</span>
                    </li>
                </ul>
            </div>
            
            <!-- Main Content Area -->
            <div class="mailing-updater-content">
                
                <!-- Step 1: Source Selection -->
                <div t-if="state.currentStep === 'source_selection'" class="step-content">
                    <SourceSelectorComponent 
                        selectedMailingList="currentSelectedMailingList"
                        t-on-sources-changed="onSourcesChanged"/>
                </div>
                
                <!-- Step 2: Filter Building -->
                <div t-if="state.currentStep === 'filter_building'" class="step-content">
                    <FilterBuilderComponent 
                        selectedSources="currentSelectedSources"
                        t-on-filters-changed="onFiltersChanged"/>
                </div>
                
                <!-- Step 3: Preview Results -->
                <div t-if="state.currentStep === 'preview'" class="step-content">
                    <PreviewResultsComponent 
                        selectedMailingList="currentSelectedMailingList"
                        selectedSources="currentSelectedSources"
                        filterCriteria="currentFilterCriteria"
                        t-on-preview-ready="onPreviewReady"
                        t-on-execute-update="onExecuteUpdate"/>
                </div>
                
                <!-- Step 4: Execution -->
                <div t-if="state.currentStep === 'execution'" class="step-content">
                    <div class="execution-container">
                        <h2>Executing Mailing List Update</h2>
                        
                        <ProgressTrackerComponent 
                            batchId="currentBatchId"
                            initialProgress="currentExecutionProgress"
                            initialStatus="currentExecutionStatus"
                            t-on-operation-completed="onOperationCompleted"
                            t-on-operation-error="onOperationError"
                            t-on-operation-cancelled="onOperationCancelled"/>
                    </div>
                </div>
                
                <!-- Step 5: Batch Management -->
                <div t-if="state.currentStep === 'batch_management'" class="step-content">
                    <BatchManagerComponent 
                        mailingListId="currentMailingListId"/>
                </div>
            </div>
            
            <!-- Footer Actions -->
            <div class="mailing-updater-footer">
                <div class="footer-actions">
                    <button t-if="state.currentStep !== 'source_selection'" 
                            class="btn btn-secondary" 
                            t-on-click="previousStep">
                        <i class="fa fa-arrow-left"></i>
                        Previous
                    </button>
                    
                    <button t-if="state.currentStep !== 'batch_management'" 
                            class="btn btn-primary" 
                            t-on-click="nextStep">
                        Next
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </t>
    
    <!-- ==========================================================================
         SOURCE SELECTOR TEMPLATE (Simplified for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.SourceSelectorTemplate" owl="1">
        <div class="source-selector">
            <div class="source-selector-header">
                <h3>
                    <i class="fa fa-database"></i>
                    Select Contact Sources
                </h3>
                
                <div class="source-actions">
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search sources..."
                           t-on-input="onSearchInput"/>
                    
                    <button class="btn btn-outline-primary btn-sm" 
                            t-on-click="selectAllRecommended">
                        <i class="fa fa-check-square-o"></i>
                        Select Recommended
                    </button>
                    
                    <button class="btn btn-outline-secondary btn-sm" 
                            t-on-click="clearAllSelections">
                        <i class="fa fa-square-o"></i>
                        Clear All
                    </button>
                </div>
            </div>
            
            <!-- Selection Summary -->
            <div t-if="state.selectedSources.size > 0" class="selection-summary">
                <div class="alert alert-success">
                    <i class="fa fa-check-circle"></i>
                    <span t-esc="state.selectedSources.size"/> source(s) selected
                </div>
            </div>
            
            <div t-if="state.isLoading" class="text-center">
                <div class="loading-spinner"></div>
                <p>Loading contact sources...</p>
            </div>
            
            <div t-else="" class="source-grid">
                <div t-foreach="filteredSources" t-as="source" 
                     t-key="source.model_name"
                     t-att-class="getSourceItemClass(source)"
                     t-on-click="() => this.onSourceToggle(source.model_name)">
                    
                    <div class="source-header">
                        <div class="source-icon">
                            <i class="fa fa-database"></i>
                        </div>
                        <h4 t-esc="source.name"></h4>
                        <div t-if="source.recommended" class="badge badge-warning">
                            <i class="fa fa-star"></i>
                            Recommended
                        </div>
                    </div>
                    
                    <p t-esc="source.description"></p>
                    
                    <div class="source-stats">
                        <span class="text-muted">
                            <i class="fa fa-users"></i>
                            <t t-esc="formatContactCount(source.estimated_count)"/> contacts
                        </span>
                        
                        <div class="source-status">
                            <i t-if="isSourceSelected(source.model_name)" 
                               class="fa fa-check-circle text-success"></i>
                            <i t-elif="not source.available" 
                               class="fa fa-exclamation-triangle text-warning"></i>
                            <i t-else="" 
                               class="fa fa-circle-o text-muted"></i>
                        </div>
                    </div>
                </div>
            </div>
            
            <div t-if="filteredSources.length === 0 and not state.isLoading" class="text-center text-muted">
                <i class="fa fa-search fa-3x"></i>
                <h4>No sources found</h4>
                <p>Try adjusting your search criteria</p>
            </div>
        </div>
    </t>
    
    <!-- ==========================================================================
         FILTER BUILDER TEMPLATE (Simplified for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.FilterBuilderTemplate" owl="1">
        <div class="filter-builder">
            <div class="filter-builder-header">
                <h3>
                    <i class="fa fa-filter"></i>
                    Build Contact Filters
                </h3>
            </div>
            
            <div t-if="state.isLoading" class="text-center">
                <div class="loading-spinner"></div>
                <p>Loading filter options...</p>
            </div>
            
            <!-- Quick Filters Section -->
            <div class="filter-section">
                <h4>Quick Filters</h4>
                
                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" 
                               class="form-check-input" 
                               id="active_only"
                               t-att-checked="state.quickFilters.active_only"
                               t-on-change="() => this.onQuickFilterChange('active_only', !state.quickFilters.active_only)"/>
                        <label class="form-check-label" for="active_only">
                            Active contacts only
                        </label>
                    </div>
                </div>
                
                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" 
                               class="form-check-input" 
                               id="date_range_enabled"
                               t-att-checked="state.quickFilters.date_range.enabled"
                               t-on-change="toggleDateRange"/>
                        <label class="form-check-label" for="date_range_enabled">
                            Date range filter
                        </label>
                    </div>
                    
                    <div t-if="state.quickFilters.date_range.enabled" class="row">
                        <div class="col-md-4">
                            <select class="form-control">
                                <option value="create_date">Created Date</option>
                                <option value="write_date">Modified Date</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input type="date" class="form-control" placeholder="From"/>
                        </div>
                        <div class="col-md-4">
                            <input type="date" class="form-control" placeholder="To"/>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Advanced Filters Section -->
            <div class="filter-section">
                <h4>
                    Advanced Filters
                    <button class="btn btn-link btn-sm" 
                            t-on-click="toggleAdvancedFilters">
                        <i t-att-class="state.showAdvanced ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"></i>
                        <t t-if="state.showAdvanced">Hide</t>
                        <t t-else="">Show</t> Advanced
                    </button>
                </h4>
                
                <div t-if="state.showAdvanced" class="advanced-filters">
                    <div class="alert alert-info">
                        <p>Advanced filter functionality will be loaded here</p>
                    </div>
                </div>
            </div>
            
            <!-- Actions -->
            <div class="filter-actions">
                <button class="btn btn-secondary" 
                        t-on-click="clearAllFilters">
                    <i class="fa fa-eraser"></i>
                    Clear All Filters
                </button>
            </div>
        </div>
    </t>
    
    <!-- ==========================================================================
         PREVIEW RESULTS TEMPLATE (Simplified for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.PreviewResultsTemplate" owl="1">
        <div class="preview-results">
            <div class="preview-header">
                <h3>
                    <i class="fa fa-eye"></i>
                    Preview Results
                </h3>
                
                <div class="preview-actions">
                    <button class="btn btn-outline-secondary btn-sm" 
                            t-on-click="refreshPreview">
                        <i class="fa fa-refresh"></i>
                        Refresh Preview
                    </button>
                </div>
            </div>
            
            <div t-if="state.isGeneratingPreview" class="text-center">
                <div class="loading-spinner"></div>
                <p>Generating preview...</p>
            </div>
            
            <div t-elif="isPreviewValid" class="preview-content">
                
                <!-- Statistics Cards -->
                <div class="row">
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-value" t-esc="formatNumber(state.statistics.total_found || 0)"></div>
                            <div class="stat-label">Total Found</div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="stat-card bg-success">
                            <div class="stat-value" t-esc="formatNumber(state.statistics.total_after_dedup || 0)"></div>
                            <div class="stat-label">After Deduplication</div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="stat-card bg-warning">
                            <div class="stat-value" t-esc="formatNumber(state.statistics.duplicates_removed || 0)"></div>
                            <div class="stat-label">Duplicates Removed</div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="stat-card bg-danger">
                            <div class="stat-value" t-esc="formatNumber(state.statistics.invalid_emails || 0)"></div>
                            <div class="stat-label">Invalid Emails</div>
                        </div>
                    </div>
                </div>
                
                <!-- Sample Contacts Table -->
                <div class="preview-table">
                    <h4>Sample Contacts</h4>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Source</th>
                                <th>Company</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="paginatedContacts" t-as="contact" t-key="contact.id">
                                <td t-esc="getContactFieldValue(contact, 'name')"></td>
                                <td t-esc="getContactFieldValue(contact, 'email')"></td>
                                <td t-esc="getContactFieldValue(contact, 'source')"></td>
                                <td t-esc="getContactFieldValue(contact, 'company_name')"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Execution Section -->
                <div class="execution-section">
                    <h4>Ready to Execute</h4>
                    
                    <button t-att-class="executionButtonClass"
                            t-att-disabled="!state.canExecute"
                            t-on-click="executeUpdate">
                        <i class="fa fa-play"></i>
                        <t t-esc="executionButtonText"/>
                    </button>
                </div>
            </div>
            
            <div t-else="" class="text-center text-muted">
                <i class="fa fa-exclamation-triangle fa-3x"></i>
                <h4>Unable to generate preview</h4>
                <p>Please check your source selection and filters</p>
            </div>
        </div>
    </t>
    
    <!-- ==========================================================================
         PROGRESS TRACKER TEMPLATE (Simplified for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.ProgressTrackerTemplate" owl="1">
        <div t-if="state.isVisible" class="progress-tracker">
            <div class="progress-header">
                <h4>
                    <i t-att-class="'fa ' + statusIcon"></i>
                    <t t-esc="operationDisplayText"/>
                </h4>
                
                <div class="progress-actions">
                    <button t-if="state.canCancel and isOperationActive" 
                            class="btn btn-warning btn-sm"
                            t-on-click="cancelOperation">
                        <i class="fa fa-stop"></i>
                        Cancel
                    </button>
                </div>
            </div>
            
            <div class="progress-content">
                <!-- Progress Bar -->
                <div class="progress">
                    <div t-att-class="progressBarClass" 
                         t-att-style="'width: ' + state.progress + '%'">
                    </div>
                </div>
                <div class="text-center">
                    <small t-esc="state.progress + '%'"></small>
                </div>
                
                <!-- Progress Details -->
                <div class="row mt-3">
                    <div class="col-md-3 text-center">
                        <div class="progress-detail-value" t-esc="formatTime(state.elapsedTime)"></div>
                        <div class="progress-detail-label">Elapsed Time</div>
                    </div>
                    
                    <div class="col-md-3 text-center">
                        <div class="progress-detail-value" t-esc="formatNumber(state.statistics.contactsAdded)"></div>
                        <div class="progress-detail-label">Contacts Added</div>
                    </div>
                    
                    <div class="col-md-3 text-center">
                        <div class="progress-detail-value" t-esc="formatNumber(state.statistics.duplicatesSkipped)"></div>
                        <div class="progress-detail-label">Duplicates Skipped</div>
                    </div>
                    
                    <div class="col-md-3 text-center">
                        <div class="progress-detail-value" t-esc="successRatePercentage + '%'"></div>
                        <div class="progress-detail-label">Success Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </t>
    
    <!-- ==========================================================================
         BATCH MANAGER TEMPLATE (Simplified for OWL 1.0)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.BatchManagerTemplate" owl="1">
        <div class="batch-manager">
            <div class="batch-manager-header">
                <h3>
                    <i class="fa fa-history"></i>
                    Batch Operations Management
                </h3>
                
                <div class="batch-manager-actions">
                    <button class="btn btn-outline-secondary btn-sm" 
                            t-on-click="refresh">
                        <i class="fa fa-refresh"></i>
                        Refresh
                    </button>
                </div>
            </div>
            
            <!-- Filters Bar -->
            <div class="filters-bar row">
                <div class="col-md-3">
                    <label>Status:</label>
                    <select class="form-control">
                        <option value="all">All Status</option>
                        <option value="completed">Completed</option>
                        <option value="error">Error</option>
                        <option value="processing">Processing</option>
                    </select>
                </div>
                
                <div class="col-md-3">
                    <label>Date:</label>
                    <select class="form-control">
                        <option value="all">All Dates</option>
                        <option value="today">Today</option>
                        <option value="week">This Week</option>
                        <option value="month">This Month</option>
                    </select>
                </div>
                
                <div class="col-md-6">
                    <label>Search:</label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search batches..."
                           t-on-input="onSearchInput"/>
                </div>
            </div>
            
            <div t-if="state.isLoading" class="text-center">
                <div class="loading-spinner"></div>
                <p>Loading batch data...</p>
            </div>
            
            <!-- Batch History Table -->
            <div t-else="" class="batch-history">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Mailing List</th>
                            <th>Contacts</th>
                            <th>Duration</th>
                            <th>User</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.batches" t-as="batch" t-key="batch.id">
                            <td t-esc="formatDate(batch.created_date)"></td>
                            <td>
                                <span t-att-class="getStatusClass(batch.status)">
                                    <i t-att-class="'fa ' + getStatusIcon(batch.status)"></i>
                                    <t t-esc="batch.status"/>
                                </span>
                            </td>
                            <td t-esc="batch.mailing_list_name"></td>
                            <td t-esc="formatNumber(batch.contacts_processed || 0)"></td>
                            <td t-esc="formatDuration(batch.execution_time)"></td>
                            <td t-esc="batch.user_name"></td>
                            <td>
                                <button class="btn btn-outline-primary btn-sm" 
                                        t-on-click="() => this.viewBatchDetails(batch.id)">
                                    <i class="fa fa-eye"></i>
                                    View
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                
                <!-- Pagination -->
                <div class="pagination-wrapper text-center">
                    <button class="btn btn-outline-secondary btn-sm" 
                            t-att-disabled="state.currentPage === 1"
                            t-on-click="previousPage">
                        <i class="fa fa-chevron-left"></i>
                        Previous
                    </button>
                    
                    <span class="mx-3">
                        Page <t t-esc="state.currentPage"/> of <t t-esc="totalPages"/>
                    </span>
                    
                    <button class="btn btn-outline-secondary btn-sm" 
                            t-att-disabled="state.currentPage === totalPages"
                            t-on-click="nextPage">
                        Next
                        <i class="fa fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </t>
    
</templates>