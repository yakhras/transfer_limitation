<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- ==========================================================================
         MAIN COMPONENT TEMPLATE - Centered Dialog Style
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.MainTemplate" owl="1">
        <!-- Modal Backdrop -->
        <div class="mailing-updater-backdrop">
            <!-- Centered Dialog Container -->
            <div class="mailing-updater-dialog">
                
                <!-- Header -->
                <div class="dialog-header">
                    <div class="header-content">
                        <div class="header-icon">
                            <i class="fa fa-envelope-o"></i>
                        </div>
                        <div class="header-text">
                            <h1>Mailing List Updater</h1>
                            <p>Efficiently update your mailing list with advanced filtering</p>
                        </div>
                    </div>
                </div>
                
                <!-- Error Messages -->
                <div t-if="state.errors.length > 0" class="dialog-errors">
                    <div t-foreach="state.errors" t-as="error" class="error-alert">
                        <i class="fa fa-exclamation-triangle"></i>
                        <span t-esc="error"></span>
                    </div>
                </div>
                
                <!-- Step Navigation -->
                <div class="dialog-navigation">
                    <div class="step-pills">
                        <div t-att-class="state.currentStep === 'source_selection' ? 'step-pill active' : 'step-pill'">
                            <i class="fa fa-database"></i>
                            <span>Select Sources</span>
                        </div>
                        <div t-att-class="state.currentStep === 'filter_building' ? 'step-pill active' : 'step-pill'">
                            <i class="fa fa-filter"></i>
                            <span>Build Filters</span>
                        </div>
                        <div t-att-class="state.currentStep === 'preview' ? 'step-pill active' : 'step-pill'">
                            <i class="fa fa-eye"></i>
                            <span>Preview Results</span>
                        </div>
                        <div t-att-class="state.currentStep === 'execution' ? 'step-pill active' : 'step-pill'">
                            <i class="fa fa-play"></i>
                            <span>Execute</span>
                        </div>
                        <div t-att-class="state.currentStep === 'batch_management' ? 'step-pill active' : 'step-pill'">
                            <i class="fa fa-history"></i>
                            <span>History</span>
                        </div>
                    </div>
                </div>
                
                <!-- Dialog Content -->
                <div class="dialog-content">
                    
                    <!-- Step 1: Source Selection -->
                    <div t-if="state.currentStep === 'source_selection'" class="step-content">
                        <div class="content-header">
                            <h2>
                                <i class="fa fa-database"></i>
                                Select Contact Sources
                            </h2>
                            <p>Choose which contact sources to include in your mailing list update</p>
                        </div>
                        
                        <!-- Search and Actions -->
                        <div class="content-actions">
                            <div class="search-box">
                                <i class="fa fa-search"></i>
                                <input type="text" placeholder="Search sources..." class="search-input" />
                            </div>
                            <div class="action-buttons">
                                <button class="btn btn-outline">
                                    <i class="fa fa-magic"></i>
                                    Select Recommended
                                </button>
                                <button class="btn btn-outline">
                                    <i class="fa fa-eraser"></i>
                                    Clear All
                                </button>
                            </div>
                        </div>
                        
                        <!-- Source Cards -->
                        <div class="source-cards">
                            
                            <!-- Contacts Card (Selected + Recommended) -->
                            <div class="source-card selected recommended">
                                <div class="card-badges">
                                    <span class="badge badge-recommended">
                                        <i class="fa fa-star"></i>
                                        RECOMMENDED
                                    </span>
                                </div>
                                <div class="card-header">
                                    <div class="card-icon contacts-icon">
                                        <i class="fa fa-users"></i>
                                    </div>
                                    <h3>Contacts</h3>
                                    <div class="selection-check">
                                        <i class="fa fa-check-circle"></i>
                                    </div>
                                </div>
                                <p class="card-description">Import contacts from Contacts module</p>
                                <div class="card-stats">
                                    <span class="stat-item">
                                        <i class="fa fa-users"></i>
                                        1.2K contacts
                                    </span>
                                    <button class="btn-details">
                                        <i class="fa fa-chevron-down"></i>
                                        Show Details
                                    </button>
                                </div>
                            </div>
                            
                            <!-- CRM Leads Card (Selected + Recommended) -->
                            <div class="source-card selected recommended">
                                <div class="card-badges">
                                    <span class="badge badge-recommended">
                                        <i class="fa fa-star"></i>
                                        RECOMMENDED
                                    </span>
                                </div>
                                <div class="card-header">
                                    <div class="card-icon crm-icon">
                                        <i class="fa fa-line-chart"></i>
                                    </div>
                                    <h3>CRM Leads</h3>
                                    <div class="selection-check">
                                        <i class="fa fa-check-circle"></i>
                                    </div>
                                </div>
                                <p class="card-description">Import contacts from CRM Leads</p>
                                <div class="card-stats">
                                    <span class="stat-item">
                                        <i class="fa fa-users"></i>
                                        856 contacts
                                    </span>
                                    <button class="btn-details">
                                        <i class="fa fa-chevron-down"></i>
                                        Show Details
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Employees Card (Not Selected) -->
                            <div class="source-card">
                                <div class="card-header">
                                    <div class="card-icon employees-icon">
                                        <i class="fa fa-user-tie"></i>
                                    </div>
                                    <h3>Employees</h3>
                                    <div class="selection-check">
                                        <i class="fa fa-circle-o"></i>
                                    </div>
                                </div>
                                <p class="card-description">Import contacts from HR Employees</p>
                                <div class="card-stats">
                                    <span class="stat-item">
                                        <i class="fa fa-users"></i>
                                        142 contacts
                                    </span>
                                    <button class="btn-details">
                                        <i class="fa fa-chevron-down"></i>
                                        Show Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Step 2: Filter Building -->
                    <div t-if="state.currentStep === 'filter_building'" class="step-content">
                        <FilterBuilderComponent 
                            selectedSources="currentSelectedSources"
                            t-on-filters-changed="onFiltersChanged"/>
                    </div>
                    
                    <!-- Step 3: Preview Results -->
                    <div t-if="state.currentStep === 'preview'" class="step-content">
                        <PreviewResultsComponent 
                            selectedMailingList="currentSelectedMailingList"
                            selectedSources="currentSelectedSources"
                            filterCriteria="currentFilterCriteria"
                            t-on-preview-ready="onPreviewReady"
                            t-on-execute-update="onExecuteUpdate"/>
                    </div>
                    
                    <!-- Step 4: Execution -->
                    <div t-if="state.currentStep === 'execution'" class="step-content">
                        <div class="execution-container">
                            <h2>Executing Mailing List Update</h2>
                            
                            <ProgressTrackerComponent 
                                batchId="currentBatchId"
                                initialProgress="currentExecutionProgress"
                                initialStatus="currentExecutionStatus"
                                t-on-operation-completed="onOperationCompleted"
                                t-on-operation-error="onOperationError"
                                t-on-operation-cancelled="onOperationCancelled"/>
                        </div>
                    </div>
                    
                    <!-- Step 5: Batch Management -->
                    <div t-if="state.currentStep === 'batch_management'" class="step-content">
                        <BatchManagerComponent 
                            mailingListId="currentMailingListId"/>
                    </div>
                </div>
                
                <!-- Dialog Footer -->
                <div class="dialog-footer">
                    <div class="footer-info">
                        <span>Step <t t-esc="getCurrentStepNumber()"/> of 5</span>
                    </div>
                    <div class="footer-actions">
                        <button t-if="state.currentStep !== 'source_selection'" 
                                class="btn btn-secondary" 
                                t-on-click="previousStep">
                            <i class="fa fa-arrow-left"></i>
                            Previous
                        </button>
                        
                        <button t-if="state.currentStep !== 'batch_management'" 
                                class="btn btn-primary" 
                                t-on-click="nextStep">
                            Next
                            <i class="fa fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
    
    <!-- ==========================================================================
         SOURCE SELECTOR TEMPLATE (For other components)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.SourceSelectorTemplate" owl="1">
        <div class="source-selector">
            <!-- Content will be rendered by the main template for source_selection step -->
        </div>
    </t>
    
    <!-- ==========================================================================
         OTHER COMPONENT TEMPLATES (Simplified)
         ========================================================================== -->
    
    <t t-name="mailing_list_updater.FilterBuilderTemplate" owl="1">
        <div class="filter-builder">
            <div class="content-header">
                <h2>
                    <i class="fa fa-filter"></i>
                    Build Contact Filters
                </h2>
                <p>Configure filters to refine your contact selection</p>
            </div>
            
            <div class="filter-content">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    Filter Builder component will be loaded here
                </div>
            </div>
        </div>
    </t>
    
    <t t-name="mailing_list_updater.PreviewResultsTemplate" owl="1">
        <div class="preview-results">
            <div class="content-header">
                <h2>
                    <i class="fa fa-eye"></i>
                    Preview Results
                </h2>
                <p>Review contacts before updating your mailing list</p>
            </div>
            
            <div class="preview-content">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    Preview Results component will be loaded here
                </div>
            </div>
        </div>
    </t>
    
    <t t-name="mailing_list_updater.ProgressTrackerTemplate" owl="1">
        <div class="progress-tracker">
            <div class="content-header">
                <h2>
                    <i class="fa fa-spinner fa-spin"></i>
                    Processing...
                </h2>
                <p>Your mailing list is being updated</p>
            </div>
            
            <div class="progress-content">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    Progress Tracker component will be loaded here
                </div>
            </div>
        </div>
    </t>
    
    <t t-name="mailing_list_updater.BatchManagerTemplate" owl="1">
        <div class="batch-manager">
            <div class="content-header">
                <h2>
                    <i class="fa fa-history"></i>
                    Batch History
                </h2>
                <p>View and manage your mailing list update history</p>
            </div>
            
            <div class="batch-content">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    Batch Manager component will be loaded here
                </div>
            </div>
        </div>
    </t>

    <!-- ==========================================================================
         CENTERED DIALOG STYLES
         ========================================================================== -->
    
    <style>
        /* Reset and Base */
        .mailing-updater-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 1000;
        }

        .mailing-updater-dialog {
            background: white;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 900px;
            max-height: 90vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Dialog Header */
        .dialog-header {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: white;
            padding: 24px 32px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .header-content {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-icon {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .header-text h1 {
            margin: 0 0 4px 0;
            font-size: 24px;
            font-weight: 700;
        }

        .header-text p {
            margin: 0;
            opacity: 0.9;
            font-size: 14px;
        }

        /* Error Messages */
        .dialog-errors {
            background: #fef2f2;
            border-bottom: 1px solid #fecaca;
            padding: 16px 32px;
        }

        .error-alert {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #dc2626;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .error-alert:last-child {
            margin-bottom: 0;
        }

        .error-alert i {
            color: #ef4444;
        }

        /* Step Navigation */
        .dialog-navigation {
            background: #f8fafc;
            padding: 20px 32px;
            border-bottom: 1px solid #e2e8f0;
        }

        .step-pills {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 4px;
        }

        .step-pill {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 12px 16px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 100px;
            text-align: center;
            background: white;
            border: 2px solid transparent;
        }

        .step-pill:hover {
            background: #f1f5f9;
            transform: translateY(-1px);
        }

        .step-pill.active {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            border-color: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .step-pill i {
            font-size: 16px;
        }

        .step-pill span {
            font-size: 12px;
            font-weight: 600;
        }

        /* Dialog Content */
        .dialog-content {
            flex: 1;
            overflow-y: auto;
            padding: 32px;
        }

        .step-content {
            min-height: 400px;
        }

        .content-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .content-header h2 {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin: 0 0 8px 0;
            font-size: 20px;
            font-weight: 600;
            color: #1f2937;
        }

        .content-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        /* Content Actions */
        .content-actions {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 250px;
        }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

        .search-input {
            width: 100%;
            padding: 10px 12px 10px 36px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .btn {
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            border: none;
        }

        .btn-outline {
            background: white;
            color: #374151;
            border: 2px solid #e5e7eb;
        }

        .btn-outline:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            transform: translateY(-1px);
        }

        .btn-primary {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            border: 2px solid transparent;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .btn-secondary {
            background: #6b7280;
            color: white;
            border: 2px solid transparent;
        }

        .btn-secondary:hover {
            background: #4b5563;
            transform: translateY(-1px);
        }

        /* Source Cards */
        .source-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .source-card {
            background: white;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .source-card:hover {
            border-color: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px -8px rgba(79, 70, 229, 0.3);
        }

        .source-card.selected {
            border-color: #4f46e5;
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.05), rgba(124, 58, 237, 0.05));
            transform: translateY(-1px);
        }

        .source-card.recommended {
            border-color: #f59e0b;
        }

        .source-card.selected.recommended {
            border-color: #4f46e5;
        }

        .card-badges {
            position: absolute;
            top: 12px;
            right: 12px;
        }

        .badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .badge-recommended {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: white;
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
        }

        .contacts-icon {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        }

        .crm-icon {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        .employees-icon {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .card-header h3 {
            flex: 1;
            margin: 0;
            font-size: 16px;
            font-weight: 600;
            color: #1f2937;
        }

        .selection-check {
            color: #10b981;
            font-size: 20px;
        }

        .source-card:not(.selected) .selection-check {
            color: #d1d5db;
        }

        .card-description {
            color: #6b7280;
            font-size: 14px;
            margin: 0 0 16px 0;
            line-height: 1.5;
        }

        .card-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 16px;
            border-top: 1px solid #f3f4f6;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #6b7280;
            font-size: 14px;
        }

        .btn-details {
            background: none;
            border: none;
            color: #4f46e5;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
            border-radius: 6px;
            transition: background-color 0.3s ease;
        }

        .btn-details:hover {
            background: rgba(79, 70, 229, 0.1);
        }

        /* Dialog Footer */
        .dialog-footer {
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 20px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-info {
            color: #6b7280;
            font-size: 14px;
        }

        .footer-actions {
            display: flex;
            gap: 12px;
        }

        /* Alert Styles */
        .alert {
            padding: 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 20px 0;
        }

        .alert-info {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .mailing-updater-backdrop {
                padding: 10px;
            }

            .mailing-updater-dialog {
                max-height: 95vh;
            }

            .dialog-header {
                padding: 20px 24px;
            }

            .header-text h1 {
                font-size: 20px;
            }

            .dialog-content {
                padding: 24px 20px;
            }

            .step-pills {
                gap: 4px;
            }

            .step-pill {
                min-width: 80px;
                padding: 10px 12px;
            }

            .step-pill span {
                font-size: 11px;
            }

            .content-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                min-width: unset;
            }

            .action-buttons {
                justify-content: center;
            }

            .source-cards {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .dialog-footer {
                padding: 16px 20px;
                flex-direction: column;
                gap: 12px;
                text-align: center;
            }

            .footer-actions {
                width: 100%;
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .header-content {
                flex-direction: column;
                text-align: center;
                gap: 12px;
            }

            .content-header h2 {
                flex-direction: column;
                gap: 8px;
            }

            .card-header {
                flex-direction: column;
                text-align: center;
                gap: 8px;
            }

            .card-stats {
                flex-direction: column;
                gap: 12px;
                text-align: center;
            }
        }
    </style>

</templates>