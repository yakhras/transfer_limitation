                background: #f0fdf4;
                border: 1px solid #86efac;
                border-radius: 4px;
                margin: 20px;
            }

            .rollback-section .section-header {
                color: #166534;
                border-bottom-color: #86efac;
            }

            .rollback-content .rollback-line {
                color: #166534;
            }

            .rollback-access {
                font-size: 10px;
                color: #065f46;
                margin-top: 8px;
            }

            .company-section {
                background: #fffbeb;
                border: 1px solid #fbbf24;
                border-radius: 4px;
                margin: 20px;
            }

            .company-section .section-header {
                color: #92400e;
                border-bottom-color: #fbbf24;
            }

            .company-content .company-line {
                color: #92400e;
            }

            .summary-section {
                background: #f8fafc;
                border: 1px solid #cbd5e1;
                border-radius: 4px;
                margin: 20px;
