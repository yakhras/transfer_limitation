            .table-header {
                background: #374151;
                color: white;
                display: flex;
                font-size: 11px;
                font-weight: bold;
            }

            .table-row {
                display: flex;
                border-bottom: 1px solid #f3f4f6;
                font-size: 10px;
                color: #374151;
            }

            .table-row:nth-child(even) {
                background: #f9fafb;
            }

            .table-cell {
                flex: 1;
                padding: 8px 12px;
                border-right: 1px solid rgba(255,255,255,0.2);
            }

            .table-cell:last-child {
                border-right: none;
            }

            .show-more-section {
                background: #fef3c7;
                border: 1px solid #f59e0b;
                border-radius: 4px;
