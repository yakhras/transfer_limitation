        <!-- Scheduled Actions -->
        
        <!-- Performance Monitoring Action -->
       <record id="ir_cron_performance_monitoring" model="ir.cron">
            <field name="name">Mailing List Updater: Performance Monitoring</field>
            <field name="model_id" ref="model_mailing_operation_audit"/>
            <field name="state">code</field>
            <field name="code">
# Simple weekly performance logging without imports
week_ago = fields.Datetime.subtract(fields.Datetime.now(), days=7)
recent_batches = env['mailing.list.update.batch'].search([
    ('create_date', '>=', week_ago),
    ('state', '=', 'completed')
])

if recent_batches:
    total_contacts = sum(batch.contacts_added for batch in recent_batches)
    avg_time = sum(batch.execution_time for batch in recent_batches) / len(recent_batches)
    
    details_json = json.dumps({
        'type': 'weekly_performance_summary',
        'batches_count': len(recent_batches),
        'total_contacts_added': total_contacts,
        'average_execution_time': avg_time
    })
    
    env['mailing.operation.audit'].create({
        'batch_id': 'SYSTEM_MONITORING',
        'operation_type': 'execution_completed',
        'user_id': 1,
        'details': details_json,
        'success': True,
        'company_id': env.company.id,
    })
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>


        <!-- Registry Health Check Action -->
        <record id="ir_cron_registry_health_check" model="ir.cron">
            <field name="name">Mailing List Updater: Registry Health Check</field>
            <field name="model_id" ref="model_mailing_source_registry"/>
            <field name="state">code</field>
            <field name="code">
active_entries = model.search([('is_active', '=', True)])
healthy_count = 0
issues = []

for entry in active_entries:
    try:
        test_model = env[entry.model_name]
        test_model.search([], limit=1)
        healthy_count += 1
    except Exception as e:
        issues.append("{}: {}".format(entry.model_name, str(e)))

details_json = json.dumps({
    'type': 'registry_health_check',
    'total_entries': len(active_entries),
    'healthy_entries': healthy_count,
    'issues': issues
})

env['mailing.operation.audit'].create({
    'batch_id': 'SYSTEM_HEALTH_CHECK',
    'operation_type': 'execution_completed',
    'user_id': 1,
    'details': details_json,
    'success': len(issues) == 0,
    'error_message': "Found {} issues".format(len(issues)) if issues else None,
    'company_id': env.company.id,
})
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>