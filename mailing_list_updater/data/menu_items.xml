<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Actions for Menu Items -->
        
        <!-- Main Mailing List Update Client Action -->
        <record id="action_mailing_list_updater" model="ir.actions.client">
            <field name="name">Update Mailing Lists</field>
            <field name="tag">mailing_list_updater</field>
            <field name="context">{
                'initial_step': 'target_selection',
                'show_breadcrumb': True
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first mailing list update batch!
                </p>
                <p>
                    Use the mailing list updater to automatically add contacts from various sources
                    (Contacts, CRM, HR, Events) to your mailing lists with advanced filtering and
                    deduplication capabilities.
                </p>
            </field>
        </record>

        <!-- Batch History Client Action -->
        <record id="action_batch_history" model="ir.actions.client">
            <field name="name">Batch History</field>
            <field name="tag">mailing_list_updater</field>
            <field name="context">{
                'initial_step': 'batch_management',
                'show_breadcrumb': True
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No batch operations found.
                </p>
                <p>
                    This view shows the history of all mailing list update operations,
                    including their status, statistics, and rollback capabilities.
                </p>
            </field>
        </record>

        <!-- Registry Configuration Action (Traditional view for admin) -->
        <record id="action_source_registry" model="ir.actions.act_window">
            <field name="name">Contact Source Registry</field>
            <field name="res_model">mailing.source.registry</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure your contact sources!
                </p>
                <p>
                    The registry manages which Odoo models can be used as contact sources
                    for mailing list updates. Configure field mappings and filter options
                    for each source.
                </p>
            </field>
        </record>

        <!-- Filter Templates Action (Traditional view) -->
        <record id="action_filter_templates" model="ir.actions.act_window">
            <field name="name">Filter Templates</field>
            <field name="res_model">mailing.filter.template</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first filter template!
                </p>
                <p>
                    Save complex filter configurations as templates for reuse.
                    Templates can be private or shared with other users.
                </p>
            </field>
        </record>

        <!-- Audit Trail Action (Traditional view) -->
        <record id="action_audit_trail" model="ir.actions.act_window">
            <field name="name">Audit Trail</field>
            <field name="res_model">mailing.operation.audit</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No audit entries found.
                </p>
                <p>
                    The audit trail provides a complete log of all mailing list update
                    operations for compliance and troubleshooting purposes.
                </p>
            </field>
        </record>

        <!-- Contact Tracking Action (Traditional view) -->
        <record id="action_contact_tracking" model="ir.actions.act_window">
            <field name="name">Contact Tracking</field>
            <field name="res_model">mailing.contact.tracking</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No tracking records found.
                </p>
                <p>
                    Contact tracking provides detailed information about which contacts
                    were added through which batch operations, enabling precise rollback
                    capabilities.
                </p>
            </field>
        </record>

        <!-- Main Menu Items -->
        
        <!-- Primary Menu Item under Email Marketing -->
        <menuitem id="menu_mailing_list_updater_main"
                  name="Update Lists"
                  parent="mass_mailing.mass_mailing_menu_root"
                  action="action_mailing_list_updater"
                  sequence="15"
                  groups="group_mailing_list_updater_user"/>

        <!-- Sub-menu for Batch History -->
        <menuitem id="menu_batch_history"
                  name="Batch History"
                  parent="mass_mailing.mass_mailing_menu_root"
                  action="action_batch_history"
                  sequence="16"
                  groups="group_mailing_list_updater_user"/>

        <!-- Configuration Sub-menu -->
        <menuitem id="menu_mailing_updater_config"
                  name="Mailing List Updater"
                  parent="mass_mailing.mass_mailing_configuration"
                  sequence="20"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Registry Configuration -->
        <menuitem id="menu_source_registry"
                  name="Contact Sources"
                  parent="menu_mailing_updater_config"
                  action="action_source_registry"
                  sequence="10"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Filter Templates -->
        <menuitem id="menu_filter_templates"
                  name="Filter Templates"
                  parent="menu_mailing_updater_config"
                  action="action_filter_templates"
                  sequence="20"
                  groups="group_mailing_list_updater_user"/>

        <!-- Advanced/Debug Menus -->
        <menuitem id="menu_mailing_updater_advanced"
                  name="Advanced"
                  parent="menu_mailing_updater_config"
                  sequence="90"
                  groups="group_mailing_list_updater_admin"/>

        <!-- Audit Trail -->
        <menuitem id="menu_audit_trail"
                  name="Audit Trail"
                  parent="menu_mailing_updater_advanced"
                  action="action_audit_trail"
                  sequence="10"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Contact Tracking -->
        <menuitem id="menu_contact_tracking"
                  name="Contact Tracking"
                  parent="menu_mailing_updater_advanced"
                  action="action_contact_tracking"
                  sequence="20"
                  groups="group_mailing_list_updater_manager"/>

