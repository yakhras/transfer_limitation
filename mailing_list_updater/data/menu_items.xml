<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Actions for Menu Items -->
        
        <!-- Main Mailing List Update Action -->
        <record id="action_mailing_list_updater" model="ir.actions.act_window">
            <field name="name">Update Mailing Lists</field>
            <field name="res_model">mailing.list.update.batch</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first mailing list update batch!
                </p>
                <p>
                    Use the mailing list updater to automatically add contacts from various sources
                    (Contacts, CRM, HR, Events) to your mailing lists with advanced filtering and
                    deduplication capabilities.
                </p>
            </field>
        </record>

        <!-- Batch History Action -->
        <record id="action_batch_history" model="ir.actions.act_window">
            <field name="name">Batch History</field>
            <field name="res_model">mailing.list.update.batch</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No batch operations found.
                </p>
                <p>
                    This view shows the history of all mailing list update operations,
                    including their status, statistics, and rollback capabilities.
                </p>
            </field>
        </record>

        <!-- Registry Configuration Action -->
        <record id="action_source_registry" model="ir.actions.act_window">
            <field name="name">Contact Source Registry</field>
            <field name="res_model">mailing.source.registry</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure your contact sources!
                </p>
                <p>
                    The registry manages which Odoo models can be used as contact sources
                    for mailing list updates. Configure field mappings and filter options
                    for each source.
                </p>
            </field>
        </record>

        <!-- Filter Templates Action -->
        <record id="action_filter_templates" model="ir.actions.act_window">
            <field name="name">Filter Templates</field>
            <field name="res_model">mailing.filter.template</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first filter template!
                </p>
                <p>
                    Save complex filter configurations as templates for reuse.
                    Templates can be private or shared with other users.
                </p>
            </field>
        </record>

        <!-- Audit Trail Action -->
        <record id="action_audit_trail" model="ir.actions.act_window">
            <field name="name">Audit Trail</field>
            <field name="res_model">mailing.operation.audit</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No audit entries found.
                </p>
                <p>
                    The audit trail provides a complete log of all mailing list update
                    operations for compliance and troubleshooting purposes.
                </p>
            </field>
        </record>

        <!-- Contact Tracking Action -->
        <record id="action_contact_tracking" model="ir.actions.act_window">
            <field name="name">Contact Tracking</field>
            <field name="res_model">mailing.contact.tracking</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No tracking records found.
                </p>
                <p>
                    Contact tracking provides detailed information about which contacts
                    were added through which batch operations, enabling precise rollback
                    capabilities.
                </p>
            </field>
        </record>

        <!-- Main Menu Items -->
        
        <!-- Primary Menu Item under Email Marketing -->
        <menuitem id="menu_mailing_list_updater_main"
                  name="Update Lists"
                  parent="mass_mailing.mass_mailing_menu_root"
                  action="action_mailing_list_updater"
                  sequence="15"
                  groups="group_mailing_list_updater_user"/>

        <!-- Sub-menu for Batch History -->
        <menuitem id="menu_batch_history"
                  name="Batch History"
                  parent="mass_mailing.mass_mailing_menu_root"
                  action="action_batch_history"
                  sequence="16"
                  groups="group_mailing_list_updater_user"/>

        <!-- Configuration Sub-menu -->
        <menuitem id="menu_mailing_updater_config"
                  name="Mailing List Updater"
                  parent="mass_mailing.menu_mass_mailing_configuration"
                  sequence="20"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Registry Configuration -->
        <menuitem id="menu_source_registry"
                  name="Contact Sources"
                  parent="menu_mailing_updater_config"
                  action="action_source_registry"
                  sequence="10"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Filter Templates -->
        <menuitem id="menu_filter_templates"
                  name="Filter Templates"
                  parent="menu_mailing_updater_config"
                  action="action_filter_templates"
                  sequence="20"
                  groups="group_mailing_list_updater_user"/>

        <!-- Advanced/Debug Menus -->
        <menuitem id="menu_mailing_updater_advanced"
                  name="Advanced"
                  parent="menu_mailing_updater_config"
                  sequence="90"
                  groups="group_mailing_list_updater_admin"/>

        <!-- Audit Trail -->
        <menuitem id="menu_audit_trail"
                  name="Audit Trail"
                  parent="menu_mailing_updater_advanced"
                  action="action_audit_trail"
                  sequence="10"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Contact Tracking -->
        <menuitem id="menu_contact_tracking"
                  name="Contact Tracking"
                  parent="menu_mailing_updater_advanced"
                  action="action_contact_tracking"
                  sequence="20"
                  groups="group_mailing_list_updater_manager"/>

        <!-- Smart Button for Mailing Lists -->
        <record id="mailing_list_update_smart_button" model="ir.ui.view">
            <field name="name">mailing.list.form.inherit.updater</field>
            <field name="model">mailing.list</field>
            <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_update_contacts"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-plus-circle"
                            groups="mailing_list_updater.group_mailing_list_updater_user">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Update</span>
                            <span class="o_stat_text">Contacts</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- Scheduled Actions -->
        
        <!-- Performance Monitoring Action -->
        <record id="ir_cron_performance_monitoring" model="ir.cron">
            <field name="name">Mailing List Updater: Performance Monitoring</field>
            <field name="model_id" ref="model_mailing_batch_processor"/>
            <field name="state">code</field>
            <field name="code">
# Weekly performance analysis and optimization recommendations
processor = env['mailing.batch.processor']
audit_model = env['mailing.operation.audit']

# Analyze last week's performance
from datetime import datetime, timedelta
week_ago = datetime.now() - timedelta(days=7)

# Get performance statistics
perf_stats = processor.analyze_batch_performance(date_from=week_ago)

# Log performance summary
if perf_stats['summary']['total_batches'] > 0:
    env['mailing.operation.audit'].create({
        'batch_id': 'SYSTEM_MONITORING',
        'operation_type': 'system_monitoring',
        'user_id': env.ref('base.user_admin').id,
        'details': json.dumps({
            'type': 'weekly_performance_report',
            'period': 'last_7_days',
            'statistics': perf_stats['summary'],
            'recommendations': processor.optimize_batch_size()
        }),
        'success': True,
        'company_id': env.company.id,
    })
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- Registry Health Check Action -->
        <record id="ir_cron_registry_health_check" model="ir.cron">
            <field name="name">Mailing List Updater: Registry Health Check</field>
            <field name="model_id" ref="model_mailing_source_registry"/>
            <field name="state">code</field>
            <field name="code">
# Daily health check of registered models
registry_entries = env['mailing.source.registry'].search([('is_active', '=', True)])

health_report = {
    'total_entries': len(registry_entries),
    'healthy_entries': 0,
    'issues_found': [],
}

for entry in registry_entries:
    try:
        # Test model access
        model = env[entry.model_name]
        
        # Test field mappings
        test_fields = [entry.email_field, entry.name_field]
        if entry.phone_field:
            test_fields.append(entry.phone_field)
        if entry.company_field:
            test_fields.append(entry.company_field)
        if entry.active_field:
            test_fields.append(entry.active_field)
        
        # Verify fields exist
        model_fields = model._fields
        for field_name in test_fields:
            if field_name and field_name not in model_fields:
                health_report['issues_found'].append({
                    'registry_id': entry.id,
                    'model': entry.model_name,
                    'issue': f'Field {field_name} not found',
                    'severity': 'high'
                })
        
        if not health_report['issues_found']:
            health_report['healthy_entries'] += 1
            
    except Exception as e:
        health_report['issues_found'].append({
            'registry_id': entry.id,
            'model': entry.model_name,
            'issue': str(e),
            'severity': 'critical'
        })

# Log health check results
env['mailing.operation.audit'].create({
    'batch_id': 'SYSTEM_HEALTH_CHECK',
    'operation_type': 'system_monitoring',
    'user_id': env.ref('base.user_admin').id,
    'details': json.dumps({
        'type': 'registry_health_check',
        'report': health_report
    }),
    'success': len(health_report['issues_found']) == 0,
    'error_message': f"Found {len(health_report['issues_found'])} issues" if health_report['issues_found'] else None,
    'company_id': env.company.id,
})
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>
</odoo>