<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Registry Entries for Contact Sources -->
        
        <!-- res.partner (Contacts Module) -->
        <record id="registry_res_partner" model="mailing.source.registry">
            <field name="model_name">res.partner</field>
            <field name="display_name">Contacts</field>
            <field name="description">Standard Odoo contacts from the Contacts module. Includes customers, vendors, and other business partners.</field>
            <field name="email_field">email</field>
            <field name="name_field">name</field>
            <field name="phone_field">phone</field>
            <field name="company_field">company_id</field>
            <field name="active_field">active</field>
            <field name="filter_fields">["create_date", "write_date", "user_id", "category_id", "country_id", "state_id", "city", "is_company", "supplier_rank", "customer_rank", "parent_id", "commercial_partner_id"]</field>
            <field name="is_active" eval="True"/>
            <field name="sequence">10</field>
        </record>

        <!-- crm.lead (CRM Module) -->
        <record id="registry_crm_lead" model="mailing.source.registry">
            <field name="model_name">crm.lead</field>
            <field name="display_name">CRM Leads</field>
            <field name="description">Leads and opportunities from the CRM module. Includes prospects, qualified leads, and sales opportunities.</field>
            <field name="email_field">email_from</field>
            <field name="name_field">name</field>
            <field name="phone_field">phone</field>
            <field name="company_field">company_id</field>
            <field name="active_field">active</field>
            <field name="filter_fields">["create_date", "write_date", "user_id", "team_id", "stage_id", "country_id", "state_id", "city", "probability", "expected_revenue", "priority", "type", "partner_id"]</field>
            <field name="is_active" eval="True"/>
            <field name="sequence">20</field>
        </record>

        <!-- Future Extension Examples (Inactive by default) -->
        
        <!-- hr.employee (HR Module) - Template for future use -->
        <record id="registry_hr_employee_template" model="mailing.source.registry">
            <field name="model_name">hr.employee</field>
            <field name="display_name">Employees</field>
            <field name="description">Company employees from the HR module. Useful for internal communications and newsletters.</field>
            <field name="email_field">work_email</field>
            <field name="name_field">name</field>
            <field name="phone_field">work_phone</field>
            <field name="company_field">company_id</field>
            <field name="active_field">active</field>
            <field name="filter_fields">["create_date", "write_date", "department_id", "job_id", "manager_id", "coach_id", "work_location_id", "employee_type"]</field>
            <field name="is_active" eval="False"/>
            <field name="sequence">30</field>
        </record>

        <!-- event.registration (Events Module) - Template for future use -->
        <record id="registry_event_registration_template" model="mailing.source.registry">
            <field name="model_name">event.registration</field>
            <field name="display_name">Event Attendees</field>
            <field name="description">Event attendees and registrations from the Events module. Perfect for follow-up campaigns.</field>
            <field name="email_field">email</field>
            <field name="name_field">name</field>
            <field name="phone_field">phone</field>
            <field name="company_field">company_id</field>
            <field name="active_field">active</field>
            <field name="filter_fields">["create_date", "write_date", "event_id", "state", "date_open", "date_closed", "partner_id"]</field>
            <field name="is_active" eval="False"/>
            <field name="sequence">40</field>
        </record>

        <!-- Default Filter Templates -->
        
        <!-- Recent Contacts Template -->
        <record id="template_recent_contacts" model="mailing.filter.template">
            <field name="name">Recent Contacts (Last 30 Days)</field>
            <field name="description">Contacts and leads created in the last 30 days</field>
            <field name="source_models">[{"model_name": "res.partner"}, {"model_name": "crm.lead"}]</field>
            <field name="quick_filters">{
                "date_range": {
                    "field": "create_date",
                    "operator": ">=",
                    "value": "30_days_ago"
                },
                "active_only": true,
                "exclude_blocked": true
            }</field>
            <field name="advanced_filters">{}</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="is_public" eval="True"/>
            <field name="is_active" eval="True"/>
        </record>

        <!-- VIP Customers Template -->
        <record id="template_vip_customers" model="mailing.filter.template">
            <field name="name">VIP Customers</field>
            <field name="description">High-value customers and qualified leads</field>
            <field name="source_models">[{"model_name": "res.partner"}, {"model_name": "crm.lead"}]</field>
            <field name="quick_filters">{
                "active_only": true,
                "exclude_blocked": true
            }</field>
            <field name="advanced_filters">{
                "rules": [
                    {
                        "field": "customer_rank",
                        "operator": ">",
                        "value": 0,
                        "model": "res.partner"
                    },
                    {
                        "field": "probability",
                        "operator": ">=",
                        "value": 75,
                        "model": "crm.lead"
                    }
                ],
                "logic": "OR"
            }</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="is_public" eval="True"/>
            <field name="is_active" eval="True"/>
        </record>

        <!-- Country-Specific Template Example -->
        <record id="template_us_contacts" model="mailing.filter.template">
            <field name="name">US Contacts Only</field>
            <field name="description">All contacts and leads from the United States</field>
            <field name="source_models">[{"model_name": "res.partner"}, {"model_name": "crm.lead"}]</field>
            <field name="quick_filters">{
                "active_only": true,
                "exclude_blocked": true
            }</field>
            <field name="advanced_filters">{
                "rules": [
                    {
                        "field": "country_id",
                        "operator": "=",
                        "value": "United States",
                        "model": "both"
                    }
                ]
            }</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="is_public" eval="True"/>
            <field name="is_active" eval="True"/>
        </record>

    </data>
</odoo>